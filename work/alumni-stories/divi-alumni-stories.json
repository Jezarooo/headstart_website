\":{\"attributes\":[{\"id\":\"n6saix382f\",\"name\":\"class\",\"value\":\"hs-alumni-story\",\"adminLabel\":\"hs-alumni-story\",\"targetElement\":\"main\"}],\"desktop\":{\"value\":{\"attributes\":[{\"id\":\"n6saix382f\",\"name\":\"class\",\"value\":\"hs-alumni-story\",\"adminLabel\":\"hs-alumni-story\",\"targetElement\":\"main\"}]}}}}},\"builderVersion\":\"5.0.0-public-beta.4.1\"} --><!-- wp:divi/gallery {\"module\":{\"meta\":{\"adminLabel\":{\"desktop\":{\"value\":\"Slides — Instagram graphics (4:5, in order)\"}}},\"advanced\":{\"showTitleAndCaption\":{\"desktop\":{\"value\":\"off\"}}},\"decoration\":{\"attributes\":{\"attributes\":[{\"id\":\"o0m403jeic\",\"name\":\"class\",\"value\":\"hs-story-slides\",\"adminLabel\":\"hs-story-slides\",\"targetElement\":\"main\"}],\"desktop\":{\"value\":{\"attributes\":[{\"id\":\"o0m403jeic\",\"name\":\"class\",\"value\":\"hs-story-slides\",\"adminLabel\":\"hs-story-slides\",\"targetElement\":\"main\"}]}}}}},\"pagination\":{\"advanced\":{\"showPagination\":{\"desktop\":{\"value\":\"off\"}}}},\"image\":{\"advanced\":{\"galleryIds\":{\"desktop\":{\"value\":\"\"}}}},\"builderVersion\":\"5.0.0-public-beta.4.1\"} /--><!-- wp:divi/image {\"module\":{\"meta\":{\"adminLabel\":{\"desktop\":{\"value\":\"Card photo (plain photo, no graphics)\"}}},\"decoration\":{\"attributes\":{\"attributes\":[{\"id\":\"lzllh0kcsn\",\"name\":\"class\",\"value\":\"hs-story-card\",\"adminLabel\":\"hs-story-card\",\"targetElement\":\"main\"}],\"desktop\":{\"value\":{\"attributes\":[{\"id\":\"lzllh0kcsn\",\"name\":\"class\",\"value\":\"hs-story-card\",\"adminLabel\":\"hs-story-card\",\"targetElement\":\"main\"}]}}}}},\"builderVersion\":\"5.0.0-public-beta.4.1\"} /--><!-- wp:divi/text {\"module\":{\"meta\":{\"adminLabel\":{\"desktop\":{\"value\":\"Story text — H3 name, meta line, blurb, IG link\"}}},\"decoration\":{\"attributes\":{\"attributes\":[{\"id\":\"6s45as1en1\",\"name\":\"class\",\"value\":\"hs-story-text\",\"adminLabel\":\"hs-story-text\",\"targetElement\":\"main\"}],\"desktop\":{\"value\":{\"attributes\":[{\"id\":\"6s45as1en1\",\"name\":\"class\",\"value\":\"hs-story-text\",\"adminLabel\":\"hs-story-text\",\"targetElement\":\"main\"}]}}}}},\"content\":{\"innerContent\":{\"desktop\":{\"value\":\"\\u003ch3\\u003eNick\\u003c/h3\\u003e\\n\\u003cp\\u003eClass of 2022 · History \\u0026amp; International Relations, Lancaster University\\u003c/p\\u003e\\n\\u003cp\\u003eFor Nick, HeadStart has remained a special part of his life, filled with memories of DoE adventures, CAPA performances, and lifelong friendships. After graduation, he became a Divemaster, travelled across the world, and went on to study History and International Relations at Lancaster University in the UK.\\u003c/p\\u003e\\n\\u003cp\\u003eToday, Nick has visited 47 countries, worked at major events in the US, and has ambitions to pursue a career in politics or international affairs. His advice for the next generation: stay open-minded, take risks, say yes to opportunities, and take that first step.\\u003c/p\\u003e\\n\\u003cp\\u003e\\u003ca href=\\\"https://www.instagram.com/headstartalumni/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\"\\u003eView the original post on Instagram\\u003c/a\\u003e\\u003c/p\\u003e\"}}},\"builderVersion\":\"5.0.0-public-beta.4.1\"} /--><!-- /wp:divi/group --><!-- /wp:divi/group --><!-- /wp:divi/column --><!-- /wp:divi/row --><!-- /wp:divi/section --><!-- /wp:divi/placeholder -->", "post_title": "Alumni stories (section)", "post_excerpt": "", "post_status": "publish", "comment_status": "closed", "ping_status": "closed", "post_password": "", "post_name": "alumni-stories-section", "to_ping": "", "pinged": "", "post_modified": "2026-10-01 09:00:00", "post_modified_gmt": "2026-10-01 02:00:00", "post_content_filtered": "", "post_parent": 0, "menu_order": 0, "post_type": "et_pb_layout", "post_mime_type": "", "comment_count": "0", "filter": "raw", "post_meta": {"_et_pb_excluded_global_options": ["[]"], "_et_pb_built_for_post_type": ["pag