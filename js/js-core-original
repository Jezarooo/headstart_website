<script>
/**
 * =============================================================================
 * HEADSTART GLOBAL UTILITIES
 * =============================================================================
 * PURPOSE: Shared utility functions for all HeadStart JS engines.
 * =============================================================================
 */
const HeadStartUtils = {
    /**
     * Checks if the script is currently running inside the Divi Visual Builder
     * @returns {boolean}
     */
    isDiviBuilder: function() {
        return document.body.classList.contains('et-fb') || 
               window.location.search.includes('et_fb=1') ||
               window.location.href.includes('et_fb=1');
    },

    /**
     * Debounces a function to prevent it from firing too rapidly
     * @param {function} func - The function to debounce
     * @param {number} wait - The delay in milliseconds
     * @returns {function}
     */
    debounce: function(func, wait) {
        let timeout;
        return function(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }
};
</script>

<script>
/**
 * =============================================================================
 * HEADSTART ATTRIBUTES SIDEBAR ENGINE
 * =============================================================================
 * PURPOSE: Manages the vertical positioning of the "Who We Are" left-hand sidebar.
 * LOGIC: Prevents visual collision with the main navigation header at the top of
 * the page. The CSS natively offsets it 30px lower. Toggles the 'is-scrolled' 
 * class past 20px of scroll to glide the sidebar into absolute vertical center.
 * DEPENDENCIES: None
 * =============================================================================
 */
document.addEventListener("DOMContentLoaded", function() {
    
    const sidebar = document.querySelector('.hs-attribute-sidebar');
    
    if (!sidebar) return;

    /**
     * Evaluates scroll depth using IntersectionObserver for optimal performance.
     */
    let sentinel = document.getElementById('hs-sidebar-sentinel');
    if (!sentinel) {
        sentinel = document.createElement('div');
        sentinel.id = 'hs-sidebar-sentinel';
        sentinel.style.position = 'absolute';
        sentinel.style.top = '20px';
        sentinel.style.left = '0';
        sentinel.style.width = '1px';
        sentinel.style.height = '1px';
        sentinel.style.pointerEvents = 'none';
        sentinel.style.visibility = 'hidden';
        document.body.appendChild(sentinel);
    }

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                sidebar.classList.remove('is-scrolled');
            } else {
                sidebar.classList.add('is-scrolled');
            }
        });
    });

    observer.observe(sentinel);







});
</script>

<script>
/**
 * =============================================================================
 * HEADSTART FORM TOGGLE ENGINE (BOOKING VS. CONTACT)
 * =============================================================================
 * PURPOSE: Manages animated UI swapping between the "Book a Tour" and "Have a Question" forms.
 * LOGIC: Intercepts link clicks to swap active/hidden CSS classes, dynamically updates 
 * ARIA attributes for accessibility, and auto-focuses the first input of the active form.
 * DEPENDENCIES: Form DOM elements
 * =============================================================================
 */
document.addEventListener('DOMContentLoaded', function() {
    
    /* --- DOM ELEMENTS --- */
    
    const btnToEmail = document.getElementById('switch-to-email');
    const btnToBooking = document.getElementById('switch-to-booking');
    const wrapBooking = document.getElementById('hs-booking-form-wrapper');
    const wrapEmail = document.getElementById('hs-email-form-wrapper');

    /* --- UTILITIES --- */
    
    /**
     * Locates and focuses the first text, email, or telephone input 
     * within a given form wrapper after a brief 100ms animation delay.
     */
    function focusFirstInput(formWrapper) {
        const firstInput = formWrapper.querySelector('input[type="text"], input[type="email"], input[type="tel"]');
        if (firstInput) {
            setTimeout(() => { firstInput.focus(); }, 100); 
        }
    }

    /* --- EVENT HANDLERS --- */

    if (btnToEmail && btnToBooking) {
        
        btnToEmail.addEventListener('click', function(e) {
            e.preventDefault();
            
            wrapBooking.classList.remove('hs-form-active');
            wrapBooking.classList.add('hs-form-hidden');
            wrapBooking.setAttribute('aria-hidden', 'true');
            
            wrapEmail.classList.remove('hs-form-hidden');
            wrapEmail.classList.add('hs-form-active');
            wrapEmail.setAttribute('aria-hidden', 'false');
            
            focusFirstInput(wrapEmail);
        });

        btnToBooking.addEventListener('click', function(e) {
            e.preventDefault();
            
            wrapEmail.classList.remove('hs-form-active');
            wrapEmail.classList.add('hs-form-hidden');
            wrapEmail.setAttribute('aria-hidden', 'true');
            
            wrapBooking.classList.remove('hs-form-hidden');
            wrapBooking.classList.add('hs-form-active');
            wrapBooking.setAttribute('aria-hidden', 'false');
            
            focusFirstInput(wrapBooking);
        });
    }







});
</script>

<script>
/**
 * =============================================================================
 * HEADSTART MEGA MENU ENGINE V16.9
 * =============================================================================
 * PURPOSE: Advanced interaction logic for the HeadStart Global Mega Menus.
 * LOGIC: Handles Asymmetric UI Sync, Cross-Platform Isolation, hover suspension, desktop snap-close.
 * DEPENDENCIES: DOM menus, Header structure
 * =============================================================================
 */

(function() {
    
    function runMegaMenuEngine() {
        if (!document.body) { 
            setTimeout(runMegaMenuEngine, 50); 
            return; 
        }

        console.log("🚀 HeadStart Mega Menu Engine V16.9 Started");

        /* --- STATE & CONFIG --- */
        
        const isBuilder = HeadStartUtils.isDiviBuilder();
        let closeTimeout;

        const hoverMap = {
            '.trigger-community':    { target: 'mega-community', anchor: '.hs-utility-bar' },
            '.trigger-resources':    { target: 'mega-resources', anchor: '.hs-utility-bar' },
            '.trigger-fb':           { target: 'mega-social-fb', anchor: '.hs-utility-bar' },
            '.trigger-insta':        { target: 'mega-social-insta', anchor: '.hs-utility-bar' },
            '.trigger-student':      { target: 'mega-student', anchor: '.hs-primary-nav' },
            '.trigger-fb-footer':    { target: 'mega-footer-fb', anchor: 'none' },
            '.trigger-insta-footer': { target: 'mega-footer-insta', anchor: 'none' }
        };


        /* --- UTILITIES --- */


        const handleMegaScroll = HeadStartUtils.debounce(() => {
            if (window.innerWidth < 981) return; 
            
            const openMegas = document.querySelectorAll('.hs-show-mega');
            if (openMegas.length > 0) {
                openMegas.forEach(menu => {
                    menu.style.setProperty('transition', 'none', 'important');
                });
                
                closeAllMegas();
                
                setTimeout(() => {
                    openMegas.forEach(menu => {
                        menu.style.transition = '';
                    });
                }, 50);
            }
        }, 10);

        /**
         * Closes all active mega menus and resets CTA button states.
         */
        function closeAllMegas() {
            document.querySelectorAll('.hs-show-mega').forEach(el => el.classList.remove('hs-show-mega'));
            document.querySelectorAll('.cta-column, .hs-secondary-cta-button, .hs-cta-open').forEach(el => el.classList.remove('hs-cta-open'));
            window.removeEventListener('scroll', handleMegaScroll, { passive: true });
        }

        /**
         * Tags an element as initialized to prevent duplicate processing.
         */
        function setupMegaSection(element) {
            if (!element.classList.contains('hs-mega-initialized')) {
                element.classList.add('hs-mega-initialized');
            }
        }

        /**
         * Ensures columns containing local popups have the required parent class.
         */
        function setupLocalContainers() {
            document.querySelectorAll('.mega-local-popup').forEach(popup => {
                const parentCol = popup.closest('.et_pb_column');
                if (parentCol && !parentCol.classList.contains('hs-mega-parent-column')) {
                    parentCol.classList.add('hs-mega-parent-column');
                }
            });
        }




        /* --- LAYOUT & ALIGNMENT --- */

        /**
         * Vertically aligns a mega menu directly below its anchor element.
         */
        function alignMenuVertical(menuElement, anchorSelector) {
            if (!menuElement || anchorSelector === 'none') return;
            const anchor = document.querySelector(anchorSelector);
            if (anchor) {
                const rect = anchor.getBoundingClientRect();
                menuElement.style.setProperty('position', 'fixed', 'important');
                menuElement.style.setProperty('top', rect.bottom + 'px', 'important');
            }
        }

        /**
         * Positions the contact drawer relative to the utility bar and right edge.
         */
        function alignContactDrawer(drawer) {
            if (!drawer) return;
            window.requestAnimationFrame(() => {
                const btnAnchor = document.querySelector('.cta-column');
                const headerAnchor = document.querySelector('.hs-utility-bar');
                
                if (btnAnchor && headerAnchor) {
                    const btnRect = btnAnchor.getBoundingClientRect();
                    const gapFromRight = window.innerWidth - btnRect.right;
                    
                    const userOffset = drawer.getAttribute('data-hs-offset');
                    const manualOffset = userOffset ? parseInt(userOffset, 10) : 30; 
                    
                    let finalGap = gapFromRight - manualOffset; 
                    if (finalGap < 0) finalGap = 0; 
                    
                    const headerRect = headerAnchor.getBoundingClientRect();
                    
                    drawer.style.setProperty('position', 'fixed', 'important');
                    drawer.style.setProperty('right', finalGap + 'px', 'important');
                    drawer.style.setProperty('left', 'auto', 'important');
                    drawer.style.setProperty('top', headerRect.bottom + 'px', 'important');
                    
                    const userWidth = drawer.getAttribute('data-hs-width');
                    if (userWidth) { 
                        drawer.style.setProperty('max-width', userWidth + 'px', 'important'); 
                    }
                }
            });
        }


        /* --- EVENT HANDLERS --- */

        /**
         * Binds hover, click, scroll, and resize interactions for desktop views.
         */
        function initInteractions() {
            if (isBuilder) return;

            const contactSelectors = ['.cta-column', '.hs-secondary-cta-button'];
            
            document.querySelectorAll(contactSelectors.join(', ')).forEach(btn => {
                btn.classList.add('hs-contact-toggle');
            });

            // Hover Events
            document.addEventListener('mouseover', (e) => {
                if (window.innerWidth < 981) return; 

                const isContactFormOpen = document.querySelector('.mega-contact-form.hs-show-mega');
                if (isContactFormOpen) return;

                let isTrigger = false;
                let isInsideMenu = e.target.closest('.hs-show-mega');

                // 1. Check for triggers
                for (const [selector, config] of Object.entries(hoverMap)) {
                    const trigger = e.target.closest(selector);
                    if (trigger) {
                        isTrigger = true;
                        
                        // CLEAR TIMEOUT: User is on a trigger, cancel any pending close
                        clearTimeout(closeTimeout);
                        closeTimeout = null;
                        
                        const targetMenu = document.querySelector(`.${config.target}`);
                        if (targetMenu && !targetMenu.classList.contains('hs-show-mega')) {
                            closeAllMegas();
                            alignMenuVertical(targetMenu, config.anchor); 
                            targetMenu.classList.add('hs-show-mega');
                            window.addEventListener('scroll', handleMegaScroll, { passive: true });
                        }
                        break;
                    }
                }

                // 2. CLEAR TIMEOUT: User safely reached the menu
                if (isInsideMenu) {
                    clearTimeout(closeTimeout);
                    closeTimeout = null;
                }

                // 3. START TIMEOUT: User is in dead space
                if (!isTrigger && !isInsideMenu) {
                    // CRITICAL FIX: Only set a timeout if one isn't already running
                    if (!closeTimeout) {
                        closeTimeout = setTimeout(() => { 
                            closeAllMegas(); 
                            closeTimeout = null; // Reset state after closing
                        }, 350); // Bumped from 200ms to 350ms for a better grace period
                    }
                }
            });

            // Click Events
            document.addEventListener('click', (e) => {
                if (window.innerWidth < 981) return; 

                const contactBtn = e.target.closest('.hs-contact-toggle, .cta-column, .hs-secondary-cta-button');
                
                if (contactBtn) {
                    e.preventDefault(); 
                    e.stopPropagation();

                    const targetForm = document.querySelector('.mega-contact-form');
                    if (!targetForm) return;

                    const isOpen = targetForm.classList.contains('hs-show-mega');

                    if (isOpen) {
                        closeAllMegas();
                    } else {
                        closeAllMegas();
                        alignContactDrawer(targetForm); 
                        targetForm.classList.add('hs-show-mega'); 
                        window.addEventListener('scroll', handleMegaScroll, { passive: true }); 
                        
                        if (contactBtn.classList.contains('hs-secondary-cta-button')) {
                            document.querySelectorAll('.cta-column, .hs-secondary-cta-button').forEach(btn => {
                                btn.classList.add('hs-cta-open');
                            });
                        } else {
                            document.querySelectorAll('.cta-column').forEach(btn => {
                                btn.classList.add('hs-cta-open');
                            });
                        }
                    }
                    return;
                }

                if (!e.target.closest('.hs-show-mega') && !e.target.closest('[class*="mega-"]')) {
                    closeAllMegas();
                }
            });


            
            // Resize Events
            window.addEventListener('resize', HeadStartUtils.debounce(() => {
                if (window.innerWidth < 981) return;
                const openDrawer = document.querySelector('.mega-contact-form.hs-show-mega');
                if (openDrawer) alignContactDrawer(openDrawer);
            }, 100));
        }

        /* --- INITIALIZATION --- */

        if (!isBuilder) {
            document.querySelectorAll('[class*="mega-"]').forEach(setupMegaSection);
            setupLocalContainers();
            initInteractions();

            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.addedNodes.length) {
                        mutation.addedNodes.forEach(node => {
                            if (node.nodeType === 1) {
                                if (node.matches && node.matches('[class*="mega-"]')) setupMegaSection(node);
                                if (node.querySelector && node.querySelector('.mega-local-popup')) setupLocalContainers();
                            }
                        });
                    }
                });
            });
            observer.observe(document.body, { childList: true, subtree: true });
        }
    }

    runMegaMenuEngine();
})();
</script>

<script>
/**
 * =============================================================================
 * HEADSTART ECA DIRECTORY ENGINE
 * =============================================================================
 * PURPOSE: Manages the ECA (Extra-Curricular Activities) table with search, 
 * category filtering, age filtering, and pagination.
 * LOGIC: Parses DOM rows, removes duplicates, and renders paginated results.
 * Contains null-safe checks (try-catch) to prevent errors when data is missing
 * from the live Divi modules.
 * DEPENDENCIES: DOM table elements
 * =============================================================================
 */
// Wrapped in an IIFE so variables don't leak out and conflict with WordPress
(function() {
    function init(wrapper) {
        const tableBody = wrapper.querySelector('#tableBody');
        if (!tableBody) return;

        // Parse data straight from the HTML DOM
        let allEcas = [];
        const rows = Array.from(tableBody.querySelectorAll('.hs-eca-row'));
        
        // Debugging output to see if rows are found:
        console.log("ECA Directory Engine: Found " + rows.length + " rows in the DOM at initialization.");
        
        rows.forEach((tr, index) => {
            try {
                const name = tr.querySelector('.col-name')?.textContent.trim() || 'Unknown Activity';
                
                // Fallback for missing category tags
                let category = 'Club';
                const tagEl = tr.querySelector('.col-category .tag');
                if (tagEl) {
                    category = tagEl.textContent.trim();
                } else if (tr.querySelector('.col-category')) {
                    category = tr.querySelector('.col-category').textContent.trim() || 'Club';
                }

                const ages = tr.querySelector('.col-ages')?.textContent.trim() || 'All Ages';
                const description = tr.querySelector('.desc-clamped')?.textContent.trim() || '';
                
                allEcas.push({ name, category, ages, description, originalId: index });
            } catch (e) {
                console.warn('ECA Directory: Skipping malformed row at index', index, e);
            }
        });

        // Remove duplicates
        const seen = new Set();
        allEcas = allEcas.filter(item => {
            const duplicate = seen.has(item.name);
            seen.add(item.name);
            return !duplicate;
        });

        let filteredEcas = [];
        let currentPage = 1;
        let itemsPerPage = window.innerWidth <= 768 ? 3 : 4;

        window.addEventListener('resize', () => {
            const newItemsPerPage = window.innerWidth <= 768 ? 3 : 4;
            if (newItemsPerPage !== itemsPerPage) {
                itemsPerPage = newItemsPerPage;
                currentPage = 1; 
                if (allEcas.length > 0) renderTable();
            }
        });

        let sortColumn = 'name';
        let sortDirection = 'asc';

        const searchInput = wrapper.querySelector('#search');
        const categoryFilter = wrapper.querySelector('#categoryFilter');
        const ageFilter = wrapper.querySelector('#ageFilter');
        const paginationContainer = wrapper.querySelector('#paginationContainer');

        function getTagClass(category) {
            if(category === 'Fee Paid') return 'tag-Fee';
            if(category === 'VAPP') return 'tag-VAPP';
            if(category === 'Sport') return 'tag-Sport';
            return 'tag-Club';
        }

        function matchesAge(ecaAges, selectedAge) {
            if (selectedAge === 'All') return true;
            const text = ecaAges.toLowerCase();
            const val = selectedAge.toLowerCase();
            
            if (val === 'early years' && (text.includes('early year') || text.includes('preschool'))) return true;
            if (text.includes(val)) return true;

            const num = parseInt(selectedAge);
            if (!isNaN(num)) {
                const matches = text.match(/(\d+)\s*(to|&|-|and)\s*(\d+)/g);
                if (matches) {
                    for (const m of matches) {
                        const nums = m.match(/\d+/g).map(Number);
                        if (nums.length === 2 && num >= Math.min(...nums) && num <= Math.max(...nums)) {
                            return true;
                        }
                    }
                }
                const exactMatch = new RegExp(`\\b${num}\\b`);
                if (exactMatch.test(text)) return true;
                if (num >= 1 && num <= 6 && text.includes('primary')) return true;
                if (num >= 7 && num <= 13 && text.includes('secondary')) return true;
            }

            return false;
        }

        function sortData(data) {
            return data.sort((a, b) => {
                let valA = a[sortColumn] ? a[sortColumn].toString().toLowerCase() : '';
                let valB = b[sortColumn] ? b[sortColumn].toString().toLowerCase() : '';

                if (valA < valB) return sortDirection === 'asc' ? -1 : 1;
                if (valA > valB) return sortDirection === 'asc' ? 1 : -1;
                return 0;
            });
        }

        function updateSortIcons() {
            ['name', 'category', 'ages', 'description'].forEach(col => {
                const el = wrapper.querySelector(`#sort-${col}`);
                if (el) {
                    if (col === sortColumn) {
                        if(sortDirection === 'asc') {
                            el.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>';
                        } else {
                            el.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
                        }
                    } else {
                        el.innerHTML = '';
                    }
                }
            });
        }

        // Attach to window so HTML inline onclick handlers can reach it
        window.handleSort = function(col) {
            if (sortColumn === col) {
                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumn = col;
                sortDirection = 'asc';
            }
            currentPage = 1;
            renderTable();
        }

        window.toggleReadMore = function(index, btn) {
            const descDiv = wrapper.querySelector(`#desc-${index}`);
            if (descDiv && descDiv.classList.contains('desc-clamped')) {
                descDiv.classList.remove('desc-clamped');
                btn.textContent = 'Read less';
            } else if (descDiv) {
                descDiv.classList.add('desc-clamped');
                btn.textContent = 'Read more';
            }
        }

        function renderPagination(totalPages) {
            if (!paginationContainer) return;

            if (totalPages <= 1) {
                paginationContainer.innerHTML = '';
                return;
            }

            let html = '';
            if (currentPage > 1) {
                html += `<button class="page-btn" data-goto-page="${currentPage - 1}">Prev</button>`;
            }

            for (let i = 1; i <= totalPages; i++) {
                if (totalPages > 7) {
                    if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                        html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-goto-page="${i}">${i}</button>`;
                    } else if (i === currentPage - 2 || i === currentPage + 2) {
                        html += `<span class="page-dots">...</span>`;
                    }
                } else {
                    html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-goto-page="${i}">${i}</button>`;
                }
            }

            if (currentPage < totalPages) {
                html += `<button class="page-btn" data-goto-page="${currentPage + 1}">Next</button>`;
            }

            paginationContainer.innerHTML = html;
        }

        window.goToPage = function(page) {
            currentPage = page;
            renderTable();
            const top = wrapper.getBoundingClientRect().top + window.scrollY - 100;
            window.scrollTo({ top: top, behavior: 'smooth' });
        }

        function renderTable() {
            if (!searchInput || !categoryFilter || !ageFilter || !tableBody) return;

            const term = searchInput.value.toLowerCase();
            const cat = categoryFilter.value;
            const age = ageFilter.value;

            filteredEcas = allEcas.filter(eca => {
                const matchSearch = eca.name.toLowerCase().includes(term) || eca.description.toLowerCase().includes(term);
                const matchCat = (cat === 'All' || eca.category === cat);
                const matchAge = matchesAge(eca.ages, age);
                return matchSearch && matchCat && matchAge;
            });

            filteredEcas = sortData(filteredEcas);
            updateSortIcons();

            const totalPages = Math.ceil(filteredEcas.length / itemsPerPage);
            if (currentPage > totalPages) currentPage = totalPages || 1;

            const startIdx = (currentPage - 1) * itemsPerPage;
            const endIdx = startIdx + itemsPerPage;
            const paginated = filteredEcas.slice(startIdx, endIdx);

            if (paginated.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="4" class="no-results" style="text-align: center; padding: 2rem;">No activities found matching your criteria.</td></tr>`;
                if (paginationContainer) paginationContainer.innerHTML = '';
                return;
            }

            tableBody.innerHTML = paginated.map((eca) => {
                let descHTML = `
                    <div class="desc-wrapper">
                        <div id="desc-${eca.originalId}" class="desc-clamped">${eca.description}</div>
                        <button id="btn-${eca.originalId}" class="read-more-btn" style="display: none;" data-readmore-id="${eca.originalId}">Read more</button>
                    </div>
                `;

                return `
                <tr>
                    <td class="col-name">${eca.name}</td>
                    <td class="col-category">
                        <span class="tag ${getTagClass(eca.category)}">${eca.category}</span>
                    </td>
                    <td class="col-ages">${eca.ages}</td>
                    <td class="col-desc">${descHTML}</td>
                </tr>
                `;
            }).join('');

            // After rendering, check for overflow to selectively show the button
            requestAnimationFrame(() => {
                paginated.forEach((eca) => {
                    const descDiv = wrapper.querySelector(`#desc-${eca.originalId}`);
                    const btn = wrapper.querySelector(`#btn-${eca.originalId}`);
                    if (descDiv && btn) {
                        if (descDiv.scrollHeight > descDiv.clientHeight) {
                            btn.style.display = 'inline-block';
                        } else {
                            descDiv.classList.remove('desc-clamped');
                        }
                    }
                });
            });

            renderPagination(totalPages);
        }

        if (searchInput) searchInput.addEventListener('input', () => { currentPage = 1; renderTable(); });
        if (categoryFilter) categoryFilter.addEventListener('change', () => { currentPage = 1; renderTable(); });
        if (ageFilter) ageFilter.addEventListener('change', () => { currentPage = 1; renderTable(); });

        if (paginationContainer) {
            paginationContainer.addEventListener('click', (e) => {
                const btn = e.target.closest('.page-btn');
                if (!btn) return;
                const page = parseInt(btn.getAttribute('data-goto-page'));
                if (page && page !== currentPage) {
                    window.goToPage(page);
                }
            });
        }

        if (tableBody) {
            tableBody.addEventListener('click', (e) => {
                const btn = e.target.closest('.read-more-btn');
                if (!btn) return;
                const id = btn.getAttribute('data-readmore-id');
                if (id) {
                    window.toggleReadMore(id, btn);
                }
            });
        }

        // Initial Render 
        renderTable();
    }

    // DIVI/WORDPRESS SAFETY FALLBACK
    // Wait for the HTML container to exist in the DOM before running the script
    let attempts = 0;
    function checkDOM() {
        const wrapper = document.getElementById('hs-eca-directory');
        const tableBody = wrapper ? wrapper.querySelector('#tableBody') : null;
        
        // Wait not just for wrapper, but also until the tableBody has at least one row, 
        // to handle async rendering in Divi.
        if (wrapper && tableBody && tableBody.querySelectorAll('.hs-eca-row').length > 0) {
            init(wrapper);
        } else if (attempts < 50) { // Try for up to 5 seconds
            attempts++;
            setTimeout(checkDOM, 100);
        } else {
            console.warn("ECA Directory script: Wrapper found but no rows were present after 5 seconds, or wrapper not found.");
            // Try init anyway just in case the table is legitimately empty
            if (wrapper) init(wrapper);
        }
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkDOM);
    } else {
        checkDOM();
    }

})();
</script>


<script>
/**
 * =============================================================================
 * HEADSTART EVENTS CALENDAR ENGINE (Refactored)
 * =============================================================================
 * PURPOSE: Advanced event calendar management and UI logic.
 * LOGIC: Encapsulated as a class to support multiple modules on a single page.
 * DEPENDENCIES: DOM Calendar modules
 * =============================================================================
 */

class HeadStartEventsCalendar {
    constructor(container) {
        this.container = container;
        
        // State
        this.currentFilter = 'all';
        this.currentPage = 0;
        this.modalFilter = 'all'; 
        this.modalPage = 0; 
        this.currentEventData = null;
        this.currentActiveCardElement = null;
        this.cards = [];
        
        // Debounce timer for resize
        this.resizeTimer = null;

        this.init();
    }

    init() {
        const overlay = this.container.querySelector('#hs-modal-overlay') || document.querySelector('#hs-modal-overlay');
        
        if (overlay && overlay.parentNode !== document.body) {
            overlay.style.setProperty('position', 'fixed', 'important');
            overlay.style.setProperty('top', '0', 'important');
            overlay.style.setProperty('left', '0', 'important');
            overlay.style.setProperty('width', '100vw', 'important');
            overlay.style.setProperty('height', '100vh', 'important');
            overlay.style.setProperty('z-index', '99999999', 'important');

            this.modalWrapper = document.createElement('div');
            this.modalWrapper.className = 'hs-section-events hs-modal-global-wrapper'; 
            this.modalWrapper.appendChild(overlay);
            document.body.appendChild(this.modalWrapper);
        } else {
            this.modalWrapper = overlay ? overlay.parentNode : null;
        }

        this.cards = Array.from(this.container.querySelectorAll('.hs-card-v1'));
        this.bindEvents();
        this.applyFilterDisplay();
    }

    bindEvents() {
        // --- Filter Dropdowns ---
        const mainFilter = this.container.querySelector('.hs-mobile-filter');
        if (mainFilter) {
            mainFilter.addEventListener('change', (e) => this.filterEvents(e.target.value));
        }

        if (this.modalWrapper) {
            const modalFilter = this.modalWrapper.querySelector('.hs-modal-mobile-filter');
            if (modalFilter) {
                modalFilter.addEventListener('change', (e) => this.filterEvents(e.target.value));
            }
        }

        // --- Filter Pill Buttons ---
        const filterBtns = this.container.querySelectorAll('.hs-filter-btn');
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                this.filterEvents(btn.getAttribute('data-filter'));
            });
        });

        // --- Pagination (Dashboard) ---
        const prevBtn = this.container.querySelector('.hs-carousel-prev');
        if (prevBtn) prevBtn.addEventListener('click', () => this.changePage(-1));
        
        const nextBtn = this.container.querySelector('.hs-carousel-next');
        if (nextBtn) nextBtn.addEventListener('click', () => this.changePage(1));

        // --- Calendar Export Dropdowns ---
        const btnGlobalCal = this.container.querySelector('#btn-global-cal');
        if (btnGlobalCal) {
            btnGlobalCal.addEventListener('click', (e) => this.toggleGlobalCalDropdown(e));
        }
        
        const globalDropdownBtns = this.container.querySelectorAll('#global-cal-dropdown button');
        globalDropdownBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                let platform = 'apple';
                if(btn.innerHTML.includes('google')) platform = 'google';
                if(btn.innerHTML.includes('windows')) platform = 'outlook';
                this.subscribeCalendar(platform);
            });
        });

        if (this.modalWrapper) {
            const btnAddCalEvent = this.modalWrapper.querySelector('#btn-add-cal-event');
            if (btnAddCalEvent) {
                btnAddCalEvent.addEventListener('click', (e) => this.toggleEventCalDropdown(e));
            }

            const eventDropdownBtns = this.modalWrapper.querySelectorAll('#cal-dropdown-event button');
            eventDropdownBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    let platform = 'apple';
                    if(btn.innerHTML.includes('google')) platform = 'google';
                    if(btn.innerHTML.includes('windows')) platform = 'outlook';
                    this.addToCalendar(platform);
                });
            });
            
            // Modal View All / Close
            const btnViewAll = this.container.querySelector('.hs-btn-view-all');
            if (btnViewAll) btnViewAll.addEventListener('click', () => this.openViewAllModal());

            const closeBtns = this.modalWrapper.querySelectorAll('.hs-shared-close');
            closeBtns.forEach(btn => {
                btn.addEventListener('click', () => this.closeModal());
            });

            // Modal Prev/Next Navigation
            const navPrev = this.modalWrapper.querySelector('.hs-modal-nav-prev');
            if (navPrev) navPrev.addEventListener('click', () => this.navigateSingleModal(-1));

            const navNext = this.modalWrapper.querySelector('.hs-modal-nav-next');
            if (navNext) navNext.addEventListener('click', () => this.navigateSingleModal(1));

            // Overlay click to close
            const overlay = this.modalWrapper.querySelector('#hs-modal-overlay');
            if (overlay) {
                overlay.addEventListener('click', (e) => {
                    if (e.target === overlay) this.closeModal();
                });
            }
        }

        // --- Event Cards ---
        const cards = this.container.querySelectorAll('.hs-card-v1');
        cards.forEach(card => {
            card.addEventListener('click', (e) => {
                if (e.target.closest('.hs-card-register-btn') || e.target.closest('.hs-meta-register-btn')) return;
                this.openSingleModalFromNode(card);
            });
        });

        // --- Window Level Events (scoping safely) ---
        window.addEventListener('click', (e) => {
            if (!e.target.closest('.hs-cal-dropdown-container')) {
                this.container.querySelectorAll('.hs-cal-dropdown, .hs-btn-add-cal').forEach(el => el.classList.remove('active'));
                if (this.modalWrapper) {
                    this.modalWrapper.querySelectorAll('.hs-cal-dropdown, .hs-btn-add-cal').forEach(el => el.classList.remove('active'));
                }
            }
        });

        // Resize with debounce
        window.addEventListener('resize', () => {
            clearTimeout(this.resizeTimer);
            this.resizeTimer = setTimeout(() => {
                this.applyFilterDisplay();
                if(this.modalWrapper) {
                    const modalList = this.modalWrapper.querySelector('#modal-list-view');
                    if (modalList && window.getComputedStyle(modalList).display !== 'none') {
                        this.applyModalFilterDisplay();
                    }
                }
            }, 150); // 150ms debounce
        });
    }

    /* --- DATE FORMATTING HELPERS --- */
    parseEventDate(isoStr) {
        if (!isoStr) return { month: '', day: '' };
        const parts = isoStr.split('T')[0].split('-');
        if (parts.length !== 3) return { month: '', day: '' };
        const d = new Date(parts[0], parts[1] - 1, parts[2]);
        if (isNaN(d.getTime())) return { month: '', day: '' };
        const month = d.toLocaleString('en-US', { month: 'short' }).toUpperCase();
        const day = String(d.getDate()).padStart(2, '0');
        return { month, day };
    }

    generateBadgeHTML(startDateStr, endDateStr) {
        const start = this.parseEventDate(startDateStr);
        const badge1 = `<div class="hs-date-badge-v1"><div class="hs-db-month">${start.month}</div><div class="hs-db-day">${start.day}</div></div>`;
        
        if (endDateStr) {
            const end = this.parseEventDate(endDateStr);
            return `<div class="hs-multi-date-wrapper">${badge1}<div class="hs-date-separator">-</div><div class="hs-date-badge-v1"><div class="hs-db-month">${end.month}</div><div class="hs-db-day">${end.day}</div></div></div>`;
        }
        return badge1;
    }

    generateMobileDateText(startDateStr, endDateStr, cat) {
        const start = this.parseEventDate(startDateStr);
        let text = `${start.month} ${start.day}`;
        if (endDateStr) {
            const end = this.parseEventDate(endDateStr);
            if (start.month === end.month) {
                text += ` - ${end.day}`;
            } else {
                text += ` - ${end.month} ${end.day}`;
            }
        }
        return `${text} &bull; ${cat.toUpperCase()}`;
    }

    /* --- PAGINATION CONTROLS --- */
    changePage(dir) {
        this.currentPage += dir;
        this.applyFilterDisplay();
    }

    setPage(page) {
        this.currentPage = page;
        this.applyFilterDisplay();
    }

    changeModalPage(dir) {
        this.modalPage += dir;
        this.applyModalFilterDisplay();
    }

    setModalPage(page) {
        this.modalPage = page;
        this.applyModalFilterDisplay();
    }

    /* --- FILTERING ENGINE --- */
    filterEvents(category) {
        this.currentFilter = category;
        this.currentPage = 0; 
        
        const filterBtns = this.container.querySelectorAll('.hs-filter-btn');
        filterBtns.forEach(btn => {
            btn.classList.remove('active');
            if(btn.getAttribute('data-filter') === category) btn.classList.add('active');
        });

        const selects = this.container.querySelectorAll('.hs-mobile-filter');
        selects.forEach(select => {
            if(select) select.value = category;
        });

        if (this.modalWrapper) {
            const modalSelects = this.modalWrapper.querySelectorAll('.hs-modal-mobile-filter');
            modalSelects.forEach(select => {
                if(select) select.value = category;
            });
        }

        const cards = this.container.querySelectorAll('.hs-card-v1');
        cards.forEach(card => {
            if (category === 'all' || card.getAttribute('data-category') === category) {
                card.setAttribute('data-matches', 'true');
            } else {
                card.setAttribute('data-matches', 'false');
            }
        });

        this.applyFilterDisplay();

        if (this.modalWrapper) {
            const modalList = this.modalWrapper.querySelector('#modal-list-view');
            if (modalList && window.getComputedStyle(modalList).display !== 'none') {
                this.populateViewAllList();
            }
        }
    }

    /* --- LAYOUT & RESPONSIVE DASHBOARD PAGINATION --- */
    applyFilterDisplay() {
        const isMobile = window.innerWidth <= 767;
        const isTablet = window.innerWidth > 767 && window.innerWidth <= 980;
        const isDesktop = window.innerWidth > 980 && window.innerWidth <= 1130;
        const cards = this.container.querySelectorAll('.hs-card-v1');
        let matchedCards = [];

        cards.forEach(card => {
            if (card.getAttribute('data-matches') === 'true') {
                card.classList.remove('filtered-out');
                matchedCards.push(card);
            } else {
                card.classList.add('filtered-out');
                card.classList.remove('paged-hidden');
            }
        });

        let cardsPerPage = 5; 
        if (isMobile) cardsPerPage = 1;
        else if (isTablet) cardsPerPage = 4;
        else if (isDesktop) cardsPerPage = 4;
        
        const totalPages = Math.ceil(matchedCards.length / cardsPerPage);
        
        if (this.currentPage >= totalPages) this.currentPage = Math.max(0, totalPages - 1);
        if (this.currentPage < 0) this.currentPage = 0;

        const startIndex = this.currentPage * cardsPerPage;
        const endIndex = startIndex + cardsPerPage;

        matchedCards.forEach((card, index) => {
            if (index >= startIndex && index < endIndex) {
                card.classList.remove('paged-hidden');
            } else {
                card.classList.add('paged-hidden');
            }
        });

        const controls = this.container.querySelector('#carousel-controls');
        if (controls) {
            const carouselDivider = this.container.querySelector('#carousel-divider');
            const carouselDivider2 = this.container.querySelector('#carousel-divider-2');
            if (totalPages > 1) {
                controls.style.display = 'flex';
                if(carouselDivider) carouselDivider.style.display = 'block';
                if(carouselDivider2) carouselDivider2.style.display = 'block';
                const dotsContainer = controls.querySelector('#carousel-dots');
                if (dotsContainer) {
                    dotsContainer.innerHTML = '';
                    let maxDots = 5;
                    let startDot = Math.max(0, this.currentPage - Math.floor(maxDots / 2));
                    let endDot = startDot + maxDots - 1;
                    if (endDot >= totalPages) {
                        endDot = totalPages - 1;
                        startDot = Math.max(0, endDot - maxDots + 1);
                    }
                    for(let i = startDot; i <= endDot; i++) {
                        const dot = document.createElement('span');
                        dot.className = 'hs-dot' + (i === this.currentPage ? ' active' : '');
                        dot.addEventListener('click', () => this.setPage(i));
                        dotsContainer.appendChild(dot);
                    }
                }
                const prevBtn = controls.querySelector('.hs-carousel-prev');
                const nextBtn = controls.querySelector('.hs-carousel-next');
                if(prevBtn) prevBtn.disabled = this.currentPage === 0;
                if(nextBtn) nextBtn.disabled = this.currentPage === totalPages - 1;
            } else {
                controls.style.display = 'none';
                if(carouselDivider) carouselDivider.style.display = 'none';
                if(carouselDivider2) carouselDivider2.style.display = 'none';
            }
        }

        const track = this.container.querySelector('.hs-events-track');
        if (track) {
            track.classList.remove('hs-meta-stacked');
            void track.offsetHeight; 
            
            let needsStacking = false;
            const visibleCards = matchedCards.filter((card, index) => index >= startIndex && index < endIndex);
            
            for (const card of visibleCards) {
                const meta = card.querySelector('.hs-card-meta');
                if (meta && meta.offsetHeight > 25) { 
                    needsStacking = true;
                    break;
                }
            }
            
            if (needsStacking) {
                track.classList.add('hs-meta-stacked');
            }
        }
    }

    /* --- MODAL PAGINATION ENGINE --- */
    applyModalFilterDisplay() {
        if (!this.modalWrapper) return;
        const isMobile = window.innerWidth <= 767;
        const strips = this.modalWrapper.querySelectorAll('#dynamic-list-body .hs-list-strip');
        
        let stripsPerPage;

        if (isMobile) {
            stripsPerPage = 2;
        } else {
            const availableHeight = (window.innerHeight * 0.95) - 250; 
            stripsPerPage = Math.floor(availableHeight / 122);
            if (stripsPerPage < 2) stripsPerPage = 2;
            if (stripsPerPage > 7) stripsPerPage = 7;
        }
        
        const totalPages = Math.ceil(strips.length / stripsPerPage);
        
        if (this.modalPage >= totalPages) this.modalPage = Math.max(0, totalPages - 1);
        if (this.modalPage < 0) this.modalPage = 0;

        const startIndex = this.modalPage * stripsPerPage;
        const endIndex = startIndex + stripsPerPage;

        strips.forEach((strip, index) => {
            if (index >= startIndex && index < endIndex) {
                strip.style.display = '';
            } else {
                strip.style.display = 'none';
            }
        });

        let controls = this.modalWrapper.querySelector('#modal-carousel-controls');
        if (!controls) {
            controls = document.createElement('div');
            controls.id = 'modal-carousel-controls';
            controls.className = 'hs-carousel-controls-wrapper'; 
            controls.style.marginTop = '5px';
            controls.innerHTML = `
                <button class="hs-carousel-btn hs-modal-prev"><i class="fa-solid fa-arrow-left"></i></button>
                <div class="hs-carousel-dots hs-modal-dots"></div>
                <button class="hs-carousel-btn hs-modal-next"><i class="fa-solid fa-arrow-right"></i></button>
            `;
            const listBody = this.modalWrapper.querySelector('#dynamic-list-body');
            if(listBody) listBody.appendChild(controls);

            controls.querySelector('.hs-modal-prev').addEventListener('click', () => this.changeModalPage(-1));
            controls.querySelector('.hs-modal-next').addEventListener('click', () => this.changeModalPage(1));
        }

        if (totalPages > 1) {
            controls.style.display = 'flex';
            const carouselDivider = this.modalWrapper.querySelector('#carousel-divider');
            if(carouselDivider) carouselDivider.style.display = 'block';
            
            const dotsContainer = controls.querySelector('.hs-modal-dots');
            if (dotsContainer) {
                dotsContainer.innerHTML = '';
                let maxDots = 5;
                let startDot = Math.max(0, this.modalPage - Math.floor(maxDots / 2));
                let endDot = startDot + maxDots - 1;
                if (endDot >= totalPages) {
                    endDot = totalPages - 1;
                    startDot = Math.max(0, endDot - maxDots + 1);
                }
                for(let i = startDot; i <= endDot; i++) {
                    const dot = document.createElement('span');
                    dot.className = 'hs-dot' + (i === this.modalPage ? ' active' : '');
                    dot.addEventListener('click', () => this.setModalPage(i));
                    dotsContainer.appendChild(dot);
                }
            }
            controls.querySelector('.hs-modal-prev').disabled = this.modalPage === 0;
            controls.querySelector('.hs-modal-next').disabled = this.modalPage === totalPages - 1;
        } else {
            controls.style.display = 'none';
            const carouselDivider = this.modalWrapper.querySelector('#carousel-divider');
            if(carouselDivider) carouselDivider.style.display = 'none';
        }
    }

    /* --- MODAL GENERATION & DATA INJECTION --- */
    openSingleModalFromNode(cardElement) {
        if (!this.modalWrapper) return;
        this.currentActiveCardElement = cardElement;
        const modalList = this.modalWrapper.querySelector('#modal-list-view');
        const modalSingle = this.modalWrapper.querySelector('#modal-single-view');
        const overlay = this.modalWrapper.querySelector('#hs-modal-overlay');

        this.currentEventData = {
            title: cardElement.getAttribute('data-title'),
            date: cardElement.getAttribute('data-date'),
            isoDate: cardElement.getAttribute('data-iso-date'),
            endDate: cardElement.getAttribute('data-end-date'),
            isoEndDate: cardElement.getAttribute('data-iso-end-date'),
            time: cardElement.getAttribute('data-time'),
            rawStartTime: cardElement.getAttribute('data-raw-start-time'),
            rawEndTime: cardElement.getAttribute('data-raw-end-time'),
            allDay: cardElement.getAttribute('data-all-day') === 'true',
            loc: cardElement.getAttribute('data-loc'),
            blurb: cardElement.getAttribute('data-blurb'),
            registerLink: cardElement.getAttribute('data-register-link')
        };

        const modalImg = this.modalWrapper.querySelector('#modal-img');
        if(modalImg) modalImg.src = cardElement.getAttribute('data-img');
        
        const modalCat = this.modalWrapper.querySelector('#modal-cat');
        const cat = cardElement.getAttribute('data-cat');
        const catColor = cardElement.getAttribute('data-catcolor');
        if(modalCat) {
            modalCat.textContent = cat;
            modalCat.style.color = catColor;
        }

        const mTitle = this.modalWrapper.querySelector('#modal-title');
        if(mTitle) mTitle.textContent = this.currentEventData.title;
        
        const mDate = this.modalWrapper.querySelector('#modal-date');
        if(mDate) mDate.textContent = this.currentEventData.date;
        
        const mTime = this.modalWrapper.querySelector('#modal-time');
        if(mTime) mTime.textContent = this.currentEventData.time;
        
        const mLoc = this.modalWrapper.querySelector('#modal-loc');
        if(mLoc) mLoc.textContent = this.currentEventData.loc;
        
        const mBlurb = this.modalWrapper.querySelector('#modal-blurb');
        if(mBlurb) mBlurb.textContent = this.currentEventData.blurb;
        
        const dateContainer = this.modalWrapper.querySelector('#modal-date-container');
        if (dateContainer) {
            dateContainer.innerHTML = this.generateBadgeHTML(this.currentEventData.isoDate || this.currentEventData.date, this.currentEventData.isoEndDate || this.currentEventData.endDate);
        }

        const registerBtn = this.modalWrapper.querySelector('#modal-register-btn');
        if (registerBtn) {
            if (this.currentEventData.registerLink) {
                registerBtn.href = this.currentEventData.registerLink;
                registerBtn.style.display = 'inline-flex';
            } else {
                registerBtn.style.display = 'none';
            }
        }
        
        const modalMobileDate = this.modalWrapper.querySelector('#modal-mobile-date');
        if (modalMobileDate) {
            modalMobileDate.innerHTML = this.generateMobileDateText(this.currentEventData.isoDate || this.currentEventData.date, this.currentEventData.isoEndDate || this.currentEventData.endDate, cat);
        }

        if (modalList) modalList.style.display = 'none';
        if (modalSingle) modalSingle.style.display = 'flex';
        if (overlay) overlay.classList.add('active');
    }

    navigateSingleModal(dir) {
        if (!this.currentActiveCardElement) return;
        
        const allCards = Array.from(this.container.querySelectorAll('.hs-events-track .hs-card-v1'));
        const matchedCards = this.currentFilter === 'all' 
            ? allCards 
            : allCards.filter(card => card.getAttribute('data-category') === this.currentFilter);
            
        let idx = matchedCards.indexOf(this.currentActiveCardElement);
        if (idx === -1) return;
        
        idx += dir;
        if (idx < 0) idx = matchedCards.length - 1;
        if (idx >= matchedCards.length) idx = 0;
        
        this.openSingleModalFromNode(matchedCards[idx]);
    }

    populateViewAllList() {
        if (!this.modalWrapper) return;
        const listBody = this.modalWrapper.querySelector('#dynamic-list-body');
        if(!listBody) return;
        listBody.innerHTML = ''; 
        
        const cards = Array.from(this.container.querySelectorAll('.hs-card-v1')); 
        
        cards.sort((a, b) => {
            const dateA = a.getAttribute('data-iso-date') || a.getAttribute('data-date');
            const dateB = b.getAttribute('data-iso-date') || b.getAttribute('data-date');
            return dateB.localeCompare(dateA);
        });
        
        cards.forEach(card => {
            if(card.getAttribute('data-matches') !== 'true') return;

            const title = card.getAttribute('data-title');
            const img = card.getAttribute('data-img');
            const cat = card.getAttribute('data-cat');
            const time = card.getAttribute('data-time');
            const loc = card.getAttribute('data-loc');
            const dateStr = card.getAttribute('data-date');
            const endDateStr = card.getAttribute('data-end-date');
            
            const catColor = card.getAttribute('data-catcolor');
            const badgeHTML = this.generateBadgeHTML(card.getAttribute('data-iso-date') || dateStr, card.getAttribute('data-iso-end-date') || endDateStr);
            const mobileDateText = this.generateMobileDateText(card.getAttribute('data-iso-date') || dateStr, card.getAttribute('data-iso-end-date') || endDateStr, cat);

            const strip = document.createElement('div');
            strip.className = 'hs-list-strip';
            strip.addEventListener('click', () => this.openSingleModalFromNode(card));

            strip.innerHTML = `
                <div class="hs-list-img-wrap">
                    <div class="hs-category-chip" style="color:${catColor}">${cat}</div>
                    <img src="${img}" alt="${title}">
                    ${badgeHTML}
                </div>
                <div class="hs-list-content">
                    <div class="hs-list-mobile-date">${mobileDateText}</div>
                    <h3>${title}</h3>
                    <div class="hs-list-meta">
                        <span><i class="fa-regular fa-clock"></i> ${time}</span>
                        <span><i class="fa-solid fa-location-dot"></i> ${loc}</span>
                    </div>
                </div>
                <div class="hs-list-action">
                    <button class="hs-btn-side">Details <i class="fa-solid fa-chevron-right"></i></button>
                </div>
            `;
            listBody.appendChild(strip);
        });

        this.applyModalFilterDisplay(); 
    }

    openViewAllModal() {
        this.modalPage = 0; 
        this.populateViewAllList();
        
        if (!this.modalWrapper) return;
        const modalSingle = this.modalWrapper.querySelector('#modal-single-view');
        const modalList = this.modalWrapper.querySelector('#modal-list-view');
        const overlay = this.modalWrapper.querySelector('#hs-modal-overlay');

        if(modalSingle) modalSingle.style.display = 'none';
        if(modalList) modalList.style.display = 'flex';
        if(overlay) overlay.classList.add('active');
    }

    closeModal() {
        if (!this.modalWrapper) return;
        const overlay = this.modalWrapper.querySelector('#hs-modal-overlay');
        if(overlay) overlay.classList.remove('active');
        
        this.container.querySelectorAll('.hs-cal-dropdown, .hs-btn-add-cal').forEach(el => el.classList.remove('active'));
        this.modalWrapper.querySelectorAll('.hs-cal-dropdown, .hs-btn-add-cal').forEach(el => el.classList.remove('active'));
    }

    /* --- ICS EXPORT & DROPDOWNS --- */
    toggleEventCalDropdown(e) {
        e.stopPropagation();
        const drop = this.modalWrapper.querySelector('#cal-dropdown-event');
        const btn = this.modalWrapper.querySelector('#btn-add-cal-event');
        if(drop) drop.classList.toggle('active');
        if(btn) btn.classList.toggle('active');
        
        const gDrop = this.container.querySelector('#global-cal-dropdown');
        const gBtn = this.container.querySelector('#btn-global-cal');
        if(gDrop) gDrop.classList.remove('active');
        if(gBtn) gBtn.classList.remove('active');
    }

    toggleGlobalCalDropdown(e) {
        e.stopPropagation();
        const gDrop = this.container.querySelector('#global-cal-dropdown');
        const gBtn = this.container.querySelector('#btn-global-cal');
        if(gDrop) gDrop.classList.toggle('active');
        if(gBtn) gBtn.classList.toggle('active');
        
        if (this.modalWrapper) {
            const drop = this.modalWrapper.querySelector('#cal-dropdown-event');
            const btn = this.modalWrapper.querySelector('#btn-add-cal-event');
            if(drop) drop.classList.remove('active');
            if(btn) btn.classList.remove('active');
        }
    }

    subscribeCalendar(platform) {
        // Construct the global feed URLs based on the new feed-ics.php endpoint
        const siteUrl = window.location.origin;
        const campusFilter = this.container.getAttribute('data-feed-campus') || '';
        const campusParam = (campusFilter && campusFilter !== 'both') ? `&campus=${campusFilter}` : '';
        
        const feedUrl = `${siteUrl}/?feed=hs_events_calendar${campusParam}`;
