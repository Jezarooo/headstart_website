            for (let dr = 0; dr < piece.h; dr++) {
                for (let dc = 0; dc < piece.w; dc++) {
                    grid[pos.r + dr][pos.c + dc] = true;
                }
            }
            items.push({ span: piece.span, type: piece.type, gridRow: pos.r + 1, gridCol: pos.c + 1 });
            placedCount++;
        }

        // Fill ALL remaining cells with 1x1 smalls — no gaps possible
        let smallsPlaced = 0;
        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
                if (!grid[r][c]) {
                    items.push({ span: '1x1', type: 'S', gridRow: r + 1, gridCol: c + 1 });
                    smallsPlaced++;
                }
            }
        }

        // Verify: smalls used must match expected count
        if (smallsPlaced !== sCount) return null;

        // Sort items by row then column so DOM order matches visual order naturally
        items.sort((a, b) => {
            if (a.gridRow !== b.gridRow) return a.gridRow - b.gridRow;
            return a.gridCol - b.gridCol;
        });

        return { cols, items };
    }



    /* --- RENDER HELPER --- */

    function renderMosaicGrid(config, targetGridElement) {
        targetGridElement.innerHTML = '';
        targetGridElement.style.setProperty('--cols', config.cols);
        const fragment = document.createDocumentFragment();

        config.items.forEach(mappedItem => {
            const data = mappedItem.data;
            const aTag = document.createElement('a');
            aTag.href = data.highResSrc;
            aTag.className = `hs-span-${mappedItem.span}`; 
            aTag.setAttribute('data-title', data.titleText);
            aTag.setAttribute('data-caption', data.captionText);

            // If the simulator computed explicit positions, apply them.
            // This guarantees the grid matches the simulator exactly,
            // regardless of how the browser's dense packing behaves.
            if (mappedItem.gridRow !== undefined && mappedItem.gridCol !== undefined) {
                const spanMap = { '1x1': [1,1], '2x2': [2,2], '1x3': [1,3], '3x3': [3,3] };
                const [sw, sh] = spanMap[mappedItem.span] || [1,1];
                
                const finalW = mappedItem.w || sw;
                const finalH = mappedItem.h || sh;
                
                aTag.style.setProperty('--hs-grid-row', mappedItem.gridRow + ' / span ' + finalH);
                aTag.style.setProperty('--hs-grid-col', mappedItem.gridCol + ' / span ' + finalW);
            }

            const newImg = document.createElement('img');
            if (mappedItem.span === '1x1') {
                newImg.src = data.thumbImg.src; 
                const srcset = data.thumbImg.getAttribute('srcset');
                const sizes = data.thumbImg.getAttribute('sizes');
                if (srcset) newImg.setAttribute('srcset', srcset);
                if (sizes) newImg.setAttribute('sizes', sizes);
            } else {
                newImg.src = data.highResSrc; 
            }

            newImg.setAttribute('loading', 'lazy'); 
            newImg.setAttribute('decoding', 'async');
            newImg.alt = data.titleText || 'Gallery Image';

            aTag.appendChild(newImg);
            fragment.appendChild(aTag);
        });

        targetGridElement.appendChild(fragment);
    }

    /* --- PRE-COMPILATION ENGINE --- */
    
    async function preCompileGallery(container) {
        if (container.hsGridConfig || container.dataset.hsCompiling) return; 
        container.dataset.hsCompiling = 'true';

        // If the container IS the gallery module, use it. Otherwise, look inside it.
        const nativeGallery = container.classList.contains('et_pb_gallery') ? container : container.querySelector('.et_pb_gallery');
        if (!nativeGallery) return;

        const galleryItems = Array.from(nativeGallery.querySelectorAll('.et_pb_gallery_item'));
        if (galleryItems.length === 0) return;

        const measuredItems = await Promise.all(galleryItems.map(item => {
            return new Promise(resolve => {
                const link = item.querySelector('.et_pb_gallery_image a');
                if (!link) return resolve(null);
                
                const highResSrc = link.getAttribute('href');
                const thumbImg = link.querySelector('img');
                const titleTag = item.querySelector('.et_pb_gallery_title');
                const captionTag = item.querySelector('.et_pb_gallery_caption, p');
                
                const data = {
                    highResSrc,
                    thumbImg,
                    titleText: titleTag ? titleTag.innerText.trim() : '',
                    captionText: captionTag && captionTag !== titleTag ? captionTag.innerText.trim() : '',
                    isPortrait: false
                };

                const tempImg = new Image();
                tempImg.onload = () => {
                    data.isPortrait = tempImg.naturalHeight > tempImg.naturalWidth;
                    resolve(data);
                };
                tempImg.onerror = () => resolve(data);
                tempImg.src = highResSrc;
            });
        }));

        const validItems = measuredItems.filter(Boolean);
        let landscapes = validItems.filter(d => !d.isPortrait);
        let portraits = validItems.filter(d => d.isPortrait);

        /* 1. COMPILE MASTER CONFIG (FOR MODAL - 100% IDENTICAL TO ORIGINAL) */
        let masterConfig;
        if (portraits.length === 0 && validItems.length <= 20 && FIXED_LANDSCAPE_CONFIGS[validItems.length]) {
            masterConfig = JSON.parse(JSON.stringify(FIXED_LANDSCAPE_CONFIGS[validItems.length]));
        } else {
            const targetCols = validItems.length < 8 ? 4 : 5;
            masterConfig = generateFlushGrid(landscapes.length, portraits.length, targetCols, true);
        }

        let mappedMasterItems = masterConfig.items.map(item => ({ ...item, data: null }));
        const assignSpanMaster = (spanTarget, sourceArray) => {
            mappedMasterItems.forEach(item => {
                if (item.span === spanTarget && sourceArray.length > 0) item.data = sourceArray.shift();
            });
        };
        
        let landCopy = [...landscapes];
        let portCopy = [...portraits];
        assignSpanMaster('3x3', landCopy);
        assignSpanMaster('2x2', landCopy);
        assignSpanMaster('1x3', portCopy);
        assignSpanMaster('1x1', landCopy); 
        assignSpanMaster('1x1', portCopy); 

        container.hsGridConfig = {
            cols: masterConfig.cols,
            items: mappedMasterItems.filter(i => i.data !== null)
        };

        /* 2. COMPILE PAGINATED INLINE CONFIG (NEW FEATURE) */
        if (container.classList.contains('hs-inline-mosaic')) {
            const isPaginated = container.classList.contains('hs-paginate-mosaic');
            let chunks = [];
            if (isPaginated && validItems.length > 12) {
                // STEP 1: Interleave portraits and landscapes evenly.
                // This prevents portrait-heavy or landscape-heavy clusters from
                // creating mathematically impossible chunks.
                const landItems = validItems.filter(d => !d.isPortrait);
                const portItems = validItems.filter(d => d.isPortrait);
                const interleaved = [];
                let li = 0, pi = 0;
                // Distribute whichever type is less common evenly among the other
                const totalL = landItems.length;
                const totalP = portItems.length;
                for (let i = 0; i < validItems.length; i++) {
                    // Calculate how many of each type should appear by position i+1
                    const targetL = Math.round((i + 1) * totalL / validItems.length);
                    const targetP = Math.round((i + 1) * totalP / validItems.length);
                    // Add whichever type is most behind its target
                    if (li < totalL && (pi >= totalP || li < targetL)) {
                        interleaved.push(landItems[li++]);
                    } else if (pi < totalP) {
                        interleaved.push(portItems[pi++]);
                    }
                }
                
                // STEP 2: Chunk the interleaved array, testing each chunk size
                // with the actual math engine to guarantee it won't fall back.
                let currentIndex = 0;
                while (currentIndex < interleaved.length) {
                    let remaining = interleaved.length - currentIndex;
                    if (remaining <= 18) {
                        chunks.push(interleaved.slice(currentIndex));
                        break;
                    }
                    
                    let bestSize = 14;
                    
                    // Test chunk sizes from preferred to flexible, pick the first
                    // that produces a perfect (non-fallback) bento grid
                    const sizeOptions = [14, 15, 13, 16, 12, 17, 11, 18, 10];
                    for (let size of sizeOptions) {
                        if (currentIndex + size > interleaved.length) continue;
                        // Don't leave a tiny remainder (< 10) for the last chunk
                        let wouldRemain = interleaved.length - currentIndex - size;
                        if (wouldRemain > 0 && wouldRemain < 10) continue;
                        
                        let testChunk = interleaved.slice(currentIndex, currentIndex + size);
                        let lCount = testChunk.filter(d => !d.isPortrait).length;
                        let pCount = testChunk.filter(d => d.isPortrait).length;
                        
                        let testConfig = generateFlushGrid(lCount, pCount, 5);
                        if (!testConfig.isFallback) {
                            bestSize = size;
                            break;
                        }
                    }
                    
                    chunks.push(interleaved.slice(currentIndex, currentIndex + bestSize));
                    currentIndex += bestSize;
                }
            } else {
                chunks.push(validItems);
            }

            const inlineConfigs = chunks.map((chunk, chunkIndex) => {
                let cLand = chunk.filter(d => !d.isPortrait);
                let cPort = chunk.filter(d => d.isPortrait);
                const isLastChunk = chunkIndex === chunks.length - 1;
                
                let chunkConfig;
                if (cPort.length === 0 && cLand.length <= 20 && FIXED_LANDSCAPE_CONFIGS[cLand.length]) {
                    chunkConfig = JSON.parse(JSON.stringify(FIXED_LANDSCAPE_CONFIGS[cLand.length]));
                } else if (isPaginated) {
                    // Last page: use masonry fallback (varied sizes, possibly ragged edge)
                    // Earlier pages: use nuclear fallback (flat edge) if math engine fails
                    chunkConfig = generateFlushGrid(cLand.length, cPort.length, 5, isLastChunk);
                } else {
                    const targetCols = chunk.length < 8 ? 4 : 5;
                    chunkConfig = generateFlushGrid(cLand.length, cPort.length, targetCols);
                }
                
                let mappedChunk = chunkConfig.items.map(item => ({ ...item, data: null }));
                const assignChunkSpan = (spanTarget, sourceArray) => {
                    mappedChunk.forEach(item => {
                        if (item.span === spanTarget && sourceArray.length > 0) item.data = sourceArray.shift();
                    });
                };
                
                if (isPaginated) {
                    assignChunkSpan('3x3', cLand);
                    assignChunkSpan('2x2', cLand);
                    assignChunkSpan('1x3', cPort);
                    assignChunkSpan('1x1', cLand); 
                    assignChunkSpan('1x1', cPort); // overflow portraits as 1x1 if needed
                } else {
                    assignChunkSpan('3x3', cLand);
                    assignChunkSpan('2x2', cLand);
                    assignChunkSpan('1x3', cPort);
                    assignChunkSpan('1x1', cLand); 
                    assignChunkSpan('1x1', cPort); 
                }

                return { cols: chunkConfig.cols, items: mappedChunk.filter(i => i.data !== null) };
            });

            renderInlineGallery(container, inlineConfigs);
        }
    }

    function renderInlineGallery(container, configs) {
        if (container.querySelector('.hs-inline-mosaic-wrapper')) return;

        let activeIndex = 0;
        // Default inline mosaics to split-theme so the auto-collapse logic can show text if present
        const themeClass = 'hs-split-theme';
        
        const wrapper = document.createElement('div');
        wrapper.className = 'hs-inline-mosaic-wrapper';
        
        const gridContainers = configs.map((config, index) => {
            const grid = document.createElement('div');
            grid.className = 'hs-mosaic-grid';
            if (index === 0) grid.classList.add('hs-active-grid');
            renderMosaicGrid(config, grid);
            wrapper.appendChild(grid);
            return grid;
        });

        // Initialize Magnific Popup globally on the wrapper so users can cycle through ALL images across all pages
        if (window.jQuery && jQuery.fn.magnificPopup) {
            jQuery(wrapper).magnificPopup({
                delegate: 'a',
                type: 'image',
                gallery: { enabled: true, navigateByImgClick: true, preload: [1,2] }, 
                mainClass: `mfp-fade ${themeClass}`, 
                fixedContentPos: true,
                fixedBgPos: true,
                closeBtnInside: false,
                closeMarkup: '<div title="%title%" class="mfp-close hs-modal-close hs-shared-close"><span class="hs-modal-close-text">CLOSE</span><span class="hs-modal-close-icon">&times;</span></div>',
                image: {
                    markup: '<div class="mfp-figure hs-split-preview">'+
                              '<div class="hs-preview-img-wrapper"><div class="mfp-img"></div></div>'+
                              '<div class="hs-preview-text-wrapper">'+
                                 '<div class="mfp-title"></div>'+
                                 '<div class="mfp-counter"></div>'+
                              '</div>'+
                              '<div class="mfp-close-container"></div>'+
                            '</div>',
                    titleSrc: function(item) {
                        let t = item.el.attr('data-title') || '';
                        let c = item.el.attr('data-caption') || '';
                        let html = '';
                        if(t) html += '<div style="color:#003057; font-weight:800; font-size:1.5rem; margin-bottom:10px; line-height:1.2; font-family:\'Montserrat\', sans-serif;">' + t + '</div>';
                        if(c) html += '<div style="font-family:\'Open Sans\', sans-serif; color:#444; font-size:0.95rem; line-height:1.6;">' + c + '</div>';
                        return html;
                    }
                },
                callbacks: {
                    change: function() {
                        let t = this.currItem.el.attr('data-title') || '';
                        let c = this.currItem.el.attr('data-caption') || '';
                        if (!t && !c) {
                            this.wrap[0].classList.add('hs-empty-text');
                        } else {
                            this.wrap[0].classList.remove('hs-empty-text');
                        }
                    }
                }
            });
        }
        
        container.appendChild(wrapper);

        if (configs.length > 1) {
            const controls = document.createElement('div');
            controls.className = 'hs-paginate-controls';
            
            const prevBtn = document.createElement('button');
            prevBtn.className = 'hs-carousel-btn';
            prevBtn.innerHTML = '&#8592;';
            prevBtn.disabled = true;
            
            const dotsWrapper = document.createElement('div');
            dotsWrapper.className = 'hs-paginate-dots';
            const dots = configs.map((_, i) => {
                const dot = document.createElement('div');
                dot.className = `hs-dot ${i === 0 ? 'active' : ''}`;
                dot.addEventListener('click', () => showPage(i));
                dotsWrapper.appendChild(dot);
                return dot;
            });
            
            const nextBtn = document.createElement('button');
            nextBtn.className = 'hs-carousel-btn';
            nextBtn.innerHTML = '&#8594;';
            
            controls.appendChild(prevBtn);
            controls.appendChild(dotsWrapper);
            controls.appendChild(nextBtn);
            container.appendChild(controls);
            
            const showPage = (index) => {
                const prevHeight = wrapper.offsetHeight;
                
                gridContainers[activeIndex].classList.remove('hs-active-grid');
                dots[activeIndex].classList.remove('active');
                
                activeIndex = index;
                
                gridContainers[activeIndex].classList.add('hs-active-grid');
                dots[activeIndex].classList.add('active');
                
                wrapper.style.height = prevHeight + 'px';
                void wrapper.offsetHeight; // force reflow
                wrapper.style.height = gridContainers[activeIndex].offsetHeight + 'px';
                
                prevBtn.disabled = activeIndex === 0;
                nextBtn.disabled = activeIndex === configs.length - 1;
            };
            
            prevBtn.addEventListener('click', () => { if (activeIndex > 0) showPage(activeIndex - 1); });
            nextBtn.addEventListener('click', () => { if (activeIndex < configs.length - 1) showPage(activeIndex + 1); });
            
            // Keep height responsive when window resizes
            const ro = new ResizeObserver(() => {
                if (gridContainers[activeIndex]) {
                    wrapper.style.height = gridContainers[activeIndex].offsetHeight + 'px';
                }
            });
            ro.observe(container);
        }
        
        container.classList.add('hs-mosaic-loaded');
    }

    setTimeout(() => {
        document.querySelectorAll('.hs-gallery-container').forEach(preCompileGallery);
    }, 1500);


    /* --- EVENT ROUTING & MODAL RENDERING (ORIGINAL LOGIC) --- */
    
    document.addEventListener('click', async function(e) {
        
        const trigger = e.target.closest('.hs-gallery-trigger, .hs-gallery-trigger-split, .hs-gallery-trigger-full');
        if (!trigger) return;

        e.preventDefault();
        e.stopPropagation();

        const container = trigger.closest('.hs-gallery-container');
        if (!container) return;

        const isSplitTheme = trigger.classList.contains('hs-gallery-trigger-split');
        const themeClass = isSplitTheme ? 'hs-split-theme' : 'hs-full-theme';

        const mosaicGrid = modalPopup.querySelector('.hs-mosaic-grid');
        if (!mosaicGrid) return;
        
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        if (scrollbarWidth > 0) {
            document.body.style.paddingRight = `${scrollbarWidth}px`;
            const mainHeader = document.getElementById('main-header'); 
            if (mainHeader) mainHeader.style.paddingRight = `${scrollbarWidth}px`;
        }

        if(modalPopup) modalPopup.style.setProperty('display', 'block', 'important');
        document.body.style.overflow = 'hidden'; 
        
        mosaicGrid.innerHTML = ''; 

        if (!container.hsGridConfig) {
            await preCompileGallery(container);
        }

        const config = container.hsGridConfig;
        if (!config) return;

        renderMosaicGrid(config, mosaicGrid);

        if (window.jQuery && jQuery.fn.magnificPopup) {
            jQuery(mosaicGrid).magnificPopup({
                delegate: 'a',
                type: 'image',
                gallery: { enabled: true, navigateByImgClick: true, preload: [1,2] }, 
                mainClass: `mfp-fade ${themeClass}`, 
                closeBtnInside: false,
                closeMarkup: '<div title="%title%" class="mfp-close hs-modal-close hs-shared-close"><span class="hs-modal-close-text">CLOSE</span><span class="hs-modal-close-icon">&times;</span></div>',
                image: {
                    markup: '<div class="mfp-figure hs-split-preview">'+
                              '<div class="hs-preview-img-wrapper"><div class="mfp-img"></div></div>'+
                              '<div class="hs-preview-text-wrapper">'+
                                 '<div class="mfp-title"></div>'+
                                 '<div class="mfp-counter"></div>'+
                              '</div>'+
                              '<div class="mfp-close-container"></div>'+
                            '</div>',
                    titleSrc: function(item) {
                        let t = item.el.attr('data-title') || '';
                        let c = item.el.attr('data-caption') || '';
                        let html = '';
                        if(t) html += '<div style="color:#003057; font-weight:800; font-size:1.5rem; margin-bottom:10px; line-height:1.2; font-family:\'Montserrat\', sans-serif;">' + t + '</div>';
                        if(c) html += '<div style="font-family:\'Open Sans\', sans-serif; color:#444; font-size:0.95rem; line-height:1.6;">' + c + '</div>';
                        return html;
                    }
                },
                callbacks: {
                    change: function() {
                        let t = this.currItem.el.attr('data-title') || '';
                        let c = this.currItem.el.attr('data-caption') || '';
                        if (!t && !c) {
                            this.wrap[0].classList.add('hs-empty-text');
                        } else {
                            this.wrap[0].classList.remove('hs-empty-text');
                        }
                    },
                    open: function() { if(closeBtn) { closeBtn.style.opacity = '0'; closeBtn.style.pointerEvents = 'none'; } },
                    close: function() { if(closeBtn) { closeBtn.style.opacity = '1'; closeBtn.style.pointerEvents = 'auto'; } }
                }
            });
        }
    }, true); 








});
</script>

<script>
/**
 * =============================================================================
 * HEADSTART STAFF DIRECTORY ENGINE (V3)
 * =============================================================================
 * PURPOSE: Processes JSON data into a Tetris-style bin-packing grid layout.
 * LOGIC: Data taxonomy driven engine for staff directories.
 * DEPENDENCIES: Staff JSON Data, Divi grid
 * =============================================================================
 */
const initDirectory = async () => {
    const grid = document.getElementById('main-staff-grid');
    const modalOverlay = document.getElementById('staff-modal-overlay');
    const modalClose = document.getElementById('staff-modal-close');
    const modalImg = document.getElementById('modal-img');
    const modalName = document.getElementById('modal-name');
    const modalTitle = document.getElementById('modal-title');
    const modalDept = document.getElementById('modal-dept');
    const modalCampus = document.getElementById('modal-campus');
    const modalBlurb = document.getElementById('modal-blurb');

    // 0. FIX STACKING CONTEXT ISSUES
    // Move modal to body so it escapes Divi's z-index trapping, wrapped in our scoped class
    if (modalOverlay && modalOverlay.parentNode) {
        const wrapper = document.createElement('div');
        wrapper.className = 'hs-staff-directory hs-modal-global-wrapper';
        wrapper.style.position = 'fixed'; 
        wrapper.style.zIndex = '2147483647';
        wrapper.style.pointerEvents = 'none';
        wrapper.style.top = '0';
        wrapper.style.left = '0';
        wrapper.appendChild(modalOverlay);
        document.body.appendChild(wrapper);
    }

    // --- Tetris Layout State ---
    const strictOrderDepts = ['Foundation', 'Primary', 'Leadership Team'];
    let lastCardsPerRow = getCardsPerRow();

    function getCardsPerRow() {
        const w = window.innerWidth;
        if (w >= 1600) return 7;
        if (w >= 1400) return 6;
        if (w >= 1200) return 5;
        if (w >= 992) return 4;
        if (w >= 768) return 3;
        if (w >= 480) return 2;
        return 1;
    }

    function tetrisPackGroups(subGroupNames, subGroupsObj, maxCardsPerRow) {
        let remaining = [...subGroupNames];
        let packed = [];
        let currentRowSpace = maxCardsPerRow;
        
        while(remaining.length > 0) {
            let placedAny = false;
            for (let i = 0; i < remaining.length; i++) {
                const sgName = remaining[i];
                const size = subGroupsObj[sgName].length;
                
                // Clusters > maxCardsPerRow take 100% width, so their effective pack size is maxCardsPerRow
                const effectiveSize = Math.min(size, maxCardsPerRow);
                
                // If it fits, or if it's the start of a new line (must place it even if it overflows)
                if (effectiveSize <= currentRowSpace || currentRowSpace === maxCardsPerRow) {
                    packed.push(sgName);
                    remaining.splice(i, 1);
                    
                    currentRowSpace -= effectiveSize;
                    if (currentRowSpace <= 0) {
                        currentRowSpace = maxCardsPerRow;
                    }
                    placedAny = true;
                    break;
                }
            }
            if (!placedAny) currentRowSpace = maxCardsPerRow; // Force new row
        }
        return packed;
    }

    // Debounced Resize Listener
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            const currentCols = getCardsPerRow();
            if (currentCols !== lastCardsPerRow) {
                lastCardsPerRow = currentCols;
                renderDirectory(document.querySelector('.hs-search-input') ? document.querySelector('.hs-search-input').value : '');
            }
        }, 150);
    });

    
    // Hide old UI elements
    const hsCampusFilters = document.getElementById('hsCampusFilters');
    if (hsCampusFilters) hsCampusFilters.style.display = 'none';

    // Inject New UI (Premium Toolbar)
    const headerRight = document.getElementById('hs-header-inject');
    if (headerRight) {
        // Build the dropdown HTML dynamically based on the Directory Builder structure
        let depts = [];
        if (window.hsDirectoryStructure && Object.keys(window.hsDirectoryStructure).length > 0) {
            depts = Object.keys(window.hsDirectoryStructure);
        } else {
            depts = [
                'Foundation', 'Primary', 'Secondary', 'PE & Academies',
                'Creative & Performing Arts (CAPA)', 'Languages', 'Student Support',
                'Operations & Administration'
            ];
        }
        
        let dropdownHtml = `<div class="dropdown-item" data-dept="all">View All Departments</div>
                           <div style="height: 1px; background: #e2e8f0; margin: 5px 0;"></div>`;
        depts.forEach(d => {
            dropdownHtml += `<div class="dropdown-item" data-dept="${d}">${d}</div>`;
        });

        headerRight.innerHTML = `
            <div class="hs-header-toolbar">
                <div class="opt-3-tabs">
                    <div class="opt-3-tab-container">
                        <div class="opt-3-tab active" data-campus="all">Leadership Team</div>
                    </div>
                    
                    <div class="opt-3-tab-container">
                        <div class="opt-3-tab" data-campus="Chaofah City">
                            Chaofah City <i class="fa-solid fa-chevron-down"></i>
                        </div>
                        <div class="opt-3-dropdown-menu hs-dept-jump" data-target-campus="Chaofah City">
                            ${dropdownHtml}
                        </div>
                    </div>

                    <div class="opt-3-tab-container">
                        <div class="opt-3-tab" data-campus="Cherngtalay">
                            Cherngtalay <i class="fa-solid fa-chevron-down"></i>
                        </div>
                        <div class="opt-3-dropdown-menu hs-dept-jump" data-target-campus="Cherngtalay">
                            ${dropdownHtml}
                        </div>
                    </div>
                </div>
                
                <div class="opt-3-search">
                    <i class="fa-solid fa-search"></i>
                    <input type="text" id="staff-search-new" placeholder="Search the directory..." autocomplete="off">
                    <div id="hs-search-dropdown" class="hs-search-dropdown"></div>
                </div>
            </div>
        `;
    }

    const searchInput = document.getElementById('staff-search-new');
    let staffData = [];
    let currentCampus = 'all';

    try {
        staffData = window.hsStaffData || [];
    } catch (e) {
        console.error("Failed to load staff data", e);
        if (grid) grid.innerHTML = '<p>Failed to load data.</p>';
        return;
    }

    function createCard(staff) {
        const card = document.createElement('div');
        let cleanName = staff.name || '';

        const hasProfile = staff.blurb && staff.blurb.trim() !== '';
        
        let borderClass = 'hs-card-support';
        if (staff.tier === '1. Executive') borderClass = 'hs-card-exec';
        else if (staff.tier === '2. Management') borderClass = 'hs-card-manager';
        else if (staff.tier === '3. Teaching Staff') borderClass = 'hs-card-teacher';
        
        card.className = `hs-staff-card ${borderClass} ${hasProfile ? 'hs-has-profile' : ''}`;
        
        let hoverHtml = hasProfile ? `
                <div class="hs-hover-overlay">
                    <div class="hs-btn-view">Read Profile</div>
                </div>
        ` : '';

        const campusBadge = (staff.campus) 
            ? `<div style="margin-top: auto;"><span class="hs-card-campus-badge">${staff.campus}</span></div>` 
            : '';

        const emailHtml = staff.email ? `<div class="hs-email-icon" title="Contact"><i class="fa-solid fa-envelope"></i></div>` : '';

        const nameLen = cleanName.length;
        let nameClass = '';
        if (nameLen > 32) nameClass = 'hs-name-xsm';
        else if (nameLen > 22) nameClass = 'hs-name-sm';
        const titleClass = (staff.title || '').length > 60 ? 'hs-title-sm' : '';

        card.innerHTML = `
            <div class="hs-staff-img-wrap">
                ${hoverHtml}
                ${emailHtml}
                <img src="${staff.image || 'images/dummy.jpg'}" alt="${staff.name}" loading="lazy">
            </div>
            <div class="hs-staff-body">
                <div class="hs-staff-name-wrap">
                    <h3 class="hs-staff-name ${nameClass}">${cleanName}</h3>
                </div>
                <div class="hs-staff-title-wrap">
                    <div class="hs-badge-title ${titleClass}">${staff.title}</div>
                </div>
                ${campusBadge}
            </div>
        `;

        if (hasProfile) {
            card.addEventListener('click', () => {
                modalImg.src = staff.image || 'images/dummy.jpg';
                modalName.textContent = cleanName;
                modalTitle.textContent = staff.title;
                if (staff.department && staff.department.trim() !== '') {
                    modalDept.textContent = staff.department;
                    modalDept.parentElement.style.display = '';
                } else {
                    modalDept.textContent = '';
                    modalDept.parentElement.style.display = 'none';
                }

                if (staff.campus && staff.campus.trim() !== '') {
                    modalCampus.textContent = staff.campus;
                    modalCampus.parentElement.style.display = '';
                } else {
                    modalCampus.textContent = '';
                    modalCampus.parentElement.style.display = 'none';
                }
                
                modalBlurb.innerHTML = (staff.blurb || '').split('\n\n').map(p => `<p>${p}</p>`).join('');
                modalOverlay.classList.add('active');
            });
        }
        return card;
    }

    function renderDirectory(searchQuery = '') {
        if (!grid) return;
        
        // Prevent scroll-yanking by temporarily freezing the grid's height
        const oldHeight = grid.getBoundingClientRect().height;
        if (oldHeight > 0) {
            grid.style.minHeight = oldHeight + 'px';
        }
        
        grid.innerHTML = '';
        
        // Setup Layout for Leadership vs Campus
        if (currentCampus === 'all') {
            grid.style.display = 'flex';
            grid.style.flexWrap = 'wrap';
            grid.style.gap = '3rem';
            grid.style.justifyContent = 'center';
            grid.style.alignItems = 'flex-start';
            grid.style.padding = '20px 0';
        } else {
            grid.style.display = 'block';
            grid.style.padding = '0';
        }
        
        // 1. FILTERING
        let filtered = staffData.filter(s => {
            // Campus Filter
            if (currentCampus !== 'all') {
                // Drop staff with no department (e.g. global executives) so they don't generate an "Other" accordion
                if (!s.department || s.department.trim() === '') return false;
                
                if (s.campus !== 'Both Campuses' && s.campus !== currentCampus) {
                    return false;
                }
            }
            // Search Filter
            if (searchQuery) {
                const q = searchQuery.toLowerCase();
                const matchName = (s.name || '').toLowerCase().includes(q);
                const matchTitle = (s.title || '').toLowerCase().includes(q);
                const matchDept = (s.department || '').toLowerCase().includes(q);
                const matchGroup = (s.group || '').toLowerCase().includes(q);
                if (!matchName && !matchTitle && !matchDept && !matchGroup) return false;
            }
            return true;
        });

        // 2. DEPARTMENT GROUPING (Accordions)
        // If Campus === 'all', we ONLY build Leadership Team grids (Executives, Directors, Senior Mgmt)
        // If Campus !== 'all', we build departmental accordions.
        
        const depts = {};
        // Load Directory Structure from Builder
        let structure = window.hsDirectoryStructure || {};
        
        // Fallback if they haven't saved the builder yet
        if (Object.keys(structure).length === 0) {
            structure = {
                'Foundation': [], 'Primary': [], 'Secondary': [], 'PE & Academies': [], 
                'Creative & Performing Arts (CAPA)': [], 'Languages': [], 'Student Support': [], 
                'Operations & Administration': []
            };
        }
        
        // Define accordion order based on the structure keys
        const accordionOrder = Object.keys(structure);
        
        filtered.forEach(s => {
            const tierStr = s.tier || '';
            const isTier123 = tierStr.includes('1.') || tierStr.includes('2.') || tierStr.includes('3.');
            
            if (currentCampus === 'all') {
                const isSecretary = tierStr.includes('7.') && (s.title || '').toLowerCase().includes('secretary to');
                if (!isTier123 && !isSecretary) return; // Only Leadership on all tab
                
                // Group by Tier for Leadership page
                let deptKey = 'Senior Management';
                if (tierStr.includes('1.')) deptKey = 'Executives';
                if (tierStr.includes('2.')) deptKey = 'School Directors';
                
                if (isSecretary) {
                    // Find manager's tier so secretary goes to the correct cluster
                    const managerName = (s.reportsTo || '').toLowerCase().trim();
                    const manager = staffData.find(m => (m.name || '').toLowerCase().includes(managerName));
                    if (manager) {
                        const mTier = manager.tier || '';
                        if (mTier.includes('1.')) deptKey = 'Executives';
                        if (mTier.includes('2.')) deptKey = 'School Directors';
                    }
                }
                
                if (!depts[deptKey]) depts[deptKey] = [];
                if (!depts[deptKey].some(existing => existing.name === s.name)) {
                    depts[deptKey].push(s);
                }
                
            } else {
                // Normal Campus Page Accordions
                if (isTier123) {
                    // Execs and Directors don't appear on campus pages unless they specifically have a department assigned
                    if (!s.department || s.department.toLowerCase().includes('leadership team')) {
                        return; 
                    }
                }

                let primaryDepts = s.department ? s.department.split(',').map(d => d.trim()).filter(d => d) : ['Other'];
                
                // Track all departments this person belongs to
                let targetDepts = [...primaryDepts];
                

                targetDepts.forEach(d => {
                    // Normalize Leadership Team cross-pollination
                    if (d === 'Leadership Team') return; // Handled separately or ignored on campus pages if they don't have a specific dept
                    
                    if (!depts[d]) depts[d] = [];
                    // Prevent duplicates if primary and secondary are same
                    if (!depts[d].find(x => x.name === s.name)) {
                        depts[d].push(s);
                    }
                });
            }
        });

        let firstAccordion = true;
        
        // Render order: either Leadership grids or standard Accordion order
        let keysToRender = currentCampus === 'all' ? ['Executives', 'School Directors', 'Senior Management'] : [...accordionOrder];
        
        // Add any unexpected departments to the end
        Object.keys(depts).forEach(k => {
            if (!keysToRender.includes(k)) keysToRender.push(k);
        });

        keysToRender.forEach(deptName => {
            const members = depts[deptName];
            if (!members || members.length === 0) return;

            let contentWrapper;

            if (currentCampus === 'all') {
                // Leadership Page Layout (Uses exact same chips as Campus Page)
                const clusterWrap = document.createElement('div');
                clusterWrap.className = 'hs-cluster';
                
                const chip = document.createElement('div');
                chip.className = 'hs-cluster-chip';
                chip.textContent = deptName;
                
                if (deptName === 'Executives' || deptName === 'School Directors') {
                    chip.style.background = '#fef3c7'; // Amber
                    chip.style.color = '#b45309';
                }
                
                clusterWrap.appendChild(chip);

                const cardsWrap = document.createElement('div');
                cardsWrap.className = 'hs-cluster-cards';
                
                sortAndInjectSecretaries(members).forEach(m => {
                    cardsWrap.appendChild(createCard(m));
                });
                
                clusterWrap.appendChild(cardsWrap);
                grid.appendChild(clusterWrap);
                
            } else {
                // Campus Page Layout (Accordions with Chips)
                const accordion = document.createElement('div');
                // Use Design 4 (High Contrast)
                const safeId = deptName.replace(/[^a-z0-9]/gi, '-').toLowerCase();
                accordion.id = 'acc-' + safeId;
                accordion.className = `accordion-wrapper design-4`;
                
                const header = document.createElement('div');
                header.className = 'acc-header';
                header.innerHTML = `
                    <h2 class="acc-title">${deptName}</h2>
                    <i class="fa-solid fa-chevron-down acc-icon"></i>
                `;
                
                header.addEventListener('click', () => {
                    accordion.classList.toggle('open');
                });

                contentWrapper = document.createElement('div');
                contentWrapper.className = 'accordion-content';
                
                accordion.appendChild(header);
                accordion.appendChild(contentWrapper);
                grid.appendChild(accordion);

                // Group by Display Group (Chip) inside the accordion
                const subGroups = {};
                members.forEach(m => {
                    const sg = m.group || 'General';
                    if (!subGroups[sg]) subGroups[sg] = [];
                    subGroups[sg].push(m);
                });

                // Sort Groups using the Hierarchical Structure for this specific department
                let deptGroupsOrder = structure[deptName] || [];
                
                let sortedGroupNames = Object.keys(subGroups).sort((a, b) => {
                    const indexA = deptGroupsOrder.indexOf(a);
                    const indexB = deptGroupsOrder.indexOf(b);
                    
                    if (indexA !== -1 && indexB !== -1) return indexA - indexB;
                    if (indexA !== -1) return -1;
                    if (indexB !== -1) return 1;
                    
                    return a.localeCompare(b);
                });

                // Tetris Bin-Packing has been removed to respect the exact Master Sequence.
                // Groups will now stack vertically in the precise order specified in the admin menu.

                sortedGroupNames.forEach(sg => {
                    const groupMembers = subGroups[sg];
                    const sortedGroup = sortAndInjectSecretaries(groupMembers);

                    if (sg !== 'General' && sg !== '') {
                        const clusterWrap = document.createElement('div');
                        clusterWrap.className = 'hs-cluster';
                        
                        const chip = document.createElement('div');
                        chip.className = 'hs-cluster-chip';
                        chip.textContent = sg;
                        
                        if (deptGroupsOrder.indexOf(sg) === 0 || sg.toLowerCase().includes('leadership')) {
                            chip.style.background = '#fef3c7'; // Amber
                            chip.style.color = '#b45309';
                        }
                        
                        clusterWrap.appendChild(chip);

                        const cardsWrap = document.createElement('div');
                        cardsWrap.className = 'hs-cluster-cards';
                        sortedGroup.forEach(m => cardsWrap.appendChild(createCard(m)));
                        
                        clusterWrap.appendChild(cardsWrap);
                        contentWrapper.appendChild(clusterWrap);
                    } else {
                        // No chip, just cards
                        const clusterWrap = document.createElement('div');
                        clusterWrap.className = 'hs-cluster hs-cluster-fullrow';
                        const cardsWrap = document.createElement('div');
                        cardsWrap.className = 'hs-cluster-cards';
                        sortedGroup.forEach(m => cardsWrap.appendChild(createCard(m)));
                        clusterWrap.appendChild(cardsWrap);
                        contentWrapper.appendChild(clusterWrap);
                    }
                });
            }

            firstAccordion = false;
        });
        
        // Release the height freeze shortly after the browser paints the new DOM
        setTimeout(() => {
            grid.style.minHeight = '';
        }, 50);
    }

    // Master function for Sorting & Secretary Injection
    function sortAndInjectSecretaries(staffArray) {
        // 1. Sort by Tier, then by Sort Order, then Alphabetical
        let sorted = [...staffArray].sort((a, b) => {
            // Sort by Tier (e.g. "1. Executive" vs "3. Senior Management")
            const tierA = a.tier || '99';
            const tierB = b.tier || '99';
            if (tierA !== tierB) return tierA.localeCompare(tierB);
            
            // Sort by manual Sort Order
            // Use leadershipSort if on the Leadership tab (currentCampus === 'all')
            const sortField = currentCampus === 'all' ? 'leadershipSort' : 'sort';
            const sortA = a[sortField] !== undefined ? parseInt(a[sortField]) : 50;
            const sortB = b[sortField] !== undefined ? parseInt(b[sortField]) : 50;
            if (sortA !== sortB) return sortA - sortB;
            
            // Alphabetical fallback
            return (a.name || '').localeCompare(b.name || '');
        });

        // 2. The Secretary Injection 
        // Find anyone who has a 'Reports To'
        const finalArray = [];
        const secretaries = [];

        // Pull secretaries out of the main flow
        sorted.forEach(s => {
            if (s.reportsTo && s.reportsTo.trim() !== '') {
                secretaries.push(s);
            } else {
                finalArray.push(s);
            }
        });

        // Re-inject secretaries directly after their manager
        secretaries.forEach(sec => {
            const managerName = sec.reportsTo.toLowerCase().trim();
            // Find manager in the final array
            const managerIndex = finalArray.findIndex(m => (m.name || '').toLowerCase().includes(managerName));
            
            if (managerIndex !== -1) {
                // Insert immediately after manager
                finalArray.splice(managerIndex + 1, 0, sec);
            } else {
                // Manager not in this grid, just append to the end of the grid
                finalArray.push(sec);
            }
        });

        return finalArray;
    }

    // Event Listeners
    document.querySelectorAll('.opt-3-tab').forEach(btn => {
        btn.addEventListener('click', (e) => {
            // Prevent click if they are actually clicking the dropdown
            if (e.target.closest('.opt-3-dropdown-menu')) return;
            
            document.querySelectorAll('.opt-3-tab').forEach(b => b.classList.remove('active'));
            
            // The btn might be the <i> tag or the text node if not careful, use closest
            const actualBtn = e.target.closest('.opt-3-tab');
            if(actualBtn) {
                const clickedCampus = actualBtn.getAttribute('data-campus');
                if (currentCampus === clickedCampus) return; // Do not re-render if just opening dropdown
                
                actualBtn.classList.add('active');
                currentCampus = clickedCampus;
                renderDirectory(searchInput ? searchInput.value : '');
                
                // Scroll back to the top of the directory so they don't get lost if the new tab is much shorter
                setTimeout(() => {
                    const yOffset = -180; 
                    const y = grid.getBoundingClientRect().top + window.pageYOffset + yOffset;
                    window.scrollTo({ top: y, behavior: 'smooth' });
                }, 60);
            }
        });
    });

    // Jump to Department Logic
    document.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', (e) => {
            const targetDept = e.target.getAttribute('data-dept');
            const parentMenu = e.target.closest('.opt-3-dropdown-menu');
            const targetCampus = parentMenu.getAttribute('data-target-campus');

            const tabContainer = e.target.closest('.opt-3-tab-container');
            if (tabContainer) {
                // Permanently lock the menu closed
                tabContainer.classList.add('force-close');
                // The lock will be removed by the global mouseenter/touchstart listeners on the container
            }
            
            // 1. Switch to the correct campus if we aren't already on it
            if (currentCampus !== targetCampus) {
                document.querySelectorAll('.opt-3-tab').forEach(b => b.classList.remove('active'));
                const campusBtn = document.querySelector(`.opt-3-tab[data-campus="${targetCampus}"]`);
                if (campusBtn) campusBtn.classList.add('active');
                
                currentCampus = targetCampus;
                renderDirectory(searchInput ? searchInput.value : '');
            }
            
            // 2. Jump and open the accordion
            if (targetDept !== 'all') {
                const safeId = 'acc-' + targetDept.replace(/[^a-z0-9]/gi, '-').toLowerCase();
                const acc = document.getElementById(safeId);
                if (acc) {
                    // Close others (optional, but good UX)
                    document.querySelectorAll('.accordion-wrapper').forEach(a => a.classList.remove('open'));
                    acc.classList.add('open');
                    
                    // Smooth scroll
                    const yOffset = -220; 
                    const y = acc.getBoundingClientRect().top + window.pageYOffset + yOffset;
                    window.scrollTo({ top: y, behavior: 'smooth' });
                }
            }
        });
    });

    const searchDropdown = document.getElementById('hs-search-dropdown');
    
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const val = e.target.value;
            // Removed renderDirectory(val) from here so it doesn't filter while typing
            
            if (val.trim().length > 0) {
                generateSuggestions(val.trim());
            } else {
                if (searchDropdown) searchDropdown.classList.remove('active');
            }
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.opt-3-search')) {
                if (searchDropdown) searchDropdown.classList.remove('active');
            }
        });
    }

    function generateSuggestions(query) {
        if (!staffData || staffData.length === 0 || !searchDropdown) return;
        
        const q = query.toLowerCase();
        
        // Helper to highlight matching text
        const highlightText = (text) => {
            if (!text) return '';
            const regex = new RegExp(`(${query})`, 'gi');
            return text.replace(regex, '<span class="hs-highlight">$1</span>');
        };

        // Find all matching staff (name or title)
        const matches = staffData.filter(s => {
            const n = (s.name || '').toLowerCase();
            const t = (s.title || '').toLowerCase();
            return n.includes(q) || t.includes(q);
        });

        if (matches.length === 0) {
            searchDropdown.classList.remove('active');
            return;
        }

        // Group by Campus
        const grouped = {
            'Both Campuses': [],
            'Chaofah City': [],
            'Cherngtalay': []
        };

        matches.forEach(s => {
            const campus = (s.campus || 'Unknown').trim();
            if (campus === 'Both' || campus === 'Both Campuses') {
                grouped['Both Campuses'].push(s);
            } else if (campus.includes('Chaofah')) {
                grouped['Chaofah City'].push(s);
            } else if (campus.includes('Cherngtalay')) {
                grouped['Cherngtalay'].push(s);
            } else {
                grouped['Both Campuses'].push(s);
            }
        });

        // Generate HTML
        let html = '';
        const orderedCampuses = ['Both Campuses', 'Chaofah City', 'Cherngtalay'];
        
        orderedCampuses.forEach(campus => {
            if (grouped[campus].length > 0) {
                // Determine if the campus name itself matches the query for highlighting
                const displayCampus = campus.toLowerCase().includes(q) ? highlightText(campus) : campus;
                
                html += `<div class="hs-suggest-category">${displayCampus}</div>`;
                grouped[campus].forEach(staff => {
                    const cleanName = staff.name || '';
                    const displayName = highlightText(cleanName);
                    const displayTitle = highlightText(staff.title);
                    
                    html += `
                        <div class="hs-suggest-item" data-exact-name="${cleanName.replace(/"/g, '&quot;')}">
                            <div class="hs-suggest-name">${displayName}</div>
                            <div class="hs-suggest-title">${displayTitle}</div>
                        </div>
                    `;
                });
            }
        });

        searchDropdown.innerHTML = html;
        searchDropdown.classList.add('active');

        // Add click listeners to items
        const items = searchDropdown.querySelectorAll('.hs-suggest-item');
        items.forEach(item => {
            item.addEventListener('click', () => {
                const exactName = item.getAttribute('data-exact-name');
                searchDropdown.classList.remove('active');
                searchInput.value = ''; // clear search box after selection
                
                // 1. Find the full staff object
                const staffObj = staffData.find(s => {
                    const clean = s.name || '';
                    return clean === exactName;
                });
                
                if (!staffObj) return;

                // 2. Routing Logic
                let targetCampus = 'all'; // Default
                const tier = staffObj.tier || '';
                const camp = (staffObj.campus || '').trim();
                const isManager = tier.includes('1.') || tier.includes('2.') || tier.includes('7.');

                if (isManager) {
                    targetCampus = 'all';
                } else if (camp.includes('Chaofah')) {
                    targetCampus = 'Chaofah City';
                } else if (camp.includes('Cherngtalay')) {
                    targetCampus = 'Cherngtalay';
                } else if (camp === 'Both' || camp === 'Both Campuses') {
                    // Non-manager Both Campuses
                    if (currentCampus === 'Cherngtalay') {
                        targetCampus = 'Cherngtalay';
                    } else {
                        targetCampus = 'Chaofah City';
                    }
                }

                // 3. Switch Tab if necessary
                if (currentCampus !== targetCampus) {
                    const targetTab = document.querySelector(`.opt-3-tab[data-campus="${targetCampus}"]`);
                    if (targetTab) {
                        targetTab.click(); // This triggers renderDirectory synchronously
                    }
                } else {
                    renderDirectory(''); // Reset directory if it was filtered
                }

                // 4. Find Card, Open Accordion, Scroll, Highlight
                setTimeout(() => {
                    const allCards = document.querySelectorAll('.hs-staff-card');
                    let targetCard = null;
                    allCards.forEach(c => {
                        const nameEl = c.querySelector('.hs-staff-name');
                        if (nameEl && nameEl.textContent.trim() === exactName) {
                            targetCard = c;
                        }
                    });

                    if (targetCard) {
                        // Find accordion
                        const acc = targetCard.closest('.accordion-wrapper');
                        if (acc && !acc.classList.contains('open')) {
                            acc.classList.add('open');
                        }
                        
                        // Scroll
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        
                        // Highlight
                        targetCard.classList.add('hs-highlight-card');
                        setTimeout(() => {
                            targetCard.classList.remove('hs-highlight-card');
                        }, 5000);
                    }
                }, 50);

            });
        });
    }

    if (modalClose && modalOverlay) {
        modalClose.addEventListener('click', () => {
            modalOverlay.classList.remove('active');
        });
        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) modalOverlay.classList.remove('active');
        });
    }

    // Global listeners to re-enable hover when the user interacts with the tabs again
    document.querySelectorAll('.opt-3-tab-container').forEach(container => {
        container.addEventListener('mouseenter', () => container.classList.remove('force-close'));
        container.addEventListener('touchstart', () => container.classList.remove('force-close'), { passive: true });
    });

// Initial render
    renderDirectory();
};

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDirectory);
} else {
    initDirectory();
}

// ---------------------------------------------------------------------------
// STAFF SIDEBAR AVATAR BUBBLE SIZING LOGIC
// ---------------------------------------------------------------------------
document.addEventListener('DOMContentLoaded', function() {
    function hsUpdateAvatars() {
        document.querySelectorAll('.hs-staff-widget').forEach(function(widget) {
            var container = widget.querySelector('.hs-staff-avatars');
            if (!container) return;
            
            var width = container.clientWidth;
            if (width === 0) return;
            
            // Ideal width ~68px, Overlap: 16px.
            // N * 52 + 16 = width => N = (width - 16) / 52
            var n = Math.ceil((width - 16) / 52);
            if (n < 2) n = 2; // At least bubble + 1 avatar
            
            var avatars = container.querySelectorAll('img.hs-staff-avatar');
            var moreBubble = container.querySelector('.hs-staff-more');
            var totalStaff = parseInt(moreBubble.getAttribute('data-total') || '100', 10);
            
            var targetAvatars = n - 1; // 1 space is taken by the +X bubble
            var visibleCount = 0;
            
            avatars.forEach(function(img, idx) {
                if (idx < targetAvatars) {
                    img.style.display = '';
                    visibleCount++;
                } else {
                    img.style.display = 'none';
                }
            });
            
            var remaining = totalStaff - visibleCount;
            if (remaining > 0) {
                moreBubble.textContent = '+' + remaining;
            }
        });
    }
    
    hsUpdateAvatars();
    window.addEventListener('resize', hsUpdateAvatars);
});
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDirectory);
} else {
    initDirectory();
}
</script>

<script>
/**
 * =============================================================================
 * HEADSTART MOBILE NAVIGATION ENGINE
 * =============================================================================
 * PURPOSE: Handles all mobile-specific navigation logic, form teleportation, drawer states, and submenu toggles.
 * LOGIC: Attaches event listeners for mobile interactions and DOM node movement.
 * DEPENDENCIES: Mobile Menu DOM
 * =============================================================================
 */
document.addEventListener('DOMContentLoaded', function() {
        const root = document.getElementById('hs-mobile-nav-root');
        
        // MOUNT THE MENU
        if (root && !HeadStartUtils.isDiviBuilder()) {
            document.body.appendChild(root);
        }

        // LANGUAGE SWITCHER LAYOUT LOGIC
        const contactBtn = document.getElementById('hs-book-tour-btn');
        const langWrap = contactBtn ? contactBtn.previousElementSibling : null;
        
        if (langWrap && contactBtn) {
            // Check if there are any actual flags (images) or links rendered
            const hasFlags = langWrap.querySelectorAll('img, a, select').length > 0;
            const hasText = langWrap.textContent.trim().length > 0 && !langWrap.textContent.includes('[language_switcher]');
            
            if (!hasFlags && !hasText) {
                langWrap.style.display = 'none';
                contactBtn.classList.add('w-full', 'justify-center');
            }
        }

        

        // --- WIRE UP EXTERNAL .mobile-hamburger BUTTONS ---
        document.addEventListener('click', function(e) {
            const trigger = e.target.closest('.mobile-hamburger');
            if (trigger) {
                e.preventDefault();
                e.stopPropagation(); 
                
                if(!trigger.querySelector('.hs-custom-close-icon')) {
                    const xIcon = document.createElement('div');
                    xIcon.className = 'hs-custom-close-icon';
                    xIcon.innerHTML = `<svg style="width:28px; height:28px; fill:#003057;" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>`;
                    const inner = trigger.querySelector('.et_pb_module_inner') || trigger;
                    inner.style.position = 'relative'; 
                    inner.appendChild(xIcon);
                }

                hsToggleDrawer(trigger); 
            }
        });

        // --- CATCH SECONDARY FOOTER CTA ON MOBILE ---
        document.addEventListener('click', function(e) {
            const secBtn = e.target.closest('.hs-secondary-cta-button');
            // Check if it's the secondary button AND we are on mobile
            if (secBtn && window.innerWidth < 980) {
                e.preventDefault();
                e.stopPropagation();
                window.location.href = '/contact-us/';
            }
        });
    });

    function hsToggleDrawer(clickedTrigger) {
        const mask = document.getElementById('hs-drawer-mask');
        const content = document.getElementById('hs-drawer-content');
        const body = document.body;
        
        let headerHeight = 80; 
        
        if(clickedTrigger) {
            const section = clickedTrigger.closest('.et_pb_section');
            if(section) {
                headerHeight = section.getBoundingClientRect().bottom;
                if(headerHeight < 0) headerHeight = 0;
            }
        } else {
            const trigger = document.querySelector('.mobile-hamburger');
            if(trigger) {
                const section = trigger.closest('.et_pb_section');
                if(section) headerHeight = section.getBoundingClientRect().bottom;
            }
        }

        mask.style.top = headerHeight + 'px';
        mask.style.height = `calc(100vh - ${headerHeight}px)`;

        mask.classList.toggle('active');
        content.classList.toggle('active');
        const isOpen = content.classList.contains('active');

        document.querySelectorAll('.mobile-hamburger').forEach(trigger => {
            if(isOpen) {
                trigger.classList.add('hs-is-open');
            } else {
                trigger.classList.remove('hs-is-open');
            }
        });

        if (isOpen) {
            body.style.overflow = 'hidden';
        } else {
            body.style.overflow = '';
        }
    }

    

    function hsToggleSubmenu(id) {
        const el = document.getElementById(id);
        const icon = document.getElementById('hs-icon-' + id);
        if(!el) return;
        el.classList.toggle('open');
        if (el.classList.contains('open')) {
            if(icon) {
                if(id === 'resources') {
                    icon.innerHTML = '<path d="M19 13H5v-2h14v2z"/>';
                } else {
                    icon.style.transform = 'rotate(180deg)';
                }
            }
        } else {
            if(icon) {
                if(id === 'resources') {
                    icon.innerHTML = '<path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>';
                } else {
                    icon.style.transform = 'rotate(0deg)';
                }
            }
        }
    }

    function hsToggleSocial(id) {
        document.querySelectorAll('.hs-social-popup').forEach(el => {
            if(el.id !== id) el.classList.remove('active');
        });
        document.getElementById(id).classList.toggle('active');
    }

    window.addEventListener('click', function(e) {
        if (!e.target.closest('.hs-social-wrapper')) {
            document.querySelectorAll('.hs-social-popup').forEach(el => el.classList.remove('active'));
        }
    });

</script>

<script>
/**
 * =============================================================================
 * HEADSTART WEEKLY UPDATE ENGINE V2 (AJAX + DELEGATION)
 * =============================================================================
 * PURPOSE: Handles weekly updates via AJAX and event delegation.
 * LOGIC: Optimized for 10-year scale for large data fetching.
 * DEPENDENCIES: AJAX endpoints
 * =============================================================================
 */

(function() {
    function runWeeklyUpdateEngine() {
        const container = document.querySelector('.hs-weekly-update-v2');
        if (!container) return; // Not on this page

        // DOM Elements
        const cardsContainer = container.querySelector('.hs-update-cards-container');
        const controlsWrapper = container.querySelector('.hs-carousel-controls-wrapper');
        const prevBtn = container.querySelector('.hs-carousel-prev');
        const nextBtn = container.querySelector('.hs-carousel-next');
        const dotsContainer = container.querySelector('.hs-pagination-dots');
        const jumpFirstBtn = container.querySelector('.hs-jump-first');
        const yearFilter = container.querySelector('#hs-year-filter');

        // State
        const campus = container.getAttribute('data-campus') || 'all';
        let currentDisplayPage = 0;
        let cardsPerPage = 4;
        const chunkSize = 20; // Must match posts_per_page in PHP
        let totalPosts = 0;
        let totalDisplayPages = 0;
        let currentFilterYear = 'all';
        
        // Cache structure: filterCache['all'] = { cards: [], nextChunkToFetch: 1, fullyLoaded: false }
        let filterCache = {}; 
        let isFetching = false;
        
        // Configuration from localized script
        // Securely load config via Base64 payload instead of global variable
        let config = {};
        const configNode = document.getElementById('hs-weekly-update-config-v2');
        if (configNode && configNode.dataset.config) {
            try {
                config = JSON.parse(atob(configNode.dataset.config));
            } catch(e) {
                console.error("Failed to parse Weekly Update config:", e);
            }
        }

        function getPagesForFilter(year) {
            const cache = filterCache[year];
            if (!cache || !cache.cards) return [];
            
            const pages = [];
            let currentPageCards = [];
            let currentWeight = 0;
            const maxWeight = (window.innerWidth <= 767) ? 1 : 4;
            
            for (const card of cache.cards) {
                const cardWeight = (card.is_legacy || window.innerWidth <= 767) ? 1 : 2;
                if (currentWeight + cardWeight > maxWeight) {
                    if (currentPageCards.length > 0) pages.push(currentPageCards);
                    currentPageCards = [card];
                    currentWeight = cardWeight;
                } else {
                    currentPageCards.push(card);
                    currentWeight += cardWeight;
                }
            }
            if (currentPageCards.length > 0) pages.push(currentPageCards);
            return pages;
        }

        // Adjust cards per page based on responsive breakpoints
        function updateCardsPerPage() {
            if (totalPosts > 0) {
                const pages = getPagesForFilter(currentFilterYear);
                const cache = filterCache[currentFilterYear];
                if (cache && cache.fullyLoaded) {
                    totalDisplayPages = pages.length;
                } else {
                    const estPer = (window.innerWidth <= 767) ? 1 : 3;
                    totalDisplayPages = Math.max(pages.length, Math.ceil(totalPosts / estPer));
                }
                
                if (currentDisplayPage >= totalDisplayPages && totalDisplayPages > 0) {
                    currentDisplayPage = Math.max(0, totalDisplayPages - 1);
                }
            }
        }
        
        // Listen for resize to recalculate pagination
        let resizeTimer;
        let lastWidth = window.innerWidth;
        window.addEventListener('resize', () => {
            if (window.innerWidth === lastWidth) return;
            lastWidth = window.innerWidth;
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                if (totalPosts > 0) {
                    updateCardsPerPage();
                    renderCurrentDisplayPage(true);
                }
            }, 100);
        });
        
        updateCardsPerPage();

        // -----------------------------------------------------------
        // FETCH & CACHE LOGIC
        // -----------------------------------------------------------
        
        async function fetchNextChunkForFilter(year) {
            let cache = filterCache[year];
            if (!cache) {
                cache = filterCache[year] = { cards: [], nextChunkToFetch: 1, fullyLoaded: false };
            }
            
            if (cache.fullyLoaded) return true;

            const formData = new URLSearchParams();
            formData.append('action', 'hs_load_weekly_updates');
            formData.append('nonce', config.nonce);
            formData.append('campus', campus);
            formData.append('year', year);
            formData.append('page', cache.nextChunkToFetch);

            try {
                const response = await fetch(config.ajaxUrl, {
                    method: 'POST',
                    body: formData,
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                });
                const json = await response.json();
                
                if (json.success) {
                    const data = json.data;
                    cache.cards = cache.cards.concat(data.cards);
                    totalPosts = data.total_posts;
                    cache.nextChunkToFetch++;
                    
                    if (cache.cards.length >= totalPosts || data.cards.length < chunkSize) {
                        cache.fullyLoaded = true;
                    }
                    return true;
                }
                return false;
            } catch (error) {
                console.error("Weekly Update Fetch Error:", error);
                return false;
            }
        }

        // -----------------------------------------------------------
        // RENDER LOGIC
        // -----------------------------------------------------------
        
        // Builds the HTML string for a single card
        function buildCardHTML(card) {
            // Strip dates like ", 26 June 2026" or " - 26th June 2026" from the end of the title
            const cleanTitle = card.title.replace(/[,|-]\s*\d{1,2}(?:st|nd|rd|th)?\s+[A-Za-z]+\s+\d{4}\s*$/i, '').trim();

            if (card.is_legacy) {
                return `
                <article class="weekly-card is-legacy" data-year="${card.acad_year}">
                    <div class="weekly-card-img-wrapper">
                        <img src="${card.img_url}" class="weekly-card-img" alt="${cleanTitle}">
                        <div class="top-overlay"></div>
                        <div class="standard-overlay"></div>
                        <div class="legacy-meta-wrapper">
                            <div class="legacy-meta">
                                <span class="legacy-badge"><i class="fa-solid fa-box-archive"></i> Archive</span>
                                <span class="legacy-meta-text">${card.legacy_date} <span class="hs-hide-mobile">&bull;</span><br class="hs-show-mobile-only"> Academic Year ${card.acad_year}</span>
                            </div>
                        </div>
                    </div>
                    <div class="weekly-card-content">
                        <div class="hs-legacy-inner-flex">
                            <div class="hs-legacy-flex-1">
                                <h3 class="legacy-title">
                                    <a href="${card.link}" class="hs-card-link">${cleanTitle}</a>
                                </h3>
                            </div>
                            <span class="hs-card-arrow hs-hide-mobile"><i class="fa-solid fa-arrow-right"></i></span>
                        </div>
                    </div>
                </article>`;
            } else {
                let tagsHtml = '';
                if (card.tags && card.tags.length > 0) {
                    const maxTags = 3;
                    const visibleTags = card.tags.slice(0, maxTags);
                    const hiddenTags = card.tags.slice(maxTags);
                    
                    let chips = visibleTags.map(t => `<span class="hs-chip"><i class="fa-solid fa-check"></i>${t}</span>`).join('');
                    if (hiddenTags.length > 0) {
                        chips += `<span class="hs-chip hs-chip-more hs-show-more-tags" title="Show more tags" style="cursor: pointer; background: var(--hs-gold, #f0b323); color: #003057; font-weight: bold;">+${hiddenTags.length}</span>`;
                        // Render hidden tags
                        chips += hiddenTags.map(t => `<span class="hs-chip hs-hidden-tag" style="display:none;"><i class="fa-solid fa-check"></i>${t}</span>`).join('');
                        chips += `<span class="hs-chip hs-chip-more hs-show-less-tags hs-hidden-tag" title="Show fewer tags" style="cursor: pointer; background: var(--hs-gold, #f0b323); color: #003057; font-weight: bold; display: none;">-</span>`;
                    }
                    tagsHtml = `<div class="hs-chip-container" style="display: flex; flex-wrap: wrap; gap: 6px;">${chips}</div>`;
                }
                
                const weekBadge = card.week_num ? `<div class="hs-card-issue-badge">Week ${card.week_num}</div>` : '';
                const dateString = card.week_num ? `Week ${card.week_num} - ${card.display_date}` : card.display_date;
                const cleanExcerpt = card.excerpt.replace(/\s*\[(?:&hellip;|\.\.\.)\]\s*$/, '').replace(/\s*(?:&hellip;|\.\.\.)\s*$/, '');

                return `
                <article class="weekly-card" data-year="${card.acad_year}">
                    <div class="weekly-card-img-wrapper">
                        <img src="${card.img_url}" class="weekly-card-img" alt="${cleanTitle}">
                        <div class="standard-overlay"></div>
                        ${weekBadge}
                        <div class="hs-card-img-content" style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 1.25rem; z-index: 10;">
                            <h3 class="legacy-title" style="margin-bottom: 0;">
                                <a href="${card.link}" class="hs-card-link" style="color: #fff;">${cleanTitle}</a>
                            </h3>
                        </div>
                    </div>
                    <div class="weekly-card-content">
                        <div class="hs-card-header">
                            <div class="hs-card-header-text">
                                <div class="hs-card-meta-row">
                                    <div class="hs-card-meta-year">Academic Year ${card.acad_year}</div>
                                    <div class="hs-card-meta-date">${dateString}</div>
                                </div>
                            </div>
                            <div class="hs-card-cta-desktop hs-hide-mobile">
                                <a href="${card.link}" class="hs-btn-sm" style="position: relative; z-index: 10;">Read Update <i class="fa-solid fa-chevron-right"></i></a>
                            </div>
                        </div>
                        <div class="hs-blurb-wrapper">
                            <div class="hs-blurb">${cleanExcerpt}</div>
                        </div>
                        <div class="hs-card-footer" style="display: flex; justify-content: space-between; align-items: flex-end; gap: 16px;">
                            <div class="hs-card-footer-left" style="flex: 1; min-width: 0;">
                                <div class="hs-card-footer-title">In this issue:</div>
                                <div class="hs-card-footer-chips">
                                    ${tagsHtml}
                                </div>
                            </div>
                            <div class="hs-card-footer-right" style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0; min-height: 28px; justify-content: flex-end;">
                                <button class="hs-expand-blurb" style="display: none;"><i class="fa-solid fa-plus"></i></button>
                                <button class="hs-collapse-btn hs-collapse-desktop hs-hide-mobile" title="Collapse view"><i class="fa-solid fa-chevron-up"></i></button>
                            </div>
                        </div>
                    </div>
                    <button class="hs-collapse-btn hs-collapse-mobile hs-show-mobile-only" title="Collapse view"><i class="fa-solid fa-chevron-up"></i></button>
                </article>`;
            }
        }

        async function ensureDisplayPageLoaded(displayPageIdx) {
            let cache = filterCache[currentFilterYear];
            if (!cache) {
                cache = filterCache[currentFilterYear] = { cards: [], nextChunkToFetch: 1, fullyLoaded: false };
            }
            
            let pages = getPagesForFilter(currentFilterYear);
            const maxWeight = (window.innerWidth <= 767) ? 1 : 4;
            
            function getPageWeight(pageArray) {
                return pageArray ? pageArray.reduce((s, c) => s + ((c.is_legacy || window.innerWidth <= 767) ? 1 : 2), 0) : 0;
            }
            
            // Loop fetching if the requested page is missing or incomplete, AND we have more to fetch
            while ((!pages[displayPageIdx] || getPageWeight(pages[displayPageIdx]) < maxWeight) && !cache.fullyLoaded) {
                isFetching = true;
                
                // Show skeletons while fetching
                let skeletons = '';
                for(let i=0; i < (window.innerWidth <= 767 ? 1 : 4); i++) {
                    skeletons += `
                    <article class="weekly-card is-legacy hs-skeleton-card" style="background: rgba(0, 48, 87, 0.05); border: 1px solid #e0e0e0;">
                        <div class="weekly-card-img-wrapper" style="display: flex; align-items: center; justify-content: center; position: absolute; inset: 0;">
                            <i class="fa-solid fa-spinner fa-spin" style="font-size: 2rem; color: var(--hs-blue, #0077c8); opacity: 0.5;"></i>
                        </div>
                        <div class="weekly-card-content" style="opacity: 0.6; z-index: 1;">
                            <div class="hs-legacy-inner-flex">
                                <div class="hs-legacy-flex-1">
                                    <div style="height: 14px; background: #e0e0e0; width: 40%; margin-bottom: 12px; border-radius: 4px;"></div>
                                    <div style="height: 24px; background: #e0e0e0; width: 70%; border-radius: 4px;"></div>
                                </div>
                            </div>
                        </div>
                    </article>`;
                }
                cardsContainer.innerHTML = skeletons;
                
                const success = await fetchNextChunkForFilter(currentFilterYear);
                isFetching = false;
                if (!success) {
                    cardsContainer.innerHTML = '<p class="hs-no-posts">Failed to load updates. Please try again.</p>';
                    return null;
                }
                pages = getPagesForFilter(currentFilterYear);
            }
            
            updateCardsPerPage();
            return pages;
        }

        async function renderCurrentDisplayPage(preventScroll = false) {
            if (isFetching) return;
            
            const pages = await ensureDisplayPageLoaded(currentDisplayPage);
            if (!pages) return; // Error occurred

            const cardsToDisplay = pages[currentDisplayPage] || [];

            if (cardsToDisplay.length === 0 && totalPosts === 0) {
                cardsContainer.innerHTML = '<p class="hs-no-posts">No weekly updates found.</p>';
                controlsWrapper.style.display = 'none';
                return;
            }

            // Record scroll target BEFORE mutating DOM to avoid layout shift issues
            let scrollTarget = null;
            if (!preventScroll && (currentDisplayPage > 0 || currentFilterYear !== 'all')) {
                const rect = container.getBoundingClientRect();
                scrollTarget = window.pageYOffset + rect.top - 100;
            }

            // Lock container height temporarily to prevent violent scroll jumps during DOM swap
            const prevHeight = cardsContainer.offsetHeight;
            if (prevHeight > 0) {
                cardsContainer.style.minHeight = prevHeight + 'px';
            }

            // Build HTML efficiently in memory
            let htmlString = '';
            cardsToDisplay.forEach(card => {
                htmlString += buildCardHTML(card);
            });

            // Write to DOM exactly once (prevents thrashing)
            cardsContainer.innerHTML = htmlString;
            
            // Check for blurbs that need 'Read more' button
            const domCards = cardsContainer.querySelectorAll('.weekly-card:not(.is-legacy)');
            domCards.forEach(card => {
                const blurb = card.querySelector('.hs-blurb');
                const wrapper = card.querySelector('.hs-blurb-wrapper');
                const btn = card.querySelector('.hs-expand-blurb');
                if (blurb && btn && wrapper) {
                    // Show if blurb line-clamp overflows (mobile) OR wrapper box overflows (desktop flex hidden)
                    if (blurb.scrollHeight > blurb.clientHeight || wrapper.scrollHeight > wrapper.clientHeight) {
                        btn.style.display = 'inline-flex';
                        card.classList.add('is-overflowing');
                    }
                }
            });

            controlsWrapper.style.display = 'flex';
            updateControls();
            
            // Scroll to top of container smoothly if needed
            if (scrollTarget !== null) {
                window.scrollTo({ top: scrollTarget, behavior: 'smooth' });
            }

            // Release the height lock after rendering
            setTimeout(() => {
                cardsContainer.style.minHeight = '';
            }, 100);
        }

        // -----------------------------------------------------------
        // PAGINATION CONTROLS
        // -----------------------------------------------------------
        function updateControls() {
            const pages = getPagesForFilter(currentFilterYear);
            const cache = filterCache[currentFilterYear];
            
            prevBtn.disabled = (currentDisplayPage === 0);
            
            // Next button is only definitively disabled if we are on the last rendered page AND no more cards exist
            const isLastKnownPage = (currentDisplayPage >= pages.length - 1);
            if (isLastKnownPage && cache && cache.fullyLoaded) {
                nextBtn.disabled = true;
            } else {
                nextBtn.disabled = false;
            }
            
            // Render Dynamic 5-Dot Visual Indicator (No Numbers)
            const numDots = Math.min(5, totalDisplayPages);
            let activeDotIndex = 0;
            
            if (totalDisplayPages <= 5) {
                activeDotIndex = currentDisplayPage;
            } else {
                if (currentDisplayPage === 0) {
                    activeDotIndex = 0;
                } else if (currentDisplayPage === 1) {
                    activeDotIndex = 1;
                } else if (currentDisplayPage === totalDisplayPages - 2) {
                    activeDotIndex = 3;
                } else if (currentDisplayPage === totalDisplayPages - 1) {
                    activeDotIndex = 4;
                } else {
                    activeDotIndex = 2; // Stay in middle for all intermediate pages
                }
            }

            let dotsHtml = '';
            for (let i = 0; i < numDots; i++) {
                const isActive = (i === activeDotIndex) ? 'active' : '';
                // Dots are strictly visual indicators now (no numbers), so we don't attach data-page jump attributes
                dotsHtml += `<span class="hs-dot ${isActive}"></span>`;
            }
            dotsContainer.innerHTML = dotsHtml;
        }

        // -----------------------------------------------------------
        // EVENT DELEGATION
        // -----------------------------------------------------------
        
        // Handle clicks on cards safely without attaching listeners in loops
        cardsContainer.addEventListener('click', (e) => {
            const moreTagsBtn = e.target.closest('.hs-show-more-tags');
            if (moreTagsBtn) {
                const container = moreTagsBtn.closest('.hs-chip-container');
                if (container) {
                    container.querySelectorAll('.hs-hidden-tag').forEach(tag => tag.style.display = 'inline-flex');
                    moreTagsBtn.style.display = 'none';
                }
                return;
            }

            const lessTagsBtn = e.target.closest('.hs-show-less-tags');
            if (lessTagsBtn) {
                const container = lessTagsBtn.closest('.hs-chip-container');
                if (container) {
                    container.querySelectorAll('.hs-hidden-tag').forEach(tag => tag.style.display = 'none');
                    const moreBtn = container.querySelector('.hs-show-more-tags');
                    if (moreBtn) moreBtn.style.display = 'inline-flex';
                }
                return;
            }

            const expandBtn = e.target.closest('.hs-expand-blurb');
            if (expandBtn) {
                const card = expandBtn.closest('.weekly-card');
                if (card) {
                    card.classList.add('expanded');
                    expandBtn.style.display = 'none';
                }
                return;
            }
            
            // Collapse
            const collapseBtn = e.target.closest('.hs-collapse-btn');
            if (collapseBtn) {
                const card = collapseBtn.closest('.weekly-card');
                if (card) {
                    card.classList.remove('expanded');
                    const exp = card.querySelector('.hs-expand-blurb');
                    if (exp) exp.style.display = 'inline-block';
                    
                    // Smooth scroll back to top of the card
                    const yOffset = -220; 
                    const y = card.getBoundingClientRect().top + window.pageYOffset + yOffset;
                    window.scrollTo({ top: y, behavior: 'smooth' });
                }
                return;
            }
        });

        // Pagination Clicks
        prevBtn.addEventListener('click', () => {
            if (currentDisplayPage > 0 && !isFetching) {
                currentDisplayPage--;
                renderCurrentDisplayPage();
            }
        });

        nextBtn.addEventListener('click', () => {
            if (currentDisplayPage < totalDisplayPages - 1 && !isFetching) {
                currentDisplayPage++;
                renderCurrentDisplayPage();
            }
        });

        // Dots are strictly visual now (no numbers), so clicking them does nothing.
        // (Use Next/Prev buttons to navigate)

        jumpFirstBtn.addEventListener('click', () => {
            if (currentFilterYear !== 'all' || currentDisplayPage !== 0) {
                currentFilterYear = 'all';
                currentDisplayPage = 0;
                if (yearFilter) yearFilter.value = 'all';
                renderCurrentDisplayPage();
            }
        });

        // Year Filter with basic Debounce
        let filterTimeout;
        if (yearFilter) {
            yearFilter.addEventListener('change', (e) => {
                clearTimeout(filterTimeout);
                filterTimeout = setTimeout(() => {
                    currentFilterYear = e.target.value;
                    currentDisplayPage = 0; // Reset to page 1 of new filter
                    renderCurrentDisplayPage();
                }, 300); // 300ms debounce
            });
        }

        // INITIALIZE
        renderCurrentDisplayPage();
    }

    // Run when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runWeeklyUpdateEngine);
    } else {
        runWeeklyUpdateEngine();
    }
})();
</script>

<script>
/**
 * ============================================================================
 * HEADSTART WEEKLY UPDATE & POST JS LOGIC (V5)
 * ============================================================================
 * This script handles the interactive elements for both Weekly Updates and 
 * individual WordPress Posts.
 * 
 * 1. DOM Cleanup: Converts erratic `<br>` tags inside Gutenberg lists into 
 *    controlled CSS spacer blocks.
 * 2. Magnific Popup (Lightbox): Initializes the gallery slider on images. 
 *    - Uses a robust initialization function that waits for Divi to load the 
 *      Lightbox library asynchronously.
 *    - Scoped to `.hs-weekly-article` so it functions perfectly on both 
 *      Weekly Updates and single Posts.
 *    - Includes an AJAX MutationObserver to automatically re-bind the lightbox 
 *      when new posts are loaded dynamically (e.g., via archive pagination).
 *    - Mirrors the "Mosaic Gallery" design with embedded titles and captions.
 */

jQuery(document).ready(function($) {
    const wrapperSelector = '.hs-post-content-sandbox';
    const wrapper = document.querySelector(wrapperSelector);

    if (wrapper && !wrapper.dataset.hsWeeklyInit) {
        wrapper.dataset.hsWeeklyInit = '1';

        // 1. Fix erratic <br> spacing inside lists by converting them to spacer blocks
        const listBrs = Array.from(wrapper.querySelectorAll('li br'));
        listBrs.forEach(br => {
            const spacer = document.createElement('div');
            spacer.className = 'hs-br-spacer';
            br.parentNode.replaceChild(spacer, br);
        });

        // (Removed the DOM manipulation for .hs-section-card and .hs-story-divider, 
        //  since they are now hardcoded into the HTML payload)
    }

    /**
     * INITIALIZE MAGNIFIC POPUP (Robust Divi-waiting version)
     * Scoped to .hs-weekly-article so it works on both Weekly Updates and Single Posts
     */
    function initWeeklyLightboxes() {
        // Wait for Divi's Magnific Popup library to load
        if (typeof jQuery === 'undefined' || !jQuery.fn.magnificPopup) {
            setTimeout(initWeeklyLightboxes, 100);
            return;
        }

        var $ = jQuery;
        
        // Target the article wrapper to group ALL images in the post/story into one continuous gallery slider
        $('.hs-weekly-article, .weekly-card, .hs-gallery-grid').each(function() {
            if ($(this).hasClass('hs-lightbox-initialized')) return;
            $(this).addClass('hs-lightbox-initialized');

            $(this).magnificPopup({
                delegate: 'a.hs-gallery-link',
                type: 'image',
                gallery: { 
                    enabled: true, 
                    navigateByImgClick: true, 
                    preload: [1,2] 
                }, 
                mainClass: 'mfp-fade', 
                closeBtnInside: false,
                closeMarkup: '<div title="Close (Esc)" class="mfp-close hs-modal-close hs-shared-close"><span class="hs-modal-close-text">CLOSE</span><span class="hs-modal-close-icon">&times;</span></div>',
                image: {
                    // Force no titles or captions to appear in the popup
                    titleSrc: function(item) {
                        return ''; 
                    }
                }
            });

            // Prevent default link behavior explicitly just in case
            $(this).find('a.hs-gallery-link').on('click', function(e) {
                e.preventDefault();
            });
        });
    }
    
    // Kick off the initializer
    initWeeklyLightboxes();

    // Re-run when new elements are added to the DOM (e.g. AJAX pagination on the archive page)
    const observer = new MutationObserver(function(mutations) {
        let shouldInit = false;
        mutations.forEach(function(mutation) {
            if (mutation.addedNodes.length > 0) shouldInit = true;
        });
        if (shouldInit) initWeeklyLightboxes();
    });
    
    observer.observe(document.body, { childList: true, subtree: true });







});
</script>

<script>
/**
 * =============================================================================
 * HEADSTART HYBRID TAB ENGINE V2
 * =============================================================================
 * PURPOSE: Desktop nested sidebar, mobile dropdown, and table auto-labeling.
 * LOGIC: Vanilla JS engine (Divi 5 compatible) managing dropdown states, accordion height transitions, tab panel routing, and dynamic data-label injection for mobile card-stack table views.
 * DEPENDENCIES: Divi DOM
 * =============================================================================
 */

document.addEventListener('DOMContentLoaded', () => {

    /* --- Multilingual Logic --- */
    const langBtns = document.querySelectorAll('.lang-switch-btn');
    if (langBtns.length > 0) {
        langBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                langBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                const targetLang = btn.getAttribute('data-lang');
                const allLangNodes = document.querySelectorAll('[data-lang]:not(.lang-switch-btn)');
                
                allLangNodes.forEach(node => {
                    if (node.getAttribute('data-lang') === targetLang) {
                        node.classList.remove('hs-lang-hidden');
                    } else {
                        node.classList.add('hs-lang-hidden');
                    }
                });
            });
        });
    }
    /* -------------------------- */


    const tabContainers = document.querySelectorAll('.hs-hybrid-tabs');
    
    tabContainers.forEach(container => {
        
        /* --- DOM ELEMENTS --- */

        const trigger = container.querySelector('.hs-mobile-dropdown-trigger');
        
        let triggerText = null;
        if (trigger) {
            triggerText = trigger.querySelector('.hs-active-text') || trigger.querySelector('span');
        }

        const navWrapper = container.querySelector('.hs-tab-nav-wrapper');
        const tabList = container.querySelector('.hs-tab-list');
        const navGroups = container.querySelectorAll('.hs-nav-group');
        const tabs = container.querySelectorAll('.hs-tab-btn');
        const panels = container.querySelectorAll('.hs-tab-panel');
        
        /* --- MOBILE DROPDOWN --- */

        /**
         * Handles the mobile dropdown trigger state and automatically recalculates 
         * nested accordion heights if the dropdown is opened.
         */
        if (trigger && tabList) {
            trigger.addEventListener('click', (e) => {
                e.preventDefault();
                trigger.classList.toggle('dropdown-open');
                tabList.classList.toggle('dropdown-open');
                
                let parentRow = container.closest('.et_pb_row');
                let parentSection = container.closest('.et_pb_section');
                
                if (tabList.classList.contains('dropdown-open')) {
                    if (parentRow) parentRow.style.setProperty('z-index', '9999', 'important');
                    if (parentSection) parentSection.style.setProperty('z-index', '9999', 'important');
                    container.style.setProperty('z-index', '9999', 'important');

                    setTimeout(() => {
                        navGroups.forEach(group => {
                            if (group.classList.contains('open')) {
                                const content = group.querySelector('.hs-nav-sub-items');
                                const inner = group.querySelector('.hs-nav-sub-items-inner');
                                if (content && inner) {
                                    content.style.maxHeight = inner.offsetHeight + 'px';
                                }
                            }
                        });
                    }, 50);
                } else {
                    if (parentRow) parentRow.style.removeProperty('z-index');
                    if (parentSection) parentSection.style.removeProperty('z-index');
                    container.style.removeProperty('z-index');
                }
            });
            
            document.addEventListener('click', (e) => {
                if (!container.contains(e.target) && trigger.classList.contains('dropdown-open')) {
                    trigger.classList.remove('dropdown-open');
                    tabList.classList.remove('dropdown-open');
                    
                    let parentRow = container.closest('.et_pb_row');
                    let parentSection = container.closest('.et_pb_section');
                    if (parentRow) parentRow.style.removeProperty('z-index');
                    if (parentSection) parentSection.style.removeProperty('z-index');
                    container.style.removeProperty('z-index');
                }
            });
        }

        /* --- NESTED ACCORDION --- */

        /**
         * Manages the desktop sidebar and mobile dropdown accordion states, ensuring 
         * smooth max-height transitions and mutually exclusive open states.
         */
        navGroups.forEach(group => {
            const groupToggle = group.querySelector('.hs-nav-group-toggle');
            const content = group.querySelector('.hs-nav-sub-items');
            const inner = group.querySelector('.hs-nav-sub-items-inner');

            if (!groupToggle || !content || !inner) return;

            if (group.classList.contains('open')) {
                content.style.maxHeight = inner.offsetHeight + 'px';
            }

            groupToggle.addEventListener('click', (e) => {
                e.preventDefault();
                const isOpen = group.classList.contains('open');

                navGroups.forEach(otherGroup => {
                    if (otherGroup !== group && otherGroup.classList.contains('open')) {
                        otherGroup.classList.remove('open');
                        otherGroup.querySelector('.hs-nav-sub-items').style.maxHeight = null;
                    }
                });

                if (isOpen) {
                    group.classList.remove('open');
                    content.style.maxHeight = null;
                } else {
                    group.classList.add('open');
                    content.style.maxHeight = inner.offsetHeight + 'px';
                }
            });
        });

        window.addEventListener('resize', () => {
            navGroups.forEach(group => {
                if (group.classList.contains('open')) {
                    const content = group.querySelector('.hs-nav-sub-items');
                    const inner = group.querySelector('.hs-nav-sub-items-inner');
                    if(content && inner) {
                        content.style.maxHeight = inner.offsetHeight + 'px';
                    }
                }
            });
        });

        /* --- TAB SWITCHING & ROUTING --- */

        /**
         * Routes click events to the appropriate tab panel, updates the mobile 
         * trigger text, closes the dropdown, and smooth-scrolls to the content.
         */
        tabs.forEach(tab => {
            tab.addEventListener('click', (e) => {
                e.preventDefault();
                
                tabs.forEach(t => t.classList.remove('active'));
                panels.forEach(p => p.classList.remove('active'));
                
                tab.classList.add('active');
                
                const targetId = tab.getAttribute('data-target');
                const targetPanel = container.querySelector('#' + targetId);
                if (targetPanel) {
                    targetPanel.classList.add('active');
                }
                
                if (triggerText && trigger && tabList) {
                    
                    if (triggerText.classList.contains('hs-active-text')) {
                        triggerText.textContent = tab.textContent;
                    } else {
                        triggerText.innerHTML = tab.textContent;
                    }
                    
                    trigger.classList.remove('dropdown-open');
                    tabList.classList.remove('dropdown-open');
                    
                    let parentRow = container.closest('.et_pb_row');
                    let parentSection = container.closest('.et_pb_section');
                    if (parentRow) parentRow.style.removeProperty('z-index');
                    if (parentSection) parentSection.style.removeProperty('z-index');
                    container.style.removeProperty('z-index');
                    
                    if (window.innerWidth <= 768) {
                        // Dynamically calculate the top bar height
                        const topBar = document.querySelector('.mobile-menu-section');
                        const topBarHeight = topBar ? topBar.offsetHeight : 0;
                        
                        // Grab the height of the tab trigger itself so the panel clears it
                        const triggerHeight = trigger.offsetHeight || 0;
                        
                        window.scrollTo({
                            top: container.getBoundingClientRect().top + window.scrollY - (topBarHeight + triggerHeight),
                            behavior: 'smooth'
                        });
                    }
                }
            });
        });

        /* --- MOBILE TABLE FORMATTER --- */

        /**
         * Dynamically reads table headers and assigns them to 'data-label' attributes 
         * on table cells to enable responsive card-stack CSS layouts on mobile views.
         */
        const tables = container.querySelectorAll('.hs-standard-table:not(.hs-table-scroll)');
        tables.forEach(table => {
            const headers = Array.from(table.querySelectorAll('thead th')).map(th => th.textContent.trim());
            const rows = table.querySelectorAll('tbody tr');
            
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                cells.forEach((cell, index) => {
                    if (headers[index]) {
                        cell.setAttribute('data-label', headers[index]);
                    }
                });
            });
        });
    });

    /* ==========================================================================
       [GLOBAL COMPONENT: HORIZONTAL SCROLL TABLES]
       ========================================================================== */
    
    /**
     * Initializes horizontal scroll tables (standalone and inside tabs)
     * Adds the '.is-visible' class to '.hs-scroll-arrow-overlay' when 
     * the table is scrollable, and hides it when scrolled to the right end.
     */
    function initScrollableTables() {
        const scrollContainers = document.querySelectorAll('.hs-table-container-relative');
        
        scrollContainers.forEach(container => {
            const scrollWrapper = container.querySelector('.hs-table-wrapper-scroll');
            const overlay = container.querySelector('.hs-scroll-arrow-overlay');
            
            if (!scrollWrapper || !overlay) return;
            
            const checkScroll = () => {
                // Check if scrollable
                const isScrollable = scrollWrapper.scrollWidth > scrollWrapper.clientWidth;
                // Check if scrolled to the end (allow 2px margin for rounding)
                const isAtEnd = Math.abs(scrollWrapper.scrollWidth - scrollWrapper.clientWidth - scrollWrapper.scrollLeft) <= 2;
                
                if (isScrollable && !isAtEnd) {
                    overlay.classList.add('is-visible');
                } else {
                    overlay.classList.remove('is-visible');
                }
            };
            
            // Initial check
            checkScroll();
            
            // Listen for scroll and resize (Debounced for performance)
            const debouncedCheck = HeadStartUtils.debounce(checkScroll, 15);
            scrollWrapper.addEventListener('scroll', debouncedCheck, { passive: true });
            window.addEventListener('resize', debouncedCheck, { passive: true });
        });
    }

    // Initialize after a slight delay to ensure fonts/layout have settled
    setTimeout(initScrollableTables, 100);
});

document.addEventListener("DOMContentLoaded", function() {
    function initAlumniGallery() {
        if (typeof jQuery === "undefined" || !jQuery.fn.magnificPopup) {
            setTimeout(initAlumniGallery, 100);
            return;
        }
        var $ = jQuery;
        $(".hs-tab-panel").each(function() {
            if ($(this).find("a.hs-gallery-link").length > 0) {
                // Unbind any previous magnific popup on these links to prevent conflict
                $(this).find("a.hs-gallery-link").off("click.magnificPopup");
                
                $(this).magnificPopup({
                    delegate: "a.hs-gallery-link",
                    type: "image",
                    gallery: { enabled: true, navigateByImgClick: true },
                    mainClass: "mfp-fade",
                    closeBtnInside: false,
                    closeMarkup: "<div title=\"Close (Esc)\" class=\"mfp-close hs-modal-close hs-shared-close\"><span class=\"hs-modal-close-text\">CLOSE</span><span class=\"hs-modal-close-icon\">&times;</span></div>",
                    image: {
                        titleSrc: function(item) {
                            return ""; 
                        }
                    }
                });
            }
        });
    }
    initAlumniGallery();







});
</script>









<script>
/**
 * =============================================================================
 * NOTICEBOARD ENGINE (Campus Toggle + Local Preload)
 * =============================================================================
 * PURPOSE: Logic and execution for Noticeboard AJAX, Modals, and Campus Toggle
 * DEPENDENCIES: WordPress core, Divi
 * =============================================================================
 */
document.addEventListener('DOMContentLoaded', function() {
    const isDiviBuilder = window.location.href.includes('et_fb=1') || window.location.href.includes('et_pb_preview=true') || window.top !== window.self;
    if (isDiviBuilder) return;

    const wrapperEl = document.getElementById('hs-noticeboard-wrapper');
    if (!wrapperEl) return;

    let currentCampus = wrapperEl.getAttribute('data-campus') || 'all';

    function formatCampusName(slug) {
        if (slug === 'chaofah') return "Chaofah";
        if (slug === 'cherngtalay') return "Cherngtalay";
        if (slug === 'all') return "All Campuses";
        return slug.toUpperCase();
    }

    function updateChipName() {
        const chip = document.getElementById('hs-campus-chip');
        if (chip) {
            chip.innerText = formatCampusName(currentCampus);
        }
    }
    
    updateChipName();

    window.hsToggleCampus = function() {
        if (currentCampus === 'chaofah') {
            currentCampus = 'cherngtalay';
        } else if (currentCampus === 'cherngtalay') {
            currentCampus = 'chaofah';
        } else {
            currentCampus = 'chaofah'; // default if all or unknown
        }
        
        wrapperEl.setAttribute('data-campus', currentCampus);
        updateChipName();
        fetchNotices();
    }

    const modalEl = document.getElementById('hs-notice-modal');
    if (modalEl && modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
    }

    let currentPage = 1;
    const itemsPerPage = 3;


    function renderPinnedNotice() {
        const container = document.getElementById('hs-pinned-notice-container');
        if (!container) return;
        
        const pinned = window.hsNoticeData['pinned'];
        if (!pinned) {
            container.innerHTML = '';
            return;
        }
        
        container.innerHTML = `
            <div data-notice-modal="pinned" class="hs-pinned-card hs-noticeboard-trigger" onclick="window.openNoticeModal('pinned')">
                <div class="hs-pinned-card-glow"></div>
                <div class="hs-pinned-tag-wrapper">
                    <span class="hs-pinned-tag">
                        <i class="fas fa-thumbtack"></i>Pinned Notice
                    </span>
                </div>
                
                <h4 class="hs-pinned-heading">
                    ${pinned.title}
                </h4>
                
                <div class="hs-pinned-read-more">
                    Read More <i class="fas fa-arrow-right"></i>
                </div>
            </div>
        `;
    }

    function renderNoticeList() {
        const listContainer = document.getElementById('hs-older-notices-list');
        if (!listContainer) return;

        if(!window.hsStandardNoticeIDs || window.hsStandardNoticeIDs.length === 0) {
            listContainer.innerHTML = '<li style="padding: 1.5rem; text-align: center; color: #666; font-family: sans-serif; list-style: none;">No older notices found for this campus.</li>';
            renderPaginationControls();
            return;
        }
        
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const currentIDs = window.hsStandardNoticeIDs.slice(start, end);
        
        listContainer.innerHTML = '';
        
        currentIDs.forEach(id => {
            const notice = window.hsNoticeData[id];
            const importantTag = notice.isImportant ? '<span class="hs-important-tag"><i class="fas fa-exclamation-circle"></i>Important</span>' : '';

            const listItemHTML = `
                <li data-notice-modal="${id}" class="hs-older-notice-item hs-noticeboard-trigger" onclick="window.openNoticeModal('${id}')">
                    <div class="hs-older-notice-border">
                        ${importantTag ? `<div class="hs-important-tag-wrapper">${importantTag}</div>` : ''}
                        <h4 class="hs-older-notice-title">${notice.title}</h4>
                        <div class="hs-older-notice-read-more">
                            Read More <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </li>
            `;
            listContainer.innerHTML += listItemHTML;
        });

        renderPaginationControls();
    }

    function renderPaginationControls() {
        const pagContainer = document.getElementById('hs-notice-pagination');
        if (!pagContainer) return;
        
        if (!window.hsStandardNoticeIDs || window.hsStandardNoticeIDs.length === 0) {
            pagContainer.innerHTML = '';
            pagContainer.classList.add('hidden');
            pagContainer.style.display = 'none';
            return;
        }
        
        const totalPages = Math.ceil(window.hsStandardNoticeIDs.length / itemsPerPage);
        if (totalPages <= 1) {
            pagContainer.innerHTML = '';
            pagContainer.classList.add('hidden');
            pagContainer.style.display = 'none';
            return;
        }
        
        pagContainer.classList.remove('hidden');
        pagContainer.style.display = 'flex';
        
        let html = '';
        const prevDisabled = currentPage === 1 ? 'disabled' : '';
        const prevClass = currentPage === 1 ? 'hs-pagination-btn nav disabled' : 'hs-pagination-btn nav';
        
        html += `<button onclick="window.changeNoticePage(${currentPage - 1})" ${prevDisabled} class="${prevClass}">
                    <i class="fas fa-chevron-left"></i>
                 </button>`;
        
        for (let i = 1; i <= totalPages; i++) {
            if (i === currentPage) {
                html += `<button class="hs-pagination-btn active">${i}</button>`;
            } else {
                html += `<button onclick="window.changeNoticePage(${i})" class="hs-pagination-btn inactive">${i}</button>`;
            }
        }
        
        const nextDisabled = currentPage === totalPages ? 'disabled' : '';
        const nextClass = currentPage === totalPages ? 'hs-pagination-btn nav disabled' : 'hs-pagination-btn nav';
            
        html += `<button onclick="window.changeNoticePage(${currentPage + 1})" ${nextDisabled} class="${nextClass}">
                    <i class="fas fa-chevron-right"></i>
                 </button>`;
                 
        pagContainer.innerHTML = html;
    }

    window.changeNoticePage = function(pageNumber) {
        const totalPages = Math.ceil(window.hsStandardNoticeIDs.length / itemsPerPage);
        if (pageNumber >= 1 && pageNumber <= totalPages) {
            currentPage = pageNumber;
            renderNoticeList();
        }
    }

    window.openNoticeModal = function(id) {
        const notice = window.hsNoticeData[id];
        if(!notice) return;

        const hsModal = document.getElementById('hs-notice-modal');
        const hsModalContainer = document.getElementById('hs-modal-container');
        const imgContainer = document.getElementById('hs-modal-img-container');
        const img = document.getElementById('hs-modal-img');
        
        if(!hsModal || !hsModalContainer) return;

        document.getElementById('hs-modal-title').innerHTML = notice.title;
        document.getElementById('hs-modal-body').innerHTML = notice.body;
        
        if (notice.image) {
            imgContainer.classList.remove('hidden');
            imgContainer.style.display = 'block';
            img.src = notice.image;
        } else {
            imgContainer.classList.add('hidden');
            imgContainer.style.display = 'none';
        }
        
        hsModal.style.display = 'flex';
        hsModal.classList.remove('hidden');
        
        setTimeout(() => {
            hsModalContainer.classList.add('is-open');
        }, 10);
        
        document.body.style.overflow = 'hidden'; 
    }

    window.closeNoticeModal = function() {
        const hsModal = document.getElementById('hs-notice-modal');
        const hsModalContainer = document.getElementById('hs-modal-container');
        if(!hsModal || !hsModalContainer) return;

        hsModalContainer.classList.remove('is-open');
        
        setTimeout(() => {
            hsModal.style.display = 'none';
            hsModal.classList.add('hidden');
            document.body.style.overflow = ''; 
        }, 300);
    }

    document.addEventListener('keydown', (e) => {
        const hsModal = document.getElementById('hs-notice-modal');
        if (e.key === 'Escape' && hsModal && !hsModal.classList.contains('hidden')) {
            window.closeNoticeModal();
        }
    });

    function fetchNotices() {
        const loadingEl = document.getElementById('hs-noticeboard-loading');
        const listEl = document.getElementById('hs-older-notices-list');
        const pagContainer = document.getElementById('hs-notice-pagination');
        const pinnedContainer = document.getElementById('hs-pinned-notice-container');
        
        if (loadingEl) loadingEl.style.display = 'block';
        if (listEl) {
            listEl.style.display = 'none';
            listEl.innerHTML = '';
        }
        if (pagContainer) pagContainer.style.display = 'none';
        if (pinnedContainer) pinnedContainer.innerHTML = '';
        
        // Use preloaded JSON payload from PHP instead of AJAX
        if (window.hsNoticeDataPreload && window.hsNoticeDataPreload[currentCampus]) {
            const payload = window.hsNoticeDataPreload[currentCampus];
            window.hsNoticeData = payload.noticeData;
            window.hsStandardNoticeIDs = payload.standardIDs;
            
            if (loadingEl) loadingEl.style.display = 'none';
            if (listEl) {
                listEl.style.display = 'block';
                listEl.classList.remove('hidden');
            }
            
            currentPage = 1;
            renderPinnedNotice();
            renderNoticeList();
        } else {
            console.error('Noticeboard Preload Data Missing!');
            if (loadingEl) loadingEl.innerHTML = 'Error loading notices.';
        }
    }

    fetchNotices();

});
</script>


<script>
/**
 * =============================================================================
 * HEADSTART POSTS SLIDER (GLOBAL INITIALIZATION)
 * =============================================================================
 */
document.addEventListener('DOMContentLoaded', function() {
    function initHeadstartSliders() {
        if (typeof Swiper === 'undefined') {
            if (!document.getElementById('swiper-js-script')) {
                var script = document.createElement('script');
                script.id = 'swiper-js-script';
                script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
                document.head.appendChild(script);
                var link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
                document.head.appendChild(link);
            }
            setTimeout(initHeadstartSliders, 100);
            return;
        }

        var wrappers = document.querySelectorAll('.hs-shortcode-slider-wrapper');
        wrappers.forEach(function(rootContainer) {
            var sliderId = rootContainer.id;
            var container = rootContainer.querySelector('.swiper.hsPostSliderInit-' + sliderId);
            if (!container || container.classList.contains('hs-swiper-loaded')) return;

            var wrapper = container.querySelector('.swiper-wrapper');
            var filterSelect = rootContainer.querySelector('select.hs-slider-grid-filter');
            var display = rootContainer.getAttribute('data-display');
            var paged = 1;

            var slideNodes = container.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)');
            var slideCount = slideNodes.length;
            var shouldLoop = slideCount > 3;

            setTimeout(function() { 
                container.classList.add('hs-swiper-loaded');
                var loader = container.querySelector('.hs-slider-loader');
                if (loader) loader.style.display = 'none'; 
            }, 1000);

            var hsLoadMorePosts = function(swiperInstance) {
                if (display !== 'slider' || swiperInstance.hsIsLoading || swiperInstance.hsNoMorePosts) return;
                
                swiperInstance.hsIsLoading = true;
                swiperInstance.hsCurrentPage++;
                
                // INJECT SKELETON CARDS
                var skeletonHTML = '<div class="swiper-slide hs-skeleton-wrapper"><div class="hs-skeleton-card hs-slider-skeleton-card"></div></div>';
                var tempSkeletonDiv = document.createElement('div');
                tempSkeletonDiv.innerHTML = skeletonHTML + skeletonHTML + skeletonHTML;
                var skeletonsArray = Array.prototype.slice.call(tempSkeletonDiv.children);
                swiperInstance.appendSlide(skeletonsArray);
                swiperInstance.update();
                swiperInstance.slideNext();
                
                var data = new URLSearchParams();
                data.append('action', 'hs_load_slider_posts');
                data.append('page', swiperInstance.hsCurrentPage);
                data.append('count', rootContainer.getAttribute('data-count') || '15');
                
                var dept = filterSelect ? filterSelect.value : (rootContainer.getAttribute('data-dept') || '');
                data.append('department', dept);
                data.append('campus', rootContainer.getAttribute('data-campus') || '');
                data.append('enforce_context', rootContainer.getAttribute('data-enforce-context') || 'false');
                data.append('enforce_dept_context', rootContainer.getAttribute('data-enforce-dept-context') || 'false');
                data.append('exclude_recent_days', rootContainer.getAttribute('data-exclude-days') || '0');
                data.append('seed', rootContainer.getAttribute('data-seed') || '');
                data.append('ajax_cards_only', 'true');
                data.append('display', display);
                
                var hs_ajaxurl = '/wp-admin/admin-ajax.php';
                if (typeof ajaxurl !== 'undefined') hs_ajaxurl = ajaxurl;
                
                // ARTIFICIAL DELAY: 500ms delay so the user can visibly see the skeleton loading animation
                setTimeout(function() {
                    fetch(hs_ajaxurl, { method: 'POST', body: data })
                    .then(function(res) { return res.json(); })
                    .then(function(res) {
                        var currentSkeletons = swiperInstance.wrapperEl.querySelectorAll('.hs-skeleton-wrapper');
                    
                    if (res.success && res.data.html && res.data.html.trim() !== '' && res.data.html.indexOf('No posts found') === -1) {
                        var tempDiv = document.createElement('div');
                        tempDiv.innerHTML = res.data.html;
                        var slidesArray = Array.prototype.slice.call(tempDiv.children);
                        
                        // Bulletproof morph: replace skeletons with the first few real slides
                        // This prevents Swiper from jumping if the user is currently staring at a skeleton on mobile
                        var i = 0;
                        for (; i < currentSkeletons.length; i++) {
                            if (i < slidesArray.length) {
                                currentSkeletons[i].className = slidesArray[i].className;
                                currentSkeletons[i].innerHTML = slidesArray[i].innerHTML;
                            }
                        }
                        
                        // Remove any leftover skeletons (more skeletons than real slides) using Swiper API
                        if (slidesArray.length < currentSkeletons.length) {
                            var leftoverIndices = [];
                            for (var k = 0; k < swiperInstance.slides.length; k++) {
                                if (swiperInstance.slides[k].classList.contains('hs-skeleton-wrapper')) {
                                    leftoverIndices.push(k);
                                }
                            }
                            if (leftoverIndices.length > 0) {
                                swiperInstance.removeSlide(leftoverIndices);
                            }
                        }
                        
                        // Append the rest of the slides natively
                        var remainingSlides = slidesArray.slice(i);
                        if (remainingSlides.length > 0) {
                            swiperInstance.appendSlide(remainingSlides);
                        }
                        
                        swiperInstance.update();
                        hsEnforceDeptLinks();
                        swiperInstance.hsIsLoading = false;
                    } else {
                        // No more posts — slide back to last real card, THEN remove skeletons
                        var skeletonIndices = [];
                        for (var j = 0; j < swiperInstance.slides.length; j++) {
                            if (swiperInstance.slides[j].classList.contains('hs-skeleton-wrapper')) {
                                skeletonIndices.push(j);
                            }
                        }
                        // Slide to the last real card first (so user isn't staring at a skeleton when it vanishes)
                        var lastRealIndex = skeletonIndices.length > 0 ? skeletonIndices[0] - 1 : swiperInstance.slides.length - 1;
                        if (lastRealIndex >= 0) {
                            swiperInstance.slideTo(lastRealIndex, 300);
                        }
                        // After the transition completes, remove the skeletons
                        setTimeout(function() {
                            // Re-collect indices since they may have shifted
                            var freshIndices = [];
                            for (var k = 0; k < swiperInstance.slides.length; k++) {
                                if (swiperInstance.slides[k].classList.contains('hs-skeleton-wrapper')) {
                                    freshIndices.push(k);
                                }
                            }
                            if (freshIndices.length > 0) {
                                swiperInstance.removeSlide(freshIndices);
                            }
                        }, 400);
                        // No more posts! Just stop gracefully.
                        swiperInstance.hsNoMorePosts = true;
                        swiperInstance.hsIsLoading = false;
                        if (swiperInstance.autoplay && swiperInstance.autoplay.running) {
                            swiperInstance.autoplay.stop();
                        }
                    }
                }).catch(function(err) {
                    var skeletonIndices = [];
                    for (var j = 0; j < swiperInstance.slides.length; j++) {
                        if (swiperInstance.slides[j].classList.contains('hs-skeleton-wrapper')) {
                            skeletonIndices.push(j);
                        }
                    }
                    if (skeletonIndices.length > 0) {
                        var lastRealIndex = skeletonIndices[0] - 1;
                        if (lastRealIndex >= 0) {
                            swiperInstance.slideTo(lastRealIndex, 300);
                        }
                        setTimeout(function() {
                            var freshIndices = [];
                            for (var k = 0; k < swiperInstance.slides.length; k++) {
                                if (swiperInstance.slides[k].classList.contains('hs-skeleton-wrapper')) {
                                    freshIndices.push(k);
                                }
                            }
                            if (freshIndices.length > 0) {
                                swiperInstance.removeSlide(freshIndices);
                            }
                        }, 400);
                    }
                    swiperInstance.hsIsLoading = false;
                });
                }, 500); // End setTimeout
            };

            // BULLETPROOF EVENT DELEGATION FOR NAVIGATION ARROWS
            if (!rootContainer.dataset.hsNavDelegated) {
                rootContainer.dataset.hsNavDelegated = 'true';
                rootContainer.addEventListener('click', function(e) {
                    var nextBtn = e.target.closest('.hs-next, .hs-side-next, [class*="hs-slider-next"], .swiper-button-next');
                    var prevBtn = e.target.closest('.hs-prev, .hs-side-prev, [class*="hs-slider-prev"], .swiper-button-prev');
                    if (nextBtn || prevBtn) {
                        e.preventDefault();
                        var currentContainer = rootContainer.querySelector('.swiper.hsPostSliderInit-' + rootContainer.id);
                        if (currentContainer && currentContainer.hsSwiperInstance) {
                            
                            // Reset Swiper's autoplay timer so it doesn't jump immediately after a click
                            if (currentContainer.hsSwiperInstance.autoplay && currentContainer.hsSwiperInstance.autoplay.running) {
                                currentContainer.hsSwiperInstance.autoplay.stop();
                                currentContainer.hsSwiperInstance.autoplay.start();
                            }

                            if (nextBtn) {
                                currentContainer.hsSwiperInstance.slideNext();
                            } else {
                                currentContainer.hsSwiperInstance.slidePrev();
                            }
                        }
                    }
                });
            }

            try {
                container.hsSwiperInstance = new Swiper(container, {
                    on: {
                        init: function () {
                            container.classList.add('hs-swiper-loaded');
                            var loader = container.querySelector('.hs-slider-loader');
                            if (loader) loader.style.display = 'none';
                            this.hsCurrentPage = paged;
                            this.hsIsLoading = false;
                            
                            // Manually manage disabled states on init
                            var swp = this;
                            rootContainer.querySelectorAll('.hs-prev, .hs-side-prev').forEach(function(el) {
                                swp.isBeginning ? el.classList.add('swiper-button-disabled') : el.classList.remove('swiper-button-disabled');
                            });
                            rootContainer.querySelectorAll('.hs-next, .hs-side-next').forEach(function(el) {
                                swp.isEnd ? el.classList.add('swiper-button-disabled') : el.classList.remove('swiper-button-disabled');
                            });
                        },
                        reachEnd: function() {
                            hsLoadMorePosts(this);
                        },
                        slideChange: function() {
                            var swp = this;
                            
                            // Manually manage disabled states
                            rootContainer.querySelectorAll('.hs-prev, .hs-side-prev').forEach(function(el) {
                                swp.isBeginning ? el.classList.add('swiper-button-disabled') : el.classList.remove('swiper-button-disabled');
                            });
                            rootContainer.querySelectorAll('.hs-next, .hs-side-next').forEach(function(el) {
                                swp.isEnd ? el.classList.add('swiper-button-disabled') : el.classList.remove('swiper-button-disabled');
                            });

                            // Trigger background load if within 6 slides of the end to make it seamless
                            if (swp.slides.length - swp.activeIndex <= 6) {
                                hsLoadMorePosts(swp);
                            }
                        }
                    },
                    slidesPerView: 'auto', 
                    spaceBetween: 10,
                    centeredSlides: false,
                    loop: false,
                    autoplay: { delay: 4000, disableOnInteraction: true, pauseOnMouseEnter: true },
                    touchStartPreventDefault: false,
                    pagination: false,
                    breakpoints: {
                        640: { slidesPerView: 'auto', centeredSlides: false },
                        768: { slidesPerView: 'auto', centeredSlides: false, enabled: (display === 'slider') },
                        1024: { slidesPerView: 'auto', centeredSlides: false, enabled: (display === 'slider') },
                        1400: { slidesPerView: 'auto', centeredSlides: false, enabled: (display === 'slider') }
                    }
                });
            } catch (e) { console.error('Swiper instantiation error:', e); }

            // CLIENT-SIDE DEPARTMENT CONTEXT ENFORCEMENT
            // Stamps ?hs_dept= onto card links for department-specific sliders.
            // This is cache-proof: even if the server serves stale HTML, JS patches links on the fly.
            var hsDeptSlug = rootContainer.getAttribute('data-dept');
            var hsEnforceDeptLinks = function() {
                if (!hsDeptSlug || filterSelect) return; // Skip if no dept or if this is a filter slider
                rootContainer.querySelectorAll('a.hs-story-card').forEach(function(card) {
                    var href = card.getAttribute('href');
                    if (href && href.indexOf('hs_dept=') === -1) {
                        card.setAttribute('href', href + (href.indexOf('?') !== -1 ? '&' : '?') + 'hs_dept=' + encodeURIComponent(hsDeptSlug));
                    }
                });
            };
            hsEnforceDeptLinks(); // Run on initial load

            // CACHE-PROOF DEPARTMENT CONTEXT RELOAD
            // If the URL has ?hs_dept= but the server-rendered slider doesn't match
            // (because a page cache served stale HTML), force an AJAX reload with the correct department.
            var urlParams = new URLSearchParams(window.location.search);
            var urlDept = urlParams.get('hs_dept');
            if (urlDept && !filterSelect && hsDeptSlug !== urlDept) {
                // The URL says "foundation" but the slider was rendered without that filter — reload it
                rootContainer.setAttribute('data-dept', urlDept);
                hsDeptSlug = urlDept; // Update for hsEnforceDeptLinks

                var loader = container.querySelector('.hs-slider-loader');
                if (loader) loader.style.display = 'flex';
                container.classList.remove('hs-swiper-loaded');

                var reloadData = new URLSearchParams();
                reloadData.append('action', 'hs_load_slider_posts');
                reloadData.append('department', urlDept);
                reloadData.append('campus', rootContainer.getAttribute('data-campus') || '');
                reloadData.append('enforce_context', rootContainer.getAttribute('data-enforce-context') || 'false');
                reloadData.append('enforce_dept_context', 'true');
                reloadData.append('exclude_recent_days', rootContainer.getAttribute('data-exclude-days') || '0');
                reloadData.append('count', rootContainer.getAttribute('data-count') || '15');
                reloadData.append('seed', rootContainer.getAttribute('data-seed') || '');
                reloadData.append('ajax_cards_only', 'true');
                reloadData.append('display', display);

                var hs_ajaxurl = '/wp-admin/admin-ajax.php';
                if (typeof ajaxurl !== 'undefined') hs_ajaxurl = ajaxurl;

                fetch(hs_ajaxurl, { method: 'POST', body: reloadData })
                .then(function(res) { return res.json(); })
                .then(function(res) {
                    if (res.success && wrapper) {
                        if (container.hsSwiperInstance) {
                            container.hsSwiperInstance.destroy(true, true);
                            container.hsSwiperInstance = null;
                        }
                        container.className = 'swiper hsPostSliderInit-' + sliderId;
                        wrapper.className = 'swiper-wrapper';
                        wrapper.removeAttribute('style');
                        wrapper.innerHTML = res.data.html;
                        setTimeout(initHeadstartSliders, 50);
                    } else {
                        if (loader) loader.style.display = 'none';
                        container.classList.add('hs-swiper-loaded');
                    }
                }).catch(function(err) {
                    if (loader) loader.style.display = 'none';
                    container.classList.add('hs-swiper-loaded');
                });
            }

            if (filterSelect && !filterSelect.dataset.listenerAttached) {
                filterSelect.dataset.listenerAttached = 'true';
                filterSelect.addEventListener('change', function(e) {
                    var dept = this.value;
                    var campus = rootContainer.getAttribute('data-campus') || '';
                    var enforceContext = rootContainer.getAttribute('data-enforce-context') || 'false';
                    var enforceDeptContext = rootContainer.getAttribute('data-enforce-dept-context') || 'false';
                    var excludeDays = rootContainer.getAttribute('data-exclude-days') || '0';
                    var count = rootContainer.getAttribute('data-count') || '-1';
                    var title = rootContainer.getAttribute('data-title') || '';
                    var seed = rootContainer.getAttribute('data-seed') || '';
                    
                    var loader = container.querySelector('.hs-slider-loader');
                    if (loader) loader.style.display = 'flex';
                    container.classList.remove('hs-swiper-loaded');
                    
                    var data = new URLSearchParams();
                    data.append('action', 'hs_load_slider_posts');
                    data.append('department', dept);
                    data.append('campus', campus);
                    data.append('enforce_context', enforceContext);
                    data.append('enforce_dept_context', enforceDeptContext);
                    data.append('exclude_recent_days', excludeDays);
                    data.append('count', count);
                    data.append('title', title);
                    data.append('seed', seed);
                    data.append('ajax_cards_only', 'true');
                    data.append('display', display);
                    
                    var hs_ajaxurl = '/wp-admin/admin-ajax.php';
                    if (typeof ajaxurl !== 'undefined') hs_ajaxurl = ajaxurl;

                    fetch(hs_ajaxurl, { method: 'POST', body: data })
                    .then(function(res) { return res.json(); })
                    .then(function(res) {
                        if (res.success && wrapper) {
                            if (container.hsSwiperInstance) {
                                container.hsSwiperInstance.destroy(true, true);
                                container.hsSwiperInstance = null;
                            }
                            container.className = 'swiper hsPostSliderInit-' + sliderId;
                            wrapper.className = 'swiper-wrapper';
                            wrapper.removeAttribute('style');
                            wrapper.innerHTML = res.data.html;
                            setTimeout(initHeadstartSliders, 50);
                        } else {
                            if (loader) loader.style.display = 'none';
                            container.classList.add('hs-swiper-loaded');
                        }
                    }).catch(function(err) {
                        if (loader) loader.style.display = 'none';
                        container.classList.add('hs-swiper-loaded');
                    });
                });
            }
        });
    }

    setTimeout(initHeadstartSliders, 50);

    if (typeof jQuery !== 'undefined') {
        jQuery(document).ajaxComplete(function(event, xhr, settings) {
            if (settings.data && typeof settings.data === 'string' && settings.data.indexOf('et_pb_get_shortcode_preview') !== -1) {
                setTimeout(initHeadstartSliders, 500);
            }
        });
    }
});

// ==========================================
// [BESPOKE] PARENT FITNESS MODAL LOGIC
// ==========================================
window.openFitnessModal = function() {
    const modal = document.getElementById('hs-fitness-modal');
    const container = document.getElementById('hs-fitness-modal-container');
    if(!modal || !container) return;
    
    // Move modal to body to escape Divi's z-index trapping
    if (modal.parentNode !== document.body) {
        document.body.appendChild(modal);
    }
    
    modal.style.display = 'flex';
    void modal.offsetWidth;
    
    setTimeout(() => {
        container.classList.add('is-active');
    }, 10);
};

window.closeFitnessModal = function() {
    const modal = document.getElementById('hs-fitness-modal');
    const container = document.getElementById('hs-fitness-modal-container');
    if(!modal || !container) return;
    
    container.classList.remove('is-active');
    
    setTimeout(() => {
        modal.style.display = 'none';
    }, 300);
};

// ==========================================
// EVENTS CALENDAR SIDEBAR CAMPUS TOGGLE
// ==========================================
window.hsToggleEventsCampus = function() {
    const wrapper = document.getElementById('hs-events-sidebar-wrapper');
    const chip = document.getElementById('hs-events-campus-chip');
    if (!wrapper || !chip) return;
    
    let currentCampus = wrapper.getAttribute('data-active-campus');
    
    if (currentCampus === 'chaofah') {
        currentCampus = 'cherngtalay';
    } else if (currentCampus === 'cherngtalay') {
        currentCampus = 'chaofah';
    } else {
        currentCampus = 'chaofah';
    }
    
    wrapper.setAttribute('data-active-campus', currentCampus);
    chip.innerText = currentCampus.toUpperCase();
};
