#!/usr/bin/env bash
# hs — HeadStart workflow CLI. Every key action (start, approve, commit, handover, merge,
# snapshot, deploy log) goes through here so it happens the same way every time.
# Run `tools/hs help`. Compatible with macOS bash 3.2.
set -eu
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "hs: run inside the HeadStart repo" >&2; exit 1; }
cd "$ROOT"
. "$ROOT/tools/lib.sh"
TPL="$ROOT/tools/templates"

# Every commit/merge hs makes is checked straight after (see hs_verify_commit in lib.sh).
git() {
  case "${1:-}" in
    commit|merge) command git "$@" || return $?; hs_verify_commit ;;
    *) command git "$@" ;;
  esac
}

usage() { cat <<'EOF'
HeadStart workflow — tools/hs <command>

  Gate 1  fetch-js                 (Mac Terminal) Download the live scripts listed in the Divi head export into Latest-Drop/js/
          snapshot                 Turn Site-Scripts/Latest-Drop/ into a dated read-only live backup (on main)
          drift                    Compare working files with the newest live backup
  Gate 2  start <feat|fix> <slug> ["Title"]   Open a task branch + work/<slug>/plan.md
          plan [--diff] [slug]     Open a plan for review (default: this task, or the newest open task); --diff = changes since last approval
          approve --via "<how>"    USER ONLY. Record approval of the current plan.md
  Gate 3  save -m "<type>(<scope>): <msg>" [-m ...]   Stage everything and commit (hooks enforce rules)
          sync                     Merge main into this task branch (new snapshots, latest workflow tools)
  Gate 4  lint [files...]          Lint changed PHP/JS (records receipts)
          receipt <files...>       Record externally-linted PHP (needs HS_EXTERNAL_LINT="<how>")
  Gate 5  uat --via "<how>"        USER ONLY. Record that UAT passed (or wasn't needed, and why)
  Gate 6  handover                 Build Site-Scripts/handover/<slug>-<date>/ (run twice: scaffold, then zip)
          handover --local-only "why"   For tasks that ship nothing to live: record that instead of a zip
          handover --accept-drift "why" Package even though live differs from main or the backup is old (recorded in DEV-NOTES)
          finish                   Merge the task into main and tag it
  Gate 7  deployed <slug> [--note "..."]   Log a confirmed live deploy (on main) and tag it
          publish [--done]         Bundle commits GitHub doesn't have yet into .hs-outbox/ (cloud push); --done after pushing
          status [--brief]         Where are we?
          setup                    Install git hooks + Claude Code hooks + repo settings (safe to re-run)
          learned                  Show your learning log: every snippet you have had
EOF
}

need_task() {
  hs_branch | grep -Eq "$HS_BRANCH_RE" || hs_die "No task open (on '$(hs_branch)'). Start one: tools/hs start feat <slug> \"Title\""
  [ -f "$(hs_workdir)/plan.md" ] || hs_die "Missing $(hs_workdir)/plan.md"
}
need_main()  { [ "$(hs_branch)" = main ] || hs_die "This runs on main (you are on $(hs_branch))."; }
need_clean() { hs_clean || { git status --short | head -20 >&2; hs_die "Working tree not clean. Commit first: tools/hs save -m \"...\""; }; }

changed_code() { # files changed on this task vs main (committed + uncommitted), existing only
  { git diff --name-only --diff-filter=AMR main...HEAD 2>/dev/null; git diff --name-only --diff-filter=AMR HEAD; git ls-files -o --exclude-standard; } \
    | grep -E "$HS_CODE_RE" | sort -u | while read -r f; do [ -f "$f" ] && echo "$f"; done
}
deleted_code() { git diff --name-only --diff-filter=D main...HEAD 2>/dev/null | grep -E "$HS_CODE_RE" || true; }

gate_name() {
  local wd; wd=$(hs_workdir)
  if [ "$(hs_branch)" = main ]; then echo "IDLE — no task open"; return; fi
  [ -n "$wd" ] && [ -f "$wd/plan.md" ] || { echo "UNKNOWN — not a task branch"; return; }
  if ! hs_approved; then
    if [ -f "$wd/APPROVAL" ]; then echo "PLANNING — plan.md changed since approval; needs re-approval"
    else echo "PLANNING — write plan.md, then get the user's approval"; fi; return
  fi
  [ -f "$wd/UAT" ] || { echo "EXECUTING — approved; build, lint, then UAT"; return; }
  [ -f "$wd/HANDOVER" ] || { echo "HANDOVER — UAT passed; run tools/hs handover"; return; }
  echo "READY — run tools/hs finish"
}

branch_gate() { # task branch -> short gate name, read from that branch without switching to it
  local b=$1 wd want have; wd="work/${b#*/}"
  git cat-file -e "$b:$wd/plan.md" 2>/dev/null || { echo "no plan"; return; }
  want=$(git show "$b:$wd/APPROVAL" 2>/dev/null | sed -n 's/^plan_sha256: //p' || true)
  have=$(git show "$b:$wd/plan.md" | shasum -a 256 | awk '{print $1}')
  if [ -z "$want" ]; then echo "planning"; return; fi
  [ "$want" = "$have" ] || { echo "needs re-approval"; return; }
  git cat-file -e "$b:$wd/UAT" 2>/dev/null || { echo "building"; return; }
  git cat-file -e "$b:$wd/HANDOVER" 2>/dev/null || { echo "handover"; return; }
  echo "ready to finish"
}

plan_pending() { # 0 if this branch has a finished plan waiting for the user's approval
  local wd; wd=$(hs_workdir)
  [ -n "$wd" ] && [ -f "$wd/plan.md" ] && ! grep -q 'TODO:' "$wd/plan.md" && ! hs_approved
}

unlogged_handovers() { # slugs that were packaged but never confirmed live
  local t s
  for t in $(git tag -l 'handover/*'); do
    s=$(echo "${t#handover/}" | sed -E 's/-[0-9]{4}-[0-9]{2}-[0-9]{2}$//')
    [ -n "$(git tag -l "deploy/$s-*")" ] || echo "$s"
  done
}

hs_health() { # problems worth seeing at session start; quiet when all is well
  cmp -s tools/claude-code/settings.json .claude/settings.json 2>/dev/null \
    || echo "! Claude Code hooks are not installed or out of date: run tools/hs setup, then restart Claude Code."
  [ "$(git config core.hooksPath || true)" = tools/git-hooks ] || echo "! Git hooks are not installed: run tools/hs setup."
  local b age; b=$(hs_newest_backup)
  if [ -n "$b" ]; then
    age=$(hs_backup_age "$b")
    [ "$age" -gt "$HS_STALE_DAYS" ] && echo "! Newest live backup is $age days old: ask for a fresh export before planning or handover."
  fi
  if command -v nc >/dev/null 2>&1 && ! nc -z -G 1 127.0.0.1 80 >/dev/null 2>&1; then
    local holder; holder=$(lsof -nP -iTCP:443 -sTCP:LISTEN 2>/dev/null | awk 'NR>1{print $1}' | sort -u | tr '\n' ' ')
    if [ -n "$holder" ]; then echo "! http://headstart.local is down: port 80 is closed and ${holder}holds port 443, which stops Local's router starting."
    else echo "! http://headstart.local is down: port 80 is closed. Start the site in Local."; fi
  fi
  local n; n=$(unlogged_handovers | tr '\n' ' ')
  [ -n "$n" ] && echo "! Sent to the dev but not confirmed live: $n"
  if plan_pending; then
    echo "! Plan awaiting approval: file://$ROOT/$(hs_workdir)/plan.md"
  fi
  return 0
}

cmd_status() {
  local brief=${1:-}
  echo "HeadStart workflow status"
  hs_info "Branch : $(hs_branch)"
  hs_info "Gate   : $(gate_name)"
  local n; n=$(git status --porcelain | wc -l | tr -d ' ')
  hs_info "Uncommitted files: $n"
  local b; b=$(hs_newest_backup)
  hs_info "Newest live backup: ${b:-none}"
  hs_health
  [ "$brief" = --brief ] && return 0
  local php; php=$(hs_find_php)
  hs_info "PHP linter: ${php:-none here (lint externally + tools/hs receipt)}"
  hs_info "Git hooks: $(git config core.hooksPath || echo NOT INSTALLED — run tools/hs setup)"
  local t; hs_info "Open tasks:"
  for t in $(git branch --list 'feat/*' 'fix/*' --format='%(refname:short)'); do
    printf '      %-40s %-18s %s\n' "$t" "$(branch_gate "$t")" "$(git log -1 --format=%cr "$t")"
  done
  if [ "$(hs_branch)" != main ] && [ -n "$(hs_slug)" ]; then
    hs_info "Changed code on this task:"; changed_code | sed 's/^/      /'
  fi
}

cmd_setup() {
  chmod +x tools/hs tools/git-hooks/* 2>/dev/null || true
  git config core.hooksPath tools/git-hooks
  git config core.fileMode false
  git config branch.main.mergeoptions --no-ff
  git config maintenance.auto false   # background maintenance raced commits on the shared folder
  git config gc.auto 0                 # run `git gc` by hand on the Mac now and then
  mkdir -p Site-Scripts/Latest-Drop work; touch Site-Scripts/Latest-Drop/.gitkeep
  hs_ok "Git hooks installed (core.hooksPath=tools/git-hooks), fileMode off, main merges are --no-ff"
  # A copy that git ignores, so the hooks stay on when switching to branches older than this file.
  local ex; ex="$(git rev-parse --git-path info/exclude)"; mkdir -p "$(dirname "$ex")"
  grep -qxF '/.claude/settings.json' "$ex" 2>/dev/null || echo '/.claude/settings.json' >> "$ex"
  if cmp -s tools/claude-code/settings.json .claude/settings.json 2>/dev/null; then
    hs_ok "Claude Code hooks are already up to date."
  else
    mkdir -p .claude && cp tools/claude-code/settings.json .claude/settings.json
    hs_ok "Claude Code hooks installed. Restart Claude Code: it reads hooks when it starts."
  fi
}

cmd_start() {
  local type=${1:-} slug=${2:-} title=${3:-}
  case "$type" in feat|fix) ;; *) hs_die "Usage: tools/hs start <feat|fix> <slug> [\"Title\"]";; esac
  echo "$type/$slug" | grep -Eq "$HS_BRANCH_RE" || hs_die "Slug must be lowercase letters, digits and hyphens."
  need_main; need_clean
  git rev-parse -q --verify "refs/heads/$type/$slug" >/dev/null && hs_die "Branch $type/$slug already exists."
  local b; b=$(hs_newest_backup)
  if [ -z "$b" ]; then hs_warn "No live backup exists. Gate 1: drop live exports in Site-Scripts/Latest-Drop/ and run tools/hs snapshot."
  else
    local age; age=$(hs_backup_age "$b")
    [ "$age" -gt "$HS_STALE_DAYS" ] && hs_warn "Newest live backup is $age days old ($b). Gate 1: ask the user for a fresh export before planning."
  fi
  [ -n "$title" ] || title=$slug
  git checkout -q -b "$type/$slug"
  mkdir -p "work/$slug"
  TITLE="$title" SLUG="$slug" TYPE="$type" DATE="$(hs_today)" BASELINE="${b:-NONE — snapshot needed}" \
    awk '{gsub(/\{\{TITLE\}\}/,ENVIRON["TITLE"]);gsub(/\{\{SLUG\}\}/,ENVIRON["SLUG"]);gsub(/\{\{TYPE\}\}/,ENVIRON["TYPE"]);gsub(/\{\{DATE\}\}/,ENVIRON["DATE"]);gsub(/\{\{BASELINE\}\}/,ENVIRON["BASELINE"]);print}' \
    "$TPL/plan.md" > "work/$slug/plan.md"
  git add "work/$slug/plan.md"
  git commit -q -m "plan($slug): open task — $title"
  hs_ok "Opened $type/$slug. Next: fill work/$slug/plan.md (no TODO: left), commit it, then ask the user to approve."
}

cmd_approve() {
  local via=""
  [ "${1:-}" = --via ] && via=${2:-}
  [ -n "$via" ] || hs_die "Usage: tools/hs approve --via \"<how the user approved, quoting them>\""
  need_task
  local wd; wd=$(hs_workdir)
  if hs_approved; then hs_info "This plan is already approved; nothing to record."; return 0; fi
  grep -q 'TODO:' "$wd/plan.md" && hs_die "$wd/plan.md still has TODO: markers. Finish the plan before approval."
  git diff --quiet HEAD -- "$wd/plan.md" 2>/dev/null || git add "$wd/plan.md"
  { echo "plan_sha256: $(hs_sha "$wd/plan.md")"
    echo "approved_at: $(hs_now)"
    echo "approved_by: $(git config user.name)"
    echo "via: $via"; } > "$wd/APPROVAL"
  git add "$wd/APPROVAL" "$wd/plan.md"
  git commit -q -m "plan($(hs_slug)): approved" -m "Via: $via"
  hs_ok "Plan approved and recorded. Code commits are now unlocked for $(hs_branch)."
}

plan_branch() { # slug -> its task branch
  local b; for b in "feat/$1" "fix/$1"; do
    git rev-parse -q --verify "refs/heads/$b" >/dev/null && { echo "$b"; return 0; }
  done
  return 1
}
newest_plan_branch() { # the open task whose plan changed most recently
  local b s t best="" bestt=0
  for b in $(git branch --list 'feat/*' 'fix/*' --format='%(refname:short)'); do
    s=${b#*/}; t=$(git log -1 --format=%ct "$b" -- "work/$s/plan.md" 2>/dev/null || true)
    if [ -n "$t" ] && [ "$t" -gt "$bestt" ]; then best=$b; bestt=$t; fi
  done
  echo "$best"
}

cmd_plan() {
  local diff="" slug="" a br
  for a in "$@"; do case "$a" in --diff) diff=1 ;; *) slug=$a ;; esac; done
  if [ -n "$slug" ]; then br=$(plan_branch "$slug") || hs_die "No open task called '$slug'."
  elif [ -n "$(hs_slug)" ]; then br=$(hs_branch)
  else br=$(newest_plan_branch); [ -n "$br" ] || hs_die "No open tasks."; fi
  slug=${br#*/}
  local rel="work/$slug/plan.md"
  git cat-file -e "$br:$rel" 2>/dev/null || hs_die "$br has no plan."
  if [ -n "$diff" ]; then
    local at; at=$(git log -1 --format=%h "$br" -- "work/$slug/APPROVAL")
    [ -n "$at" ] || { hs_info "$slug has never been approved, so there is nothing to compare."; return 0; }
    echo "Plan changes since the approval in $at ($slug):"
    if [ "$br" = "$(hs_branch)" ]; then git --no-pager diff "$at" -- "$rel"; else git --no-pager diff "$at" "$br" -- "$rel"; fi
    return 0
  fi
  local path
  if [ "$br" = "$(hs_branch)" ]; then path="$ROOT/$rel"
  else
    path="${TMPDIR:-/tmp}"; path="${path%/}/hs-plan-$slug.md"; rm -f "$path"
    git show "$br:$rel" > "$path"; chmod a-w "$path"
  fi
  hs_ok "$slug — $(branch_gate "$br")"
  hs_info "file://$path"
  [ "$br" = "$(hs_branch)" ] || hs_info "(read-only copy; the plan itself is on $br)"
  if [ -z "${HS_NO_OPEN:-}" ] && command -v open >/dev/null 2>&1; then open "$path" || hs_warn "Could not open it; use the link above."; fi
}

cmd_sync() {
  need_task; need_clean
  local behind; behind=$(git rev-list --count HEAD..main)
  [ "$behind" -gt 0 ] || { hs_info "Already up to date with main."; return 0; }
  if ! command git merge -q --no-ff main -m "chore($(hs_slug)): sync main into the task branch"; then
    local c; c=$(command git diff --name-only --diff-filter=U)
    command git merge --abort 2>/dev/null || true
    hs_die "Sync stopped: these files changed on both main and this branch, and nothing was merged:
$c"
  fi
  hs_verify_commit
  hs_ok "Merged $behind commit(s) from main into $(hs_branch)."
  hs_approved && hs_info "Plan approval is still valid."
  return 0
}

cmd_learned() {
  local log="$HS_LEARN_DIR/headstart-log.md"
  [ -s "$log" ] && cat "$log" || hs_info "No snippets yet. They appear as the work happens."
}

cmd_save() {
  [ $# -gt 0 ] || hs_die "Usage: tools/hs save -m \"<type>(<scope>): <message>\" [-m \"body\"]"
  git add -A
  git diff --cached --quiet && { hs_info "Nothing to commit."; return 0; }
  git commit -q "$@"
  hs_ok "Committed: $(git log -1 --format=%s)"
}

cmd_lint() {
  local files php fail=0 js=0
  if [ $# -gt 0 ]; then files=$(printf '%s\n' "$@"); else files=$(changed_code); fi
  [ -n "$files" ] || { hs_info "No changed code files to lint."; return 0; }
  php=$(hs_find_php)
  local missing=""
  for f in $files; do
    case "$f" in
      *.php)
        if [ -z "$php" ]; then
          hs_has_receipt "$(git hash-object "$f")" && hs_ok "$f (receipt)" || missing="$missing $f"
        elif hs_lint_php "$php" "$f" "$f"; then
          hs_add_receipt "$(git hash-object "$f")" "$f" "hs lint ($("$php" -r 'echo PHP_VERSION;'))"; hs_ok "$f"
        else fail=1; fi ;;
      *.js)
        if command -v node >/dev/null 2>&1; then
          if node --check "$f" 2>/tmp/hs-js-err.$$; then hs_ok "$f"; else cat /tmp/hs-js-err.$$ >&2; fail=1; fi
          rm -f /tmp/hs-js-err.$$
        else hs_warn "$f not checked (no node here)"; fi ;;
    esac
  done
  if [ -n "$missing" ]; then
    hs_warn "No PHP on this machine. Lint these elsewhere (php -l), then record:"
    hs_info "HS_EXTERNAL_LINT=\"<php version / where>\" tools/hs receipt$missing"
    fail=1
  fi
  [ $fail -eq 0 ] && hs_ok "Lint passed." || hs_die "Lint failed."
}

cmd_receipt() {
  [ -n "${HS_EXTERNAL_LINT:-}" ] || hs_die "Set HS_EXTERNAL_LINT=\"<php version / where it was linted>\" — only after a real php -l pass."
  [ $# -gt 0 ] || hs_die "Usage: HS_EXTERNAL_LINT=\"...\" tools/hs receipt <file.php...>"
  local f; for f in "$@"; do
    [ -f "$f" ] || hs_die "No such file: $f"
    hs_add_receipt "$(git hash-object "$f")" "$f" "external: $HS_EXTERNAL_LINT"; hs_ok "receipt: $f"
  done
}

cmd_uat() {
  local via=""
  [ "${1:-}" = --via ] && via=${2:-}
  [ -n "$via" ] || hs_die "Usage: tools/hs uat --via \"<the user's confirmation, or why UAT wasn't needed>\""
  need_task; hs_approved || hs_die "Plan not approved — nothing to UAT."
  local wd; wd=$(hs_workdir)
  { echo "uat_passed_at: $(hs_now)"; echo "head: $(git rev-parse --short HEAD)"; echo "via: $via"; } > "$wd/UAT"
  git add "$wd/UAT"; git commit -q -m "test($(hs_slug)): UAT passed" -m "Via: $via"
  hs_ok "UAT recorded."
}

handover_subpath() { # repo path -> path inside the package
  case "$1" in
    Site-Scripts/*) echo "${1#Site-Scripts/}" ;;
    app/public/wp-content/mu-plugins/*) echo "mu-plugins/${1#app/public/wp-content/mu-plugins/}" ;;
    *) echo "$1" ;;
  esac
}

handover_safety() { # stop before a package can overwrite something newer on live
  local files=$1 accept=$2 backup f modified="" moved=""
  backup=$(hs_newest_backup)
  for f in $files; do
    git cat-file -e "main:$f" 2>/dev/null || continue
    modified="$modified $f"
    if [ -n "$backup" ] && hs_live_differs "$backup" "$f" main; then moved="$moved
    $f"; fi
  done
  [ -n "$modified" ] || return 0
  local problem=""
  if [ -n "$moved" ]; then
    problem="Live doesn't match main for these files, so Nick may have edited them, or earlier work may not be deployed yet:$moved
"
  fi
  if [ -n "$backup" ] && [ "$(hs_backup_age "$backup")" -gt "$HS_STALE_DAYS" ]; then
    problem="$problem""The newest live backup is $(hs_backup_age "$backup") days old ($backup) and this task changes existing live files.
"
  fi
  [ -n "$problem" ] || return 0
  if [ -n "$accept" ]; then hs_warn "Going ahead (--accept-drift): $accept"; return 0; fi
  hs_die "$problem
  Fix: get a fresh live export, tools/hs snapshot on main, then tools/hs sync here.
  If the difference is understood and intended: tools/hs handover --accept-drift \"why\""
}

cmd_handover() {
  need_task; hs_approved || hs_die "Plan not approved."
  local wd slug dir name files
  wd=$(hs_workdir); slug=$(hs_slug)
  [ -f "$wd/UAT" ] || hs_die "UAT not recorded yet (Gate 5). The user confirms, then: tools/hs uat --via \"...\""
  if [ "${1:-}" = --local-only ]; then
    [ -n "${2:-}" ] || hs_die "Usage: tools/hs handover --local-only \"why nothing ships to live\""
    { echo "local_only: $2"; echo "built_at: $(hs_now)"; echo "head: $(git rev-parse --short HEAD)"; } > "$wd/HANDOVER"
    git add "$wd/HANDOVER"; git commit -q -m "handover($slug): local only — nothing ships" -m "$2"
    hs_ok "Recorded: nothing ships to live ($2). Next: tools/hs finish"
    return 0
  fi
  if git status --porcelain | awk '{print $NF}' | grep -Eq "$HS_CODE_RE"; then
    git status --short | grep -E " (Site-Scripts/(php|js|css)/|app/)" >&2
    hs_die "Uncommitted code changes. What ships must be committed: tools/hs save -m \"...\""
  fi
  local accept=""
  if [ "${1:-}" = --accept-drift ]; then
    accept=${2:-}; [ -n "$accept" ] || hs_die "Usage: tools/hs handover --accept-drift \"why this is safe\""
  fi
  files=$(changed_code | grep -v 'MANIFEST\.tsv$' | grep -Ev "$HS_LOCAL_ONLY_RE" || true)
  [ -n "$files" ] || hs_die "No code changes on this task vs main."
  cmd_lint $files >/dev/null || hs_die "Lint must pass before handover (tools/hs lint)."
  handover_safety "$files" "$accept"
  if [ -f "$wd/HANDOVER" ]; then dir=$(sed -n 's/^dir: //p' "$wd/HANDOVER")
  elif [ -f "$wd/HANDOVER.pending" ]; then dir=$(sed -n 's/^dir: //p' "$wd/HANDOVER.pending")
  else dir="Site-Scripts/handover/$slug-$(hs_today)"; fi
  name=$(basename "$dir")
  local backup; backup=$(hs_newest_backup)
  rm -rf "$dir/files" "$dir/rollback"; mkdir -p "$dir/files"
  local table="| File in package | Change | Goes on live as | Previous version |"$'\n'"|---|---|---|---|"
  local f sub rb change livecopy
  for f in $files; do
    sub=$(handover_subpath "$f"); mkdir -p "$dir/files/$(dirname "$sub")"; cp "$f" "$dir/files/$sub"
    rb=""
    if git cat-file -e "main:$f" 2>/dev/null; then change="modified"; else change="new"; fi
    if [ -n "$backup" ] && livecopy=$(hs_backup_read "$backup" "$f"); then
      mkdir -p "$dir/rollback/$(dirname "$sub")"
      case "$f" in *.php) case "$livecopy" in '<?php'*) ;; *) livecopy="<?php"$'\n\n'"$livecopy" ;; esac ;; esac
      printf '%s\n' "$livecopy" > "$dir/rollback/$sub"
      rb="rollback/$sub"
    elif [ "$change" = new ]; then rb="— new: deactivate/remove to roll back"
    else rb="— no copy in ${backup:-any live backup}: check live before replacing"; fi
    table="$table"$'\n'"| files/$sub | $change | \`$(hs_live_location "$f")\` | $rb |"
  done
  for f in $(deleted_code); do table="$table"$'\n'"| $(handover_subpath "$f") | DELETED — remove/deactivate on live | \`$(hs_live_location "$f")\` | — |"; done
  if [ ! -f "$dir/DEV-NOTES.md" ]; then
    TITLE="$(sed -n '1s/^# Plan: //p' "$wd/plan.md")" ZIP="$name.zip" DATE="$(hs_today)" BRANCH="$(hs_branch)" TABLE="$table" \
      awk '{gsub(/\{\{TITLE\}\}/,ENVIRON["TITLE"]);gsub(/\{\{ZIP\}\}/,ENVIRON["ZIP"]);gsub(/\{\{DATE\}\}/,ENVIRON["DATE"]);gsub(/\{\{BRANCH\}\}/,ENVIRON["BRANCH"]);if($0=="{{FILE_TABLE}}"){print ENVIRON["TABLE"];next};print}' \
      "$TPL/DEV-NOTES.md" > "$dir/DEV-NOTES.md"
    echo "dir: $dir" > "$wd/HANDOVER.pending"
    [ -n "$accept" ] && printf '\n## Live drift accepted\n%s\n' "$accept" >> "$dir/DEV-NOTES.md"
    if printf '%s\n' "$files" | grep -q '^Site-Scripts/js/'; then
      awk '{print} /^## Watch out for/{print "- JS files keep their live hash names: upload each `files/js/<name>.js` to `wp-content/uploads/hs-head/` under the name in the \"Goes on live as\" column, overwriting the old file."}' "$dir/DEV-NOTES.md" > "$dir/DEV-NOTES.md.tmp" && mv "$dir/DEV-NOTES.md.tmp" "$dir/DEV-NOTES.md"
    fi
    hs_ok "Scaffolded $dir (files/, rollback/, DEV-NOTES.md)."
    hs_info "Next: complete every TODO: in $dir/DEV-NOTES.md, then run tools/hs handover again to zip + commit."
    return 0
  fi
  grep -q 'TODO:' "$dir/DEV-NOTES.md" && hs_die "$dir/DEV-NOTES.md still has TODO: markers."
  if [ -n "$accept" ] && ! grep -qF "$accept" "$dir/DEV-NOTES.md"; then
    printf '\n## Live drift accepted\n%s\n' "$accept" >> "$dir/DEV-NOTES.md"
  fi
  rm -f "$dir/$name.zip" "$wd/HANDOVER.pending"
  ( cd "$dir" && zip -qr "$name.zip" DEV-NOTES.md files $( [ -d rollback ] && echo rollback ) -x '*.DS_Store' )
  { echo "dir: $dir"; echo "zip: $dir/$name.zip"; echo "built_at: $(hs_now)"; echo "head: $(git rev-parse --short HEAD)"; } > "$wd/HANDOVER"
  git add -A "$dir" "$wd"
  git commit -q -m "handover($slug): package $name"
  hs_ok "Handover packaged: $dir/$name.zip"
  hs_info "Next: tools/hs finish"
}

cmd_finish() {
  need_task; hs_approved || hs_die "Plan not approved."
  local wd slug br zip; wd=$(hs_workdir); slug=$(hs_slug); br=$(hs_branch)
  [ -f "$wd/UAT" ] || hs_die "UAT not recorded."
  [ -f "$wd/HANDOVER" ] || hs_die "Handover not built (tools/hs handover, or handover --local-only \"why\")."
  local local_only; local_only=$(sed -n 's/^local_only: //p' "$wd/HANDOVER")
  if [ -z "$local_only" ]; then
    zip=$(sed -n 's/^zip: //p' "$wd/HANDOVER"); [ -f "$zip" ] || hs_die "Handover zip missing: $zip"
  fi
  need_clean
  local title; title=$(sed -n '1s/^# Plan: //p' "$wd/plan.md")
  git checkout -q main
  if [ -n "$local_only" ]; then
    HS_ALLOW_MAIN=1 git merge -q --no-ff "$br" -m "${br%%/*}($slug): $title" -m "Local only: $local_only"
    git tag -a "local/$slug-$(hs_today)" -m "$title — local only"
    git branch -q -d "$br"
    hs_ok "Merged $br into main, tagged local/$slug-$(hs_today). Nothing to send to the dev."
  else
    HS_ALLOW_MAIN=1 git merge -q --no-ff "$br" -m "${br%%/*}($slug): $title" -m "Handover: $zip"
    git tag -a "handover/$slug-$(hs_today)" -m "$title — $zip"
    git branch -q -d "$br"
    hs_ok "Merged $br into main, tagged handover/$slug-$(hs_today)."
    hs_info "Send to the dev: $zip"
    hs_info "When the dev confirms it is live: tools/hs deployed $slug --note \"...\""
  fi
  hs_info "Then get it onto GitHub: git push origin main --follow-tags (Mac), or tools/hs publish (cloud)."
}

cmd_deployed() {
  local slug=${1:-} note=""
  [ -n "$slug" ] || hs_die "Usage: tools/hs deployed <slug> [--note \"...\"]"
  [ "${2:-}" = --note ] && note=${3:-}
  need_main; need_clean
  local tag; tag=$(git tag -l "handover/$slug-*" | sort | tail -1)
  [ -n "$(git tag -l "local/$slug-*")" ] && [ -z "$tag" ] && hs_die "'$slug' was a local-only task — nothing was deployed."
  [ -n "$tag" ] || hs_die "No handover tag for '$slug' — finish the task first."
  [ -f DEPLOY-LOG.md ] || printf '# Deploy log\n\nOne row per change confirmed live. Written by `tools/hs deployed` only.\n\n| Date | Task | Handover | Commit | Note |\n|---|---|---|---|---|\n' > DEPLOY-LOG.md
  printf '| %s | %s | %s | %s | %s |\n' "$(hs_today)" "$slug" "$tag" "$(git rev-parse --short "$tag^{commit}")" "${note:-—}" >> DEPLOY-LOG.md
  git add DEPLOY-LOG.md
  if [ -n "$note" ]; then HS_ALLOW_MAIN=1 git commit -q -m "deploy($slug): confirmed live $(hs_today)" -m "$note"
  else HS_ALLOW_MAIN=1 git commit -q -m "deploy($slug): confirmed live $(hs_today)"; fi
  git tag -a "deploy/$slug-$(hs_today)" -m "Live: $slug ${note}"
  hs_ok "Logged deploy of $slug and tagged deploy/$slug-$(hs_today)."
  hs_info "Post-deploy reminder: permalinks flushed? WP Super Cache + Cloudflare purged? Smoke URLs checked?"
}

cmd_drift() {
  local b=${1:-$(hs_newest_backup)}
  [ -n "$b" ] && [ -d "$b" ] || hs_die "No live backup to compare against."
  echo "Drift: working files vs $b"
  local f base w found slug
  # Live files kept as separate files in the backup.
  find "$b" -type f \( -name '*.php' -o -name '*.js' -o -name '*.css' \) | sort | while read -r f; do
    base=$(hs_clean_name "$(basename "$f")"); found=""
    for w in Site-Scripts/php/"$base" Site-Scripts/js/"$base" Site-Scripts/css/"$base"; do
      [ -f "$w" ] && { found=$w; break; }
    done
    if [ -z "$found" ]; then echo "  LIVE ONLY   $base"
    elif [ "$(hs_code_norm "$found" < "$f")" != "$(hs_code_norm "$found" < "$found")" ]; then echo "  DIFFERS     $found"; fi
  done
  # Snippets inside the backup's JSON export.
  for slug in $(hs_backup_snippet_slugs "$b"); do
    w="Site-Scripts/php/$slug.code-snippets.php"
    if [ ! -f "$w" ]; then echo "  LIVE ONLY   $slug.code-snippets.php"
    elif hs_live_differs "$b" "$w"; then echo "  DIFFERS     $w"; fi
  done
  for w in Site-Scripts/php/*.php Site-Scripts/js/*.js Site-Scripts/css/*.css; do
    [ -f "$w" ] || continue
    hs_backup_read "$b" "$w" >/dev/null 2>&1 || echo "  LOCAL ONLY  $w"
  done
}

cmd_snapshot() {
  need_main; need_clean
  local drop=Site-Scripts/Latest-Drop d dir items
  items=$(ls -A "$drop" 2>/dev/null | grep -v -e '^\.DS_Store$' -e '^\.gitkeep$' || true)
  [ -n "$items" ] || hs_die "Latest-Drop is empty. Put the live exports (Code Snippets, Custom CSS & JS, headstart-global.css) in $drop/ first."
  d=$(hs_today); dir="Site-Scripts/live-site-backups-$d"
  [ -e "$dir" ] && dir="$dir-$(date +%H%M)"
  mkdir -p "$dir"
  local i
  echo "$items" | while read -r i; do
    case "$i" in
      *.zip) unzip -q -o "$drop/$i" -d "$dir" ;;
      *) cp -R "$drop/$i" "$dir/" ;;
    esac
  done
  find "$dir" -name '.DS_Store' -exec rm -f {} + ; rm -rf "$dir/__MACOSX"
  { echo "# Live snapshot $(basename "$dir")"; echo; echo "Taken: $(hs_now)"; echo "Source: $(echo "$items" | tr '\n' ' ')"; echo; echo '```'; cmd_drift "$dir"; echo '```'; } > "$dir/SNAPSHOT.md"
  git add -A "$dir"
  HS_ALLOW_MAIN=1 git commit -q -m "snapshot: live export $(basename "$dir")"
  find "$dir" -type f -exec chmod a-w {} +
  local arch="$ROOT/_archive/drops/$(basename "$dir")"; mkdir -p "$arch"
  echo "$items" | while read -r i; do mv "$drop/$i" "$arch/"; done
  hs_ok "Snapshot committed: $dir (files read-only; originals moved to _archive/drops/)."
  cat "$dir/SNAPSHOT.md" | sed -n '/^```$/,/^```$/p' | grep -v '^```$' || true
  hs_info "Bring a DIFFERS/LIVE ONLY file into the working copy by copying it from $dir on a task branch."
}


cmd_fetch_js() {
  local drop=Site-Scripts/Latest-Drop html u f n=0 bad=0 base
  mkdir -p "$drop/js"
  html=$(ls "$drop"/js/*.html "$drop"/*.html 2>/dev/null | head -1 || true)
  [ -n "$html" ] || hs_die "No Divi head code found. Copy it from live (Divi → Theme Options → Integration → 'Add code to the <head>'), save it as $ROOT/$drop/js/divi-head-integration.html, then run tools/hs fetch-js again."
  command -v curl >/dev/null 2>&1 || hs_die "curl not found."
  mkdir -p "$drop/js"
  for u in $(grep -oE 'https?://[^"'"'"' >]+/uploads/hs-head/[a-f0-9]+\.js' "$html" | sort -u); do
    base=$(basename "$u"); f="$drop/js/$base"
    if curl -sSfL --max-time 30 -A "Mozilla/5.0 (Macintosh; HeadStart fetch-js)" -o "$f.part" "$u"; then
      if grep -qiE '<html|<!doctype|cf-chl|just a moment' "$f.part"; then
        rm -f "$f.part"; hs_warn "Got a web page instead of JS (Cloudflare?): $base"; bad=$((bad+1))
      else
        mv "$f.part" "$f"; n=$((n+1))
        if [ "$(hs_clean_name "$base")" = "$base" ]; then hs_warn "$base is NEW on live — add it to $HS_JS_MANIFEST"; else hs_ok "$base  ($(hs_clean_name "$base"))"; fi
      fi
    else rm -f "$f.part"; hs_warn "Download failed: $u"; bad=$((bad+1)); fi
  done
  [ $n -gt 0 ] || hs_die "No hs-head scripts found or downloaded from $html."
  [ $bad -eq 0 ] || hs_die "$n downloaded, $bad failed. Re-run, or download the failed ones in a browser."
  hs_ok "$n live scripts saved in $drop/js/ with their live names. Next (on main): tools/hs snapshot"
}

cmd_publish() {
  git rev-parse -q --verify refs/remotes/origin/main >/dev/null || hs_die "No origin/main known yet — push once from the Mac: git push -u origin main"
  if [ "${1:-}" = --done ]; then
    git update-ref refs/remotes/origin/main "$(git rev-parse main)"
    rm -f "$HS_OUTBOX"/*.bundle 2>/dev/null || true
    hs_ok "Marked main ($(git rev-parse --short main)) as on GitHub; outbox cleared."; return 0
  fi
  local ahead tags b
  ahead=$(git rev-list --count origin/main..main)
  tags=$(git tag -l 'handover/*' 'deploy/*' 'local/*' | tr '\n' ' ')
  [ "$ahead" -gt 0 ] || [ -n "$tags" ] || { hs_info "Nothing to publish: main is already on GitHub."; return 0; }
  mkdir -p "$HS_OUTBOX"; b="$HS_OUTBOX/push-$(date +%Y%m%d-%H%M%S).bundle"
  git bundle create "$b" main $tags ^origin/main 2>/dev/null
  hs_ok "$ahead commit(s) bundled: $b"
  hs_info "Cloud Claude: stage it, git fetch <bundle> main + tags, push to GitHub, then tools/hs publish --done"
  hs_info "On the Mac with network you can skip this: git push origin main --follow-tags"
}

# ---------- Claude Code hook entry points ----------
guard_block() { printf 'BLOCKED by HeadStart workflow: %s\n' "$*" >&2; exit 2; }
strip_quoted() { printf '%s\n' "$1" | sed -E "s/\"[^\"]*\"//g; s/'[^']*'//g"; }

learn_event() { # hook JSON -> the event this tool call counts as, or nothing
  local json=$1 c p
  case "$(hs_json_get "$json" .tool_name)" in
    Bash)
      c=$(strip_quoted "$(hs_json_get "$json" .tool_input.command)")
      case "$c" in
        *"hs finish"*|*"hs sync"*|*"git merge"*) echo merge ;;
        *"hs start"*|*"checkout -b"*|*"switch -c"*) echo branch ;;
        *"git push"*|*"hs publish"*) echo push ;;
        *"git pull"*|*"git fetch"*) echo pull ;;
        *"git tag"*) echo tag ;;
        *"hs snapshot"*|*"hs drift"*) echo drift ;;
        *"hs handover"*) echo handover ;;
        *"hs deployed"*) echo deploy ;;
        *"hs lint"*|*"php -l"*) echo lint ;;
        *"hs approve"*) echo plan ;;
        *"hs save"*|*"git commit"*) echo commit ;;
        *curl\ *) echo http ;;
        *"wp.sh"*|*"wp-cli"*) echo wp-cli ;;
      esac ;;
    Edit|Write|MultiEdit)
      p=$(hs_json_get "$json" .tool_input.file_path)
      case "$p" in "$ROOT"/*) p=${p#"$ROOT"/} ;; *) return 0 ;; esac
      case "$p" in
        tools/*|.claude/*) echo hooks ;;
        work/*/plan.md) echo plan ;;
        *.php) echo php ;;
        *.js) echo js ;;
        *.css) echo css ;;
      esac ;;
  esac
}

learn_hook() { # event + cooldown: at most one snippet per HS_LEARN_COOLDOWN_MIN, never a repeat until all are seen
  local json=$1 ev now last tsv row seen id cat text
  local dir="$HS_LEARN_DIR"; tsv="$ROOT/tools/learning/snippets.tsv"
  [ -f "$tsv" ] && command -v jq >/dev/null 2>&1 || return 0
  [ -e "$dir/PAUSE" ] && return 0
  [ "$(cat "$dir/headstart-skip" 2>/dev/null || true)" = "$(hs_today)" ] && return 0
  ev=$(learn_event "$json"); [ -n "$ev" ] || return 0
  now=${HS_LEARN_NOW:-$(date +%s)}
  last=$(cat "$dir/headstart-last" 2>/dev/null || echo 0)
  [ $(( now - last )) -ge $(( HS_LEARN_COOLDOWN_MIN * 60 )) ] || return 0
  mkdir -p "$dir" || return 0
  pick() { awk -F'\t' -v ev="$ev" -v seen=" $seen " '
    /^#/ { next }
    $1 == ev && !c { c = $2 }
    { n++; e[n]=$1; k[n]=$2; i[n]=$3; l[n]=$0 }
    END {
      for (j=1;j<=n;j++) if (e[j]==ev && index(seen," " i[j] " ")==0) { print l[j]; exit }
      for (j=1;j<=n;j++) if (k[j]==c && index(seen," " i[j] " ")==0) { print l[j]; exit }
      for (j=1;j<=n;j++) if (index(seen," " i[j] " ")==0) { print l[j]; exit }
    }' "$tsv"; }
  seen=$(cat "$dir/headstart-seen" 2>/dev/null | tr '\n' ' ' || true)
  row=$(pick)
  if [ -z "$row" ]; then : > "$dir/headstart-seen"; seen=""; row=$(pick); fi   # everything seen: start again
  [ -n "$row" ] || return 0
  cat=$(printf '%s' "$row" | cut -f2); id=$(printf '%s' "$row" | cut -f3); text=$(printf '%s' "$row" | cut -f4)
  echo "$id" >> "$dir/headstart-seen"
  echo "$now" > "$dir/headstart-last"
  [ -f "$dir/headstart-log.md" ] || printf '# What you have learned on HeadStart\n\n' > "$dir/headstart-log.md"
  printf -- '- %s [%s] %s\n' "$(hs_today)" "$cat" "$text" >> "$dir/headstart-log.md"
  jq -n --arg t "HeadStart learning snippet ($cat). Include this in your next message to the user as a short note of 2 to 3 lines, in plain language, naming the concept and tying it to the work just done if it genuinely fits. Keep working; don't stop for it. Snippet: $text" \
    '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:$t}}'
}

last_reply() { # hook JSON -> Claude's last message text, or nothing if it can't be read
  local json=$1 t f
  t=$(hs_json_get "$json" .last_assistant_message)
  [ -n "$t" ] && { printf '%s' "$t"; return 0; }
  f=$(hs_json_get "$json" .transcript_path)
  [ -f "$f" ] || return 0
  tail -n 200 "$f" | jq -rs '[.[] | select(.type=="assistant") | .message.content[]? | select(.type=="text") | .text] | last // empty' 2>/dev/null || true
}

cmd_guard() {
  local kind=${1:-} json path cmd
  json=$(cat)
  case "$kind" in
    edit)
      path=$(hs_json_get "$json" .tool_input.file_path); [ -n "$path" ] || path=$(hs_json_get "$json" .tool_input.notebook_path)
      [ -n "$path" ] || exit 0
      case "$path" in "$ROOT"/*) path=${path#"$ROOT"/} ;; /*) exit 0 ;; esac
      echo "$path" | grep -Eq "$HS_BACKUP_RE" && guard_block "live-site backups are read-only. Copy the file into Site-Scripts/php|js|css on a task branch and edit that."
      echo "$path" | grep -Eq "^_archive/" && guard_block "_archive/ is read-only history."
      echo "$path" | grep -Eq "$HS_PROTECTED_RE" && guard_block "$path is written only by tools/hs (approve/uat/deployed), never edited directly."
      if echo "$path" | grep -Eq "$HS_CODE_RE"; then
        [ "$(hs_branch)" = main ] && guard_block "no task open. Run tools/hs start feat <slug> \"Title\" and get the plan approved first."
        hs_approved || guard_block "plan for $(hs_branch) is not approved (or changed since approval). Finish work/$(hs_slug)/plan.md and ask the user to approve it."
      fi ;;
    bash)
      cmd=$(hs_json_get "$json" .tool_input.command); [ -n "$cmd" ] || exit 0
      # A commit message is only text: don't let the words inside it trigger the checks below.
      if echo "$cmd" | grep -Eq '(^|[^a-z])hs +save( |$)'; then cmd=$(strip_quoted "$cmd"); fi
      echo "$cmd" | grep -Eq -- '--no-verify|core\.hooksPath|HS_ALLOW_MAIN|HS_ALLOW_BULK_DELETE|HS_NO_PHP' && guard_block "bypassing git hooks / workflow guards is not allowed."
      echo "$cmd" | grep -Eq '(^|[^a-z])hs +(approve|uat)( |$)' && guard_block "approve/uat record the USER's decision. Ask the user to type approved or UAT PASSED as their next message."
      echo "$cmd" | grep -Eq 'HS_EXTERNAL_LINT' && [ -n "$(hs_find_php)" ] && guard_block "PHP is available here — use tools/hs lint, not receipts."
      echo "$cmd" | grep -Eq 'git +push.*(--force|-f( |$)|\+)' && guard_block "force-push is not allowed."
      echo "$cmd" | grep -Eq 'git +(reset +--hard|clean +-[a-z]*f|checkout +-- +\.|restore +\.)' && guard_block "destructive git command — ask the user first."
      echo "$cmd" | grep -Eq 'git +(commit|merge)' && [ "$(hs_branch)" = main ] && ! echo "$cmd" | grep -q 'tools/hs' && guard_block "no direct commits/merges on main. Use tools/hs."
      echo "$cmd" | grep -Eq 'rm +-[a-zA-Z]*r[a-zA-Z]*f|rm +-[a-zA-Z]*f[a-zA-Z]*r' && guard_block "rm -rf is not allowed. Move things to _archive/ instead."
      if echo "$cmd" | grep -q 'live-site-backups'; then
        echo "$cmd" | grep -Eq '(>>?[[:space:]]*"?[^[:space:]]*live-site-backups|sed +-i|perl +-[a-z]*i|tee |truncate|chmod|rm |touch |unlink)' && guard_block "live-site backups are read-only."
        echo "$cmd" | grep -Eq '(cp|mv|rsync)( |$)' && echo "$cmd" | awk '{print $NF}' | grep -q 'live-site-backups' && guard_block "live-site backups are read-only (destination)."
      fi
      echo "$cmd" | grep -Eq '(>|tee ).*(work/[^ ]+/(APPROVAL|UAT)|DEPLOY-LOG\.md)' && guard_block "approval/UAT/deploy records are written only by tools/hs." ;;
  esac
  exit 0
}

cmd_hook() {
  local kind=${1:-} json p
  json=$(cat)
  case "$kind" in
    prompt)
      p=$(hs_json_get "$json" .prompt)
      local only="" lines
      lines=$(printf '%s\n' "$p" | sed '/^[[:space:]]*$/d')
      [ "$(printf '%s\n' "$lines" | wc -l | tr -d ' ')" = 1 ] && only=$lines
      if printf '%s' "$only" | grep -Eiq '^[[:space:]]*skip[[:punct:]]*[[:space:]]*$'; then
        mkdir -p "$HS_LEARN_DIR" && hs_today > "$HS_LEARN_DIR/headstart-skip"
        echo "[HeadStart workflow] The user said skip: learning snippets are off until tomorrow."
      elif printf '%s' "$p" | head -1 | grep -Eq '^[[:space:]]*APPROVED([[:space:][:punct:]]|$)' \
        || printf '%s' "$only" | grep -Eiq '^[[:space:]]*approved[[:punct:]]*[[:space:]]*$'; then
        echo "[HeadStart workflow] The user approved. Recording:"
        ( hs_git_safe_begin; cmd_approve --via "User typed in Claude Code: $(printf '%s' "$p" | head -c 300 | tr '\n' ' ')" ) 2>&1 || true
      elif printf '%s' "$p" | head -1 | grep -Eiq '^[[:space:]]*UAT PASSED([[:space:][:punct:]]|$)'; then
        echo "[HeadStart workflow] The user confirmed UAT. Recording:"
        ( hs_git_safe_begin; cmd_uat --via "User typed in Claude Code: $(printf '%s' "$p" | head -c 300 | tr '\n' ' ')" ) 2>&1 || true
      fi ;;
    stop)
      [ "$(hs_json_get "$json" .stop_hook_active)" = true ] && exit 0
      if hs_branch | grep -Eq "$HS_BRANCH_RE" && ! hs_clean; then
        printf 'HeadStart workflow: uncommitted work on %s. Commit it with tools/hs save -m "<type>(%s): <msg>" before stopping, or tell the user why it should stay uncommitted.\n' "$(hs_branch)" "$(hs_slug)" >&2
        exit 2
      fi
      if plan_pending; then
        local rel sha mark; rel="$(hs_workdir)/plan.md"; sha=$(hs_sha "$rel")
        mark="$(git rev-parse --absolute-git-dir)/hs-plan-linked"
        [ "$(cat "$mark" 2>/dev/null || true)" = "$sha" ] && exit 0
        local reply; reply=$(last_reply "$json")
        [ -n "$reply" ] || exit 0   # can't read the reply: don't trap it
        if printf '%s' "$reply" | grep -qF "$rel"; then echo "$sha" > "$mark"; exit 0; fi
        printf 'HeadStart workflow: a plan is awaiting approval but your reply has no link to it. Give the user the link: %s/%s\n' "$ROOT" "$rel" >&2
        exit 2
      fi ;;
    learn) learn_hook "$json" || true ;;
  esac
  exit 0
}

c=${1:-help}; [ $# -gt 0 ] && shift
case "$c" in start|approve|save|uat|handover|finish|deployed|snapshot|sync) hs_git_safe_begin;; esac
case "$c" in
  status) cmd_status "$@";; setup) cmd_setup;; start) cmd_start "$@";; approve) cmd_approve "$@";;
  plan) cmd_plan "$@";; sync) cmd_sync;; learned) cmd_learned;;
  save) cmd_save "$@";; lint) cmd_lint "$@";; receipt) cmd_receipt "$@";; uat) cmd_uat "$@";;
  handover) cmd_handover "$@";; finish) cmd_finish;; deployed) cmd_deployed "$@";;
  snapshot) cmd_snapshot;; drift) cmd_drift "$@";; fetch-js) cmd_fetch_js;; publish) cmd_publish "$@";; guard) cmd_guard "$@";; hook) cmd_hook "$@";;
  help|-h|--help) usage;; *) usage; exit 1;;
esac
